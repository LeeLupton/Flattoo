<?xml version="1.1" encoding="UTF-8"?>

<!-- Lid closed = sleep. Screen dims on battery, never on AC (the laptop lives
     on a counter, plugged in, with a tablet attached). -->
<channel name="xfce4-power-manager" version="1.0">
  <property name="xfce4-power-manager" type="empty">
    <property name="show-tray-icon" type="bool" value="true"/>
    <property name="lid-action-on-ac" type="uint" value="1"/>
    <property name="lid-action-on-battery" type="uint" value="1"/>
    <property name="logind-handle-lid-switch" type="bool" value="true"/>
    <property name="power-button-action" type="uint" value="1"/>
    <property name="dpms-enabled" type="bool" value="true"/>
    <property name="dpms-on-ac-sleep" type="uint" value="30"/>
    <property name="dpms-on-ac-off" type="uint" value="45"/>
    <property name="dpms-on-battery-sleep" type="uint" value="10"/>
    <property name="dpms-on-battery-off" type="uint" value="15"/>
    <property name="brightness-on-ac" type="uint" value="9"/>
    <property name="brightness-on-battery" type="uint" value="9"/>
    <property name="inactivity-on-ac" type="uint" value="0"/>
    <property name="inactivity-on-battery" type="uint" value="30"/>
    <property name="inactivity-sleep-mode-on-battery" type="uint" value="1"/>
    <property name="critical-power-action" type="uint" value="1"/>
    <property name="critical-power-level" type="uint" value="7"/>
    <property name="show-panel-label" type="int" value="0"/>
  </property>
</channel>
