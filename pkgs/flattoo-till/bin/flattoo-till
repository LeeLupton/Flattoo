PALETTE_FALLBACK = {"bg": "#17181c", "fg": "#f2f2f5", "muted": "#9a9aa6", "accent": "#5b8cff", "on_accent": "#ffffff",
                    "border": "#30323a", "card": "#20222a", "radius": 20}


def palette():
    p = dict(PALETTE_FALLBACK)
    d = load_json(PALETTE, {})
    for k in p:
        if k in d:
            p[k] = d[k]
    return p


class App:
    def __init__(self, page="feed", prefill=None, shot=None, quit_after=None, fullscreen=False):
        import gi
        gi.require_version("Gtk", "3.0")
        gi.require_version("Gdk", "3.0")
        gi.require_version("GdkPixbuf", "2.0")
        from gi.repository import Gdk, GdkPixbuf, GLib, Gtk, Pango
        self.Gtk, self.Gdk, self.GLib, self.GdkPixbuf, self.Pango = Gtk, Gdk, GLib, GdkPixbuf, Pango
        self.s = settings()
        self.cur = self.s["currency"]
        self.shot, self.quit_after = shot, quit_after
        css = Gtk.CssProvider()
        css.load_from_data(APP_CSS.format(**palette()).encode())
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        self.win = Gtk.Window(title="Money")
        self.win.set_default_size(1180, 760)
        self.win.set_icon_name("flattoo-till")
        if fullscreen:
            self.win.fullscreen()
        else:
            self.win.maximize()
        self.win.connect("destroy", Gtk.main_quit)
        self.win.connect("key-press-event", self.on_key)
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        root.get_style_context().add_class("till-root")
        self.win.add(root)
        self.overlay = Gtk.Overlay()
        root.pack_start(self.overlay, True, True, 0)
        self.pages = Gtk.Stack()
        self.pages.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.pages.set_transition_duration(180)
        self.overlay.add(self.pages)
        self.toast = Gtk.Revealer(valign=Gtk.Align.END, halign=Gtk.Align.CENTER)
        self.toast.set_transition_type(Gtk.RevealerTransitionType.SLIDE_UP)
        self.toast_label = Gtk.Label()
        self.toast_label.get_style_context().add_class("toast")
        self.toast.add(self.toast_label)
        self.overlay.add_overlay(self.toast)
        self.overlay.set_overlay_pass_through(self.toast, True)

        self.pages.add_named(self.make_feed(), "feed")
        for name, make in (("pay", self.make_pay), ("qr", self.make_qr_page), ("book", self.make_book), ("papers", self.make_papers),
                           ("money", self.make_money), ("settings", self.make_settings)):
            self.pages.add_named(self.scrolled(make()), name)  # a page is never taller than the screen
        root.pack_start(self.make_tabs(), False, False, 0)
        self.win.show_all()
        self.toast.set_reveal_child(False)
        self.show_page(page)
        if prefill:
            self.apply_prefill(page, prefill)
        if shot:
            GLib.timeout_add(1800, self.take_shot)
        if quit_after:
            GLib.timeout_add(int(quit_after * 1000), Gtk.main_quit)

    # ---- plumbing
    def keyboard_room(self, box):
        """Space under a form, so its last button can be scrolled clear of the on-screen keyboard."""
        pad = self.Gtk.Box()
        pad.set_size_request(-1, 300)
        box.pack_end(pad, False, False, 0)

    def scrolled(self, w):
        sw = self.Gtk.ScrolledWindow()
        sw.set_policy(self.Gtk.PolicyType.NEVER, self.Gtk.PolicyType.AUTOMATIC)
        sw.set_kinetic_scrolling(True)
        sw.add(w)
        return sw

    def say(self, text):
        self.toast_label.set_text(text)
        self.toast.set_reveal_child(True)
        self.GLib.timeout_add(2600, lambda: self.toast.set_reveal_child(False) or False)

    def take_shot(self):
        gw = getattr(self, "shot_target", self.win).get_window()
        if gw:
            w, h = gw.get_width(), gw.get_height()
            pb = self.Gdk.pixbuf_get_from_window(gw, 0, 0, w, h)
            if pb:
                pb.savev(self.shot, "png", [], [])
        if not self.quit_after:
            self.Gtk.main_quit()
        return False

    def show_page(self, name):
        if name not in ("feed", "pay", "book", "papers", "money", "qr", "settings"):
            name = "feed"
        if name == "feed":
            self.refresh_feed()
        if name == "money":
            self.refresh_money()
        if name == "papers":
            self.refresh_papers()
        self.pages.set_visible_child_name(name)
        tab = {"qr": "pay", "settings": "money"}.get(name, name)
        for n, b in self.tabs.items():
            b.handler_block_by_func(self.on_tab)
            b.set_active(n == tab)
            b.handler_unblock_by_func(self.on_tab)
        self.tabs[tab].grab_focus()  # not a text box: the on-screen keyboard waits until one is tapped

    def on_tab(self, button, name):
        if button.get_active():
            self.show_page(name)

    def make_tabs(self):
        Gtk = self.Gtk
        bar = Gtk.Box(spacing=6, homogeneous=True)
        bar.get_style_context().add_class("tabbar")
        self.tabs = {}
        for name, label, icon in (("feed", "Feed", "view-list-symbolic"), ("pay", "Get paid", "emblem-ok-symbolic"), ("book", "Book", "x-office-calendar-symbolic"),
                                  ("papers", "Papers", "x-office-document-symbolic"), ("money", "Money", "accessories-calculator-symbolic")):
            b = Gtk.ToggleButton()
            b.get_style_context().add_class("tab")
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            img = Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.LARGE_TOOLBAR)
            box.pack_start(img, False, False, 0)
            box.pack_start(Gtk.Label(label=label), False, False, 0)
            b.add(box)
            b.connect("toggled", self.on_tab, name)
            bar.pack_start(b, True, True, 0)
            self.tabs[name] = b
        return bar

    def on_key(self, _w, ev):
        Gdk = self.Gdk
        k = ev.keyval
        if k == Gdk.KEY_Escape:
            if self.pages.get_visible_child_name() in ("feed",):
                self.Gtk.main_quit()
            else:
                self.show_page("feed")
            return True
        if self.pages.get_visible_child_name() == "feed":
            if k in (Gdk.KEY_Down, Gdk.KEY_Page_Down, Gdk.KEY_space, Gdk.KEY_j):
                self.feed_go(1); return True
            if k in (Gdk.KEY_Up, Gdk.KEY_Page_Up, Gdk.KEY_k):
                self.feed_go(-1); return True
        return False

    def button(self, label, cb, primary=False, cls=None):
        b = self.Gtk.Button(label=label)
        if primary:
            b.get_style_context().add_class("primary")
        if cls:
            b.get_style_context().add_class(cls)
        b.connect("clicked", lambda *_: cb())
        return b

    # ---- the feed
    def make_feed(self):
        Gtk = self.Gtk
        box = Gtk.EventBox()
        box.add_events(self.Gdk.EventMask.SCROLL_MASK | self.Gdk.EventMask.SMOOTH_SCROLL_MASK | self.Gdk.EventMask.TOUCH_MASK)
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.add(col)
        strip = Gtk.Box(margin_start=36, margin_end=36, margin_top=22)
        self.strip_day = Gtk.Label(xalign=0); self.strip_day.get_style_context().add_class("strip")
        self.strip_take = Gtk.Label(xalign=1); self.strip_take.get_style_context().add_class("strip")
        strip.pack_start(self.strip_day, True, True, 0); strip.pack_end(self.strip_take, False, False, 0)
        col.pack_start(strip, False, False, 0)
        over = Gtk.Overlay()
        col.pack_start(over, True, True, 0)
        self.feed_stack = Gtk.Stack()
        self.feed_stack.set_transition_type(Gtk.StackTransitionType.SLIDE_UP_DOWN)
        self.feed_stack.set_transition_duration(320)
        self.feed_stack.set_homogeneous(True)
        over.add(self.feed_stack)
        self.dots = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, valign=Gtk.Align.CENTER, halign=Gtk.Align.END, margin_end=22)
        over.add_overlay(self.dots)
        over.set_overlay_pass_through(self.dots, True)
        hint = Gtk.Button(label="⌄")
        hint.get_style_context().add_class("tab")
        hint.set_valign(Gtk.Align.END); hint.set_halign(Gtk.Align.CENTER); hint.set_margin_bottom(6)
        hint.connect("clicked", lambda *_: self.feed_go(1))
        over.add_overlay(hint)
        swipe = Gtk.GestureSwipe.new(box)
        swipe.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        swipe.set_touch_only(False)
        swipe.connect("swipe", self.on_swipe)
        self._swipe = swipe
        box.connect("scroll-event", self.on_scroll)
        self._scroll_at = 0.0
        self.cards = []
        self.feed_i = 0
        return box

    def on_swipe(self, _g, vx, vy):
        if abs(vy) > 250 and abs(vy) > abs(vx):
            self.feed_go(1 if vy < 0 else -1)

    def on_scroll(self, _w, ev):
        import time
        ok, dx, dy = ev.get_scroll_deltas()
        d = dy if ok else (1 if ev.direction == self.Gdk.ScrollDirection.DOWN else -1 if ev.direction == self.Gdk.ScrollDirection.UP else 0)
        t = time.monotonic()
        if d and t - self._scroll_at > 0.45:
            self._scroll_at = t
            self.feed_go(1 if d > 0 else -1)
        return True

    def feed_go(self, step):
        if not self.cards:
            return
        self.feed_i = max(0, min(len(self.cards) - 1, self.feed_i + step))
        self.feed_stack.set_visible_child_name(str(self.feed_i))
        self.update_dots()

    def update_dots(self):
        for ch in self.dots.get_children():
            self.dots.remove(ch)
        for i in range(len(self.cards)):
            l = self.Gtk.Label(label="●")
            l.get_style_context().add_class("dot-on" if i == self.feed_i else "dot")
            self.dots.pack_start(l, False, False, 0)
        self.dots.show_all()

    def refresh_feed(self):
        Gtk = self.Gtk
        keep = self.cards[self.feed_i]["id"] if self.cards else None
        for ch in self.feed_stack.get_children():
            self.feed_stack.remove(ch)
        self.cards = build_feed(s=self.s)
        for i, c in enumerate(self.cards):
            self.feed_stack.add_named(self.scrolled(self.card_widget(c)), str(i))
        t = totals()
        n_today = sum(1 for c in self.cards if c["kind"] == "booking" and c["kicker"].startswith(("Next up", "Later today")))
        self.strip_day.set_text(now().strftime("%A, %B %-d"))
        self.strip_take.set_text(f"{n_today} client{'s' if n_today != 1 else ''} today  ·  {money(t['today'], self.cur)} in")
        self.feed_i = next((i for i, c in enumerate(self.cards) if c["id"] == keep), 0)
        self.feed_stack.show_all()
        self.feed_stack.set_visible_child_name(str(self.feed_i))
        self.update_dots()

    def card_widget(self, c):
        Gtk = self.Gtk
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER, halign=Gtk.Align.CENTER, spacing=12)
        outer.get_style_context().add_class("feedcard")
        outer.set_size_request(780, -1)
        outer.set_margin_start(60); outer.set_margin_end(80); outer.set_margin_top(24); outer.set_margin_bottom(44)
        k = Gtk.Label(label=c["kicker"].upper(), xalign=0.5); k.get_style_context().add_class("kicker")
        outer.pack_start(k, False, False, 0)
        t = Gtk.Label(label=c["title"], xalign=0.5, wrap=True, justify=Gtk.Justification.CENTER); t.get_style_context().add_class("title")
        outer.pack_start(t, False, False, 0)
        if c["big"]:
            b = Gtk.Label(label=c["big"], xalign=0.5, wrap=True, justify=Gtk.Justification.CENTER)
            b.get_style_context().add_class("big" if (c["kind"] in ("money", "deposit", "rebook")) else "big-small")
            outer.pack_start(b, False, False, 0)
        if c["sub"]:
            s = Gtk.Label(label=c["sub"], xalign=0.5, wrap=True, justify=Gtk.Justification.CENTER); s.get_style_context().add_class("sub")
            s.set_max_width_chars(60)
            outer.pack_start(s, False, False, 6)
        p = c.get("primary")
        if p:
            pb = self.button(p["label"], lambda a=p: self.act(a), primary=True)
            pb.set_halign(Gtk.Align.CENTER); pb.set_margin_top(18)
            outer.pack_start(pb, False, False, 0)
        if c.get("actions"):
            row = Gtk.Box(spacing=10, halign=Gtk.Align.CENTER)
            for a in c["actions"]:
                row.pack_start(self.button(a["label"], lambda a=a: self.act(a)), False, False, 0)
            outer.pack_start(row, False, False, 6)
        return outer

    def act(self, a):
        do = a["do"]
        if do == "pay":
            self.pay_prefill(a.get("amount"), a.get("kind"), a.get("client"), a.get("booking"))
            self.show_page("pay")
            if a.get("amount"):
                self.show_qr_for_amount()
        elif do == "book":
            self.show_page("book")
            if a.get("client"):
                self.book_client.set_text(a["client"])
        elif do == "consent":
            self.show_page("papers")
            self.start_consent(a.get("client", ""), a.get("what", ""))
        elif do == "stencil":
            spawn(["stencil-print", "--gui"]) or self.say("Print Stencil is not installed here.")
        elif do == "done":
            update_booking(a["booking"], status="done")
            self.say("Marked done. Nice work.")
            self.refresh_feed()
        elif do == "cancel":
            update_booking(a["booking"], status="cancelled")
            self.say("Booking cancelled.")
            self.refresh_feed()
        elif do == "dismiss":
            update_booking(a["booking"], status="done-dismissed")
            self.refresh_feed()
        elif do == "money":
            self.show_page("money")
        elif do == "export":
            self.say("Saved " + export_csv().replace(HOME, "~"))
        elif do == "qr":
            self.show_static_qr(a["which"])
        elif do == "aftercare":
            self.aftercare(a.get("how", "show"))
        elif do == "settings":
            self.show_page("settings")

    # ---- get paid
    def make_pay(self):
        Gtk = self.Gtk
        box = Gtk.Box(spacing=40, margin=40, halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
        left = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        self.amount_s = ""
        self.amount_label = Gtk.Label(label=f"{self.cur}0", xalign=0.5)
        self.amount_label.get_style_context().add_class("amount")
        left.pack_start(self.amount_label, False, False, 0)
        grid = Gtk.Grid(row_spacing=10, column_spacing=10, halign=Gtk.Align.CENTER)
        keys = ["7", "8", "9", "4", "5", "6", "1", "2", "3", ".", "0", "⌫"]
        for i, kch in enumerate(keys):
            b = Gtk.Button(label=kch); b.get_style_context().add_class("key")
            b.connect("clicked", self.on_keypad, kch)
            grid.attach(b, i % 3, i // 3, 1, 1)
        left.pack_start(grid, False, False, 0)
        quick = Gtk.Box(spacing=8, halign=Gtk.Align.CENTER)
        for amt in (50, 100, 150, 200):
            b = Gtk.Button(label=money(amt, self.cur)); b.get_style_context().add_class("chip")
            b.connect("clicked", lambda _b, v=amt: self.set_amount(str(v)))
            quick.pack_start(b, False, False, 0)
        left.pack_start(quick, False, False, 0)
        box.pack_start(left, False, False, 0)

        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16, valign=Gtk.Align.CENTER)
        lab = Gtk.Label(label="WHAT FOR", xalign=0); lab.get_style_context().add_class("kicker")
        right.pack_start(lab, False, False, 0)
        kinds = Gtk.Box(spacing=8)
        self.kind_buttons = {}
        first = None
        for kd in KINDS:
            b = Gtk.RadioButton.new_with_label_from_widget(first, KIND_TITLES[kd])
            b.set_mode(False); b.get_style_context().add_class("chip")
            first = first or b
            self.kind_buttons[kd] = b
            kinds.pack_start(b, False, False, 0)
        self.kind_buttons["balance"].set_active(True)
        right.pack_start(kinds, False, False, 0)
        lab = Gtk.Label(label="WHO", xalign=0); lab.get_style_context().add_class("kicker")
        right.pack_start(lab, False, False, 0)
        self.pay_client = Gtk.ComboBoxText.new_with_entry()
        self.pay_client.get_child().set_placeholder_text("Walk-in")
        right.pack_start(self.pay_client, False, False, 0)
        self.pay_note = Gtk.Entry(placeholder_text="Note (optional)")
        right.pack_start(self.pay_note, False, False, 0)
        self.pay_booking = None
        meth = Gtk.Label(xalign=0, wrap=True); meth.get_style_context().add_class("sub")
        self.pay_methods_label = meth
        right.pack_start(meth, False, False, 0)
        right.pack_start(self.button("Show the pay code", self.show_qr_for_amount, primary=True), False, False, 10)
        row = Gtk.Box(spacing=8)
        row.pack_start(self.button("Paid cash ✓", lambda: self.record_from_pay("cash")), False, False, 0)
        row.pack_start(self.button("Paid by card ✓", lambda: self.record_from_pay("card")), False, False, 0)
        right.pack_start(row, False, False, 0)
        box.pack_start(right, False, False, 0)
        return box

    def pay_prefill(self, amount=None, kind=None, client=None, booking=None):
        self.set_amount("" if amount is None else (f"{float(amount):.2f}".rstrip("0").rstrip(".")))
        if kind in self.kind_buttons:
            self.kind_buttons[kind].set_active(True)
        self.pay_client.remove_all()
        names = []
        for b in sorted([b for b in bookings() if b["status"] == "booked"], key=booking_dt):
            if b["client"] not in names:
                names.append(b["client"])
        for n in names:
            self.pay_client.append_text(n)
        self.pay_client.get_child().set_text(client or "")
        self.pay_booking = booking
        ms = configured_methods(self.s)
        self.pay_methods_label.set_text(("Clients scan: " + ", ".join(METHOD_TITLES[m] for m in ms)) if ms else "No payment apps set up yet — add them under Money › Settings. Cash and card still record.")

    def on_keypad(self, _b, k):
        if k == "⌫":
            self.set_amount(self.amount_s[:-1])
        elif k == ".":
            if "." not in self.amount_s:
                self.set_amount((self.amount_s or "0") + ".")
        elif len(self.amount_s.split(".")[0]) < 5 and not ("." in self.amount_s and len(self.amount_s.split(".")[1]) >= 2):
            self.set_amount(self.amount_s + k)

    def set_amount(self, s):
        self.amount_s = s
        try:
            v = float(s or 0)
        except ValueError:
            v = 0
        self.amount_label.set_text(money(v, self.cur) if s else f"{self.cur}0")

    def pay_kind(self):
        return next(k for k, b in self.kind_buttons.items() if b.get_active())

    def amount_value(self):
        try:
            return round(float(self.amount_s or 0), 2)
        except ValueError:
            return 0.0

    def record_from_pay(self, method):
        v = self.amount_value()
        if v <= 0:
            self.say("Type the amount first.")
            return
        e = record_payment(v, method, self.pay_client.get_child().get_text(), self.pay_kind(), self.pay_note.get_text(), booking=self.pay_booking)
        self.say(f"{money(e['amount'], self.cur)} recorded · {METHOD_TITLES.get(method, method)}")
        self.set_amount("")
        self.pay_booking = None
        self.show_page("feed")

    # ---- the QR page
    def make_qr_page(self):
        Gtk = self.Gtk
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin=30, halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
        self.qr_kicker = Gtk.Label(); self.qr_kicker.get_style_context().add_class("kicker")
        self.qr_title = Gtk.Label(); self.qr_title.get_style_context().add_class("big")
        self.qr_sub = Gtk.Label(wrap=True, justify=Gtk.Justification.CENTER); self.qr_sub.get_style_context().add_class("sub")
        box.pack_start(self.qr_kicker, False, False, 0)
        box.pack_start(self.qr_title, False, False, 0)
        self.qr_methods = Gtk.Box(spacing=8, halign=Gtk.Align.CENTER)
        box.pack_start(self.qr_methods, False, False, 6)
        self.qr_image = Gtk.Image()
        frame = Gtk.Box(); frame.get_style_context().add_class("card"); frame.set_halign(Gtk.Align.CENTER)
        frame.add(self.qr_image)
        box.pack_start(frame, False, False, 6)
        self.qr_handle = Gtk.Label(); self.qr_handle.get_style_context().add_class("title")
        self.qr_handle.set_selectable(True)
        box.pack_start(self.qr_handle, False, False, 0)
        box.pack_start(self.qr_sub, False, False, 0)
        self.qr_buttons = Gtk.Box(spacing=10, halign=Gtk.Align.CENTER, margin_top=14)
        box.pack_start(self.qr_buttons, False, False, 0)
        self.qr_state = {}
        return box

    def qr_size(self):
        h = 1080
        disp = self.Gdk.Display.get_default()
        mon = disp.get_primary_monitor() or disp.get_monitor(0) if disp else None
        if mon:
            h = mon.get_geometry().height
        return max(260, min(460, h - 440))

    def set_qr(self, text, size=None):
        size = size or self.qr_size()
        try:
            data = qr_png(text, box=10)
        except Exception as ex:  # noqa: BLE001
            self.qr_image.clear()
            self.qr_handle.set_text(f"Could not make the code: {ex}")
            return
        loader = self.GdkPixbuf.PixbufLoader.new_with_type("png")
        loader.write(data); loader.close()
        pb = loader.get_pixbuf().scale_simple(size, size, self.GdkPixbuf.InterpType.NEAREST)
        self.qr_image.set_from_pixbuf(pb)

    def show_qr_for_amount(self):
        v = self.amount_value()
        if v <= 0:
            self.say("Type the amount first.")
            return
        ms = configured_methods(self.s)
        kind, client = self.pay_kind(), self.pay_client.get_child().get_text().strip()
        self.qr_state = {"amount": v, "kind": kind, "client": client, "booking": self.pay_booking, "note": self.pay_note.get_text().strip()}
        self.qr_kicker.set_text(" · ".join(x for x in (KIND_TITLES[kind].upper(), client.upper()) if x) or "PAYMENT")
        self.qr_title.set_text(money(v, self.cur))
        for ch in self.qr_methods.get_children():
            self.qr_methods.remove(ch)
        for ch in self.qr_buttons.get_children():
            self.qr_buttons.remove(ch)
        if ms:
            first = None
            for m in ms:
                b = self.Gtk.RadioButton.new_with_label_from_widget(first, METHOD_TITLES[m])
                b.set_mode(False); b.get_style_context().add_class("chip")
                first = first or b
                b.connect("toggled", lambda bb, mm=m: bb.get_active() and self.qr_method(mm))
                self.qr_methods.pack_start(b, False, False, 0)
            self.qr_method(ms[0])
            for m in ms:
                self.qr_buttons.pack_start(self.button(f"Paid ✓ {METHOD_TITLES[m]}", lambda mm=m: self.qr_paid(mm), primary=(m == ms[0])), False, False, 0)
        else:
            self.qr_image.clear()
            self.qr_handle.set_text("No payment app set up")
            self.qr_sub.set_text("Add your Venmo, Cash App, PayPal, Square or Zelle once under Money › Settings.")
        self.qr_buttons.pack_start(self.button("Paid cash ✓", lambda: self.qr_paid("cash")), False, False, 0)
        self.qr_buttons.pack_start(self.button("Back", lambda: self.show_page("pay")), False, False, 0)
        self.qr_methods.show_all(); self.qr_buttons.show_all()
        self.show_page("qr")

    def qr_method(self, m):
        st = self.qr_state
        note = st.get("note") or " ".join(x for x in (st.get("kind", "").capitalize(), st.get("client", "")) if x)
        link = pay_link(m, st["amount"], note, self.s)
        self.qr_state["method"] = m
        if m == "zelle":
            self.set_qr(link)
            self.qr_handle.set_text(link)
            self.qr_sub.set_text(f"Zelle has no pay link: send {money(st['amount'], self.cur)} to this number or e-mail in your banking app.")
        else:
            self.set_qr(link)
            handle = self.s["pay"][m]
            self.qr_handle.set_text(handle if m != "square" else "Square checkout")
            self.qr_sub.set_text("Scan with the phone camera. The amount is filled in." if m != "square" else f"Scan with the phone camera and enter {money(st['amount'], self.cur)}.")

    def qr_paid(self, method):
        st = self.qr_state
        e = record_payment(st["amount"], method, st.get("client", ""), st.get("kind", "other"), st.get("note", ""), booking=st.get("booking"))
        self.say(f"{money(e['amount'], self.cur)} recorded · {METHOD_TITLES.get(method, method)}")
        self.set_amount("")
        self.pay_booking = None
        self.show_page("feed")

    def show_static_qr(self, which):
        link = self.s.get("review_link") if which == "review" else (self.s.get("booking_link") or profile()["links"].get("booking", ""))
        if not link:
            self.say("No link set — add it under Money › Settings.")
            return
        if not link.startswith("http"):
            link = "https://" + link
        for ch in self.qr_methods.get_children():
            self.qr_methods.remove(ch)
        for ch in self.qr_buttons.get_children():
            self.qr_buttons.remove(ch)
        self.qr_kicker.set_text("SCAN ME")
        self.qr_title.set_text("Leave a review" if which == "review" else "Book your next session")
        self.set_qr(link)
        self.qr_handle.set_text(re.sub(r"^https?://", "", link)[:48])
        self.qr_sub.set_text("Thank you — it means a lot to a small studio." if which == "review" else "Pick a day that suits you; a deposit reserves the slot.")
        self.qr_buttons.pack_start(self.button("Done", lambda: self.show_page("feed"), primary=True), False, False, 0)
        self.qr_buttons.show_all()
        self.show_page("qr")

    # ---- book
    def make_book(self):
        Gtk = self.Gtk
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box = Gtk.Box(spacing=36, margin=40, halign=Gtk.Align.CENTER, valign=Gtk.Align.START)
        page.pack_start(box, False, False, 0)
        self.keyboard_room(page)
        left = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        for text in ("WHO",):
            l = Gtk.Label(label=text, xalign=0); l.get_style_context().add_class("kicker"); left.pack_start(l, False, False, 0)
        self.book_client = Gtk.Entry(placeholder_text="Client name")
        comp = Gtk.EntryCompletion(); store = Gtk.ListStore(str)
        for n in sorted(clients()):
            store.append([n])
        comp.set_model(store); comp.set_text_column(0); comp.set_inline_completion(True)
        self.book_client.set_completion(comp)
        left.pack_start(self.book_client, False, False, 0)
        l = Gtk.Label(label="WHAT", xalign=0); l.get_style_context().add_class("kicker"); left.pack_start(l, False, False, 0)
        self.book_what = Gtk.Entry(placeholder_text="Dragon, forearm, black and grey")
        left.pack_start(self.book_what, False, False, 0)
        l = Gtk.Label(label="PRICE", xalign=0); l.get_style_context().add_class("kicker"); left.pack_start(l, False, False, 0)
        self.book_price = Gtk.Entry(placeholder_text="0", input_purpose=Gtk.InputPurpose.NUMBER)
        left.pack_start(self.book_price, False, False, 0)
        row = Gtk.Box(spacing=6)
        for v in (150, 250, 400, 600):
            b = Gtk.Button(label=money(v, self.cur)); b.get_style_context().add_class("chip")
            b.connect("clicked", lambda _b, vv=v: self.book_price.set_text(str(vv)))
            row.pack_start(b, False, False, 0)
        left.pack_start(row, False, False, 0)
        l = Gtk.Label(label="DEPOSIT", xalign=0); l.get_style_context().add_class("kicker"); left.pack_start(l, False, False, 0)
        row = Gtk.Box(spacing=6)
        self.dep_buttons = {}
        first = None
        for v in (0, 50, 100, 150, 200):
            b = Gtk.RadioButton.new_with_label_from_widget(first, "None" if v == 0 else money(v, self.cur))
            b.set_mode(False); b.get_style_context().add_class("chip")
            first = first or b
            self.dep_buttons[v] = b
            row.pack_start(b, False, False, 0)
        dd = int(self.s.get("default_deposit", 50))
        self.dep_buttons.get(dd, self.dep_buttons[0]).set_active(True)
        left.pack_start(row, False, False, 0)
        box.pack_start(left, False, False, 0)

        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        l = Gtk.Label(label="WHEN", xalign=0); l.get_style_context().add_class("kicker"); right.pack_start(l, False, False, 0)
        self.book_cal = Gtk.Calendar()
        right.pack_start(self.book_cal, False, False, 0)
        grid = Gtk.Grid(row_spacing=6, column_spacing=6)
        self.time_buttons = {}
        first = None
        h0, h1 = [int(x.split(":")[0]) for x in self.s.get("hours", ["10:00", "19:30"])]
        slots = []
        h, mi = h0, 0
        while h < h1 or (h == h1 and mi <= int(self.s.get("hours", ["10:00", "19:30"])[1].split(":")[1])):
            slots.append(f"{h:02d}:{mi:02d}")
            mi += 30
            if mi == 60:
                h, mi = h + 1, 0
        for i, t in enumerate(slots):
            lbl = dt.datetime.strptime(t, "%H:%M").strftime("%-I:%M %p").replace(":00", "")
            b = Gtk.RadioButton.new_with_label_from_widget(first, lbl)
            b.set_mode(False); b.get_style_context().add_class("chip")
            first = first or b
            self.time_buttons[t] = b
            grid.attach(b, i % 5, i // 5, 1, 1)
        right.pack_start(grid, False, False, 0)
        right.pack_start(self.button("Book it", self.do_book, primary=True), False, False, 12)
        box.pack_start(right, False, False, 0)
        return page

    def book_when(self):
        y, m, d = self.book_cal.get_date()
        t = next(t for t, b in self.time_buttons.items() if b.get_active())
        return dt.datetime(y, m + 1, d, int(t[:2]), int(t[3:]))

    def apply_prefill(self, page, pre):
        if page == "book":
            if pre.get("client"):
                self.book_client.set_text(pre["client"])
            if pre.get("what"):
                self.book_what.set_text(pre["what"])
            if pre.get("when"):
                try:
                    w = parse_when(pre["when"])
                    self.book_cal.select_month(w.month - 1, w.year); self.book_cal.select_day(w.day)
                    key = f"{w.hour:02d}:{(w.minute // 30) * 30:02d}"
                    if key in self.time_buttons:
                        self.time_buttons[key].set_active(True)
                except ValueError:
                    self.say(f"Didn't understand the time “{pre['when']}” — pick it here.")
        if page == "pay":
            self.pay_prefill(pre.get("amount"), pre.get("kind"), pre.get("client"))
            if pre.get("amount"):
                self.show_qr_for_amount()
        if page == "papers" and pre.get("consent"):
            flow = self.start_consent(pre.get("client", ""), pre.get("what", ""))
            if pre.get("step") in ("statements", "sign"):
                flow.stack.set_visible_child_name(pre["step"])  # screenshots of the later steps
        if page == "qr" and pre.get("which"):
            self.show_static_qr(pre["which"])

    def do_book(self):
        name = self.book_client.get_text().strip()
        if not name:
            self.say("Who is it for? Type the client's name.")
            self.book_client.grab_focus()
            return
        try:
            price = float(self.book_price.get_text().strip() or 0)
        except ValueError:
            self.say("The price has to be a number.")
            return
        dep = next(v for v, b in self.dep_buttons.items() if b.get_active())
        b = add_booking(name, self.book_what.get_text() or "Tattoo", self.book_when(), price, dep)
        self.book_client.set_text(""); self.book_what.set_text(""); self.book_price.set_text("")
        self.say(f"Booked {b['client']} · {booking_dt(b).strftime('%a %b %-d, %-I:%M %p')}")
        if dep > 0:
            self.pay_prefill(dep, "deposit", b["client"], b["id"])
            self.show_page("pay")
            self.show_qr_for_amount()
        else:
            self.show_page("feed")

    # ---- papers
    def make_papers(self):
        Gtk = self.Gtk
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=24, margin=40, halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
        row = Gtk.Box(spacing=24, homogeneous=True)
        for title, sub, prim, prim_cb, sec in (
            ("Consent form", "Who, date of birth, phone, address, the statements, a finger signature. Saved as PDF and kept two years, as the health rules ask.", "Start a consent form", lambda: self.start_consent("", ""), None),
            ("Aftercare sheet", "Your studio's aftercare instructions with your name and handle on top. Print one per client, or show it on the screen.", "Print aftercare", lambda: self.aftercare("print"), ("Show on screen", lambda: self.aftercare("show"))),
        ):
            card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10); card.get_style_context().add_class("card")
            t = Gtk.Label(label=title, xalign=0); t.get_style_context().add_class("title"); card.pack_start(t, False, False, 0)
            s = Gtk.Label(label=sub, xalign=0, wrap=True); s.get_style_context().add_class("sub"); s.set_max_width_chars(38); card.pack_start(s, False, False, 0)
            card.pack_start(self.button(prim, prim_cb, primary=True), False, False, 8)
            if sec:
                card.pack_start(self.button(sec[0], sec[1]), False, False, 0)
            row.pack_start(card, True, True, 0)
        box.pack_start(row, False, False, 0)
        l = Gtk.Label(label="RECENT CONSENT FORMS", xalign=0); l.get_style_context().add_class("kicker"); box.pack_start(l, False, False, 0)
        self.consent_list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.pack_start(self.consent_list, False, False, 0)
        return box

    def refresh_papers(self):
        Gtk = self.Gtk
        for ch in self.consent_list.get_children():
            self.consent_list.remove(ch)
        d = os.path.join(BUSINESS, "Consent")
        files = sorted((f for f in os.listdir(d) if f.endswith(".pdf")), reverse=True)[:6] if os.path.isdir(d) else []
        if not files:
            l = Gtk.Label(label="None yet.", xalign=0); l.get_style_context().add_class("sub"); self.consent_list.pack_start(l, False, False, 0)
        for f in files:
            row = Gtk.Box(spacing=12); row.get_style_context().add_class("row")
            l = Gtk.Label(label=f[:-4], xalign=0); l.get_style_context().add_class("sub"); row.pack_start(l, True, True, 0)
            path = os.path.join(d, f)
            row.pack_start(self.button("Open", lambda p=path: spawn(["xdg-open", p]), cls="chip"), False, False, 0)
            row.pack_start(self.button("Print", lambda p=path: self.say(print_file(p)[1] or "Sent to the printer."), cls="chip"), False, False, 0)
            self.consent_list.pack_start(row, False, False, 0)
        self.consent_list.show_all()

    def aftercare(self, how):
        os.makedirs(BUSINESS, exist_ok=True)
        out = os.path.join(BUSINESS, "Aftercare.pdf")
        aftercare_pdf(out)
        if how == "print":
            ok, msg = print_file(out)
            self.say("Aftercare sheet sent to the printer." if ok else (msg or "Could not print."))
        else:
            spawn(["xdg-open", out]) or self.say("Saved " + out.replace(HOME, "~"))

    def start_consent(self, client, what):
        return ConsentFlow(self, client, what)

    # ---- money
    def make_money(self):
        Gtk = self.Gtk
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18, margin=40)
        head = Gtk.Box()
        l = Gtk.Label(label="MONEY", xalign=0); l.get_style_context().add_class("kicker")
        head.pack_start(l, True, True, 0)
        head.pack_end(self.button("Settings", lambda: self.show_page("settings"), cls="chip"), False, False, 0)
        box.pack_start(head, False, False, 0)
        self.tiles = {}
        row = Gtk.Box(spacing=14, homogeneous=True)
        for key, title in (("today", "Today"), ("week", "This week"), ("month", "This month"), ("year", "This year")):
            tile = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4); tile.get_style_context().add_class("tile")
            t = Gtk.Label(label=title, xalign=0); t.get_style_context().add_class("sub")
            v = Gtk.Label(label="", xalign=0); v.get_style_context().add_class("tile-big")
            tile.pack_start(t, False, False, 0); tile.pack_start(v, False, False, 0)
            self.tiles[key] = v
            row.pack_start(tile, True, True, 0)
        box.pack_start(row, False, False, 0)
        acts = Gtk.Box(spacing=10)
        acts.pack_start(self.button("Export for taxes", lambda: self.say("Saved " + export_csv().replace(HOME, "~"))), False, False, 0)
        acts.pack_start(self.button("Open the Business folder", lambda: (os.makedirs(BUSINESS, exist_ok=True), spawn(["xdg-open", BUSINESS]))), False, False, 0)
        box.pack_start(acts, False, False, 0)
        self.ledger_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.pack_start(self.ledger_box, True, True, 0)
        return box

    def refresh_money(self):
        Gtk = self.Gtk
        t = totals()
        for k, v in self.tiles.items():
            v.set_text(money(t[k], self.cur))
        for ch in self.ledger_box.get_children():
            self.ledger_box.remove(ch)
        for e in sorted(ledger(), key=lambda e: e["when"], reverse=True)[:60]:
            row = Gtk.Box(spacing=16); row.get_style_context().add_class("row")
            when = dt.datetime.strptime(e["when"], "%Y-%m-%d %H:%M")
            a = Gtk.Label(label=when.strftime("%a %b %-d · %-I:%M %p"), xalign=0); a.get_style_context().add_class("sub"); a.set_size_request(220, -1)
            b = Gtk.Label(label=" · ".join(x for x in (e.get("client"), KIND_TITLES.get(e["kind"], e["kind"]), e.get("note")) if x), xalign=0, ellipsize=self.Pango.EllipsizeMode.END)
            c = Gtk.Label(label=METHOD_TITLES.get(e["method"], e["method"]), xalign=1); c.get_style_context().add_class("sub")
            d = Gtk.Label(label=money(e["amount"], self.cur), xalign=1); d.get_style_context().add_class("title"); d.set_size_request(140, -1)
            row.pack_start(a, False, False, 0); row.pack_start(b, True, True, 0); row.pack_start(c, False, False, 0); row.pack_start(d, False, False, 0)
            self.ledger_box.pack_start(row, False, False, 0)
        if not ledger():
            l = Gtk.Label(label="No payments recorded yet. Tap Get paid when the first one comes in.", xalign=0); l.get_style_context().add_class("sub")
            self.ledger_box.pack_start(l, False, False, 0)
        self.ledger_box.show_all()

    # ---- settings
    def make_settings(self):
        Gtk = self.Gtk
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, margin=40, halign=Gtk.Align.CENTER, valign=Gtk.Align.START)
        self.keyboard_room(box)
        l = Gtk.Label(label="HOW YOU GET PAID", xalign=0); l.get_style_context().add_class("kicker"); box.pack_start(l, False, False, 0)
        s = Gtk.Label(label="Type each handle once. The pay code puts the amount in for the client.", xalign=0, wrap=True); s.get_style_context().add_class("sub"); box.pack_start(s, False, False, 0)
        self.set_entries = {}
        grid = Gtk.Grid(row_spacing=8, column_spacing=14)
        rows = [("venmo", "Venmo username", "@yourstudio"), ("cashapp", "Cash App $cashtag", "$yourstudio"), ("paypal", "PayPal.me name", "yourstudio"),
                ("square", "Square checkout link", "https://square.link/u/…"), ("zelle", "Zelle phone or e-mail", "555-010-0000"),
                ("review_link", "Review link (Google)", "https://g.page/r/…/review"), ("booking_link", "Booking page", "https://…"),
                ("default_deposit", "Usual deposit", "50"), ("printer", "Printer for papers (blank = default)", "")]
        for i, (key, label, ph) in enumerate(rows):
            lab = Gtk.Label(label=label, xalign=0); lab.get_style_context().add_class("sub")
            ent = Gtk.Entry(placeholder_text=ph); ent.set_width_chars(34)
            val = self.s["pay"].get(key, "") if key in METHODS else str(self.s.get(key, "") or "")
            ent.set_text(val if val != "0" or key != "default_deposit" else "")
            self.set_entries[key] = ent
            grid.attach(lab, 0, i, 1, 1); grid.attach(ent, 1, i, 1, 1)
        box.pack_start(grid, False, False, 0)
        row = Gtk.Box(spacing=10, margin_top=12)
        row.pack_start(self.button("Save", self.save_settings, primary=True), False, False, 0)
        row.pack_start(self.button("Back", lambda: self.show_page("money")), False, False, 0)
        box.pack_start(row, False, False, 0)
        return box

    def save_settings(self):
        for key, ent in self.set_entries.items():
            v = ent.get_text().strip()
            if key == "default_deposit":
                v = re.sub(r"[^0-9]", "", v) or "0"
            set_setting(key, v)
        self.s = settings()
        self.say("Saved.")
        self.show_page("feed")


class ConsentFlow:
    """Three screens in their own window: who · the statements · sign."""

    def __init__(self, app, client, what):
        Gtk = app.Gtk
        self.app, self.Gtk = app, Gtk
        self.strokes, self.cur_stroke = [], None
        self.win = Gtk.Window(title="Consent form", transient_for=app.win, modal=True)
        self.win.set_default_size(1000, 700)
        self.win.maximize()
        if app.shot:
            app.shot_target = self.win
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL); root.get_style_context().add_class("till-root")
        self.win.add(root)
        self.stack = Gtk.Stack(); self.stack.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
        root.pack_start(app.scrolled(self.stack), True, True, 0)
        self.note = Gtk.Label(); self.note.get_style_context().add_class("toast"); self.note.set_no_show_all(True)
        root.pack_start(self.note, False, False, 0)
        # 1 who
        who = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, margin=40, halign=Gtk.Align.CENTER, valign=Gtk.Align.START)
        app.keyboard_room(who)
        k = Gtk.Label(label="CONSENT · 1 OF 3", xalign=0); k.get_style_context().add_class("kicker"); who.pack_start(k, False, False, 0)
        t = Gtk.Label(label="Who is getting tattooed?", xalign=0); t.get_style_context().add_class("title"); who.pack_start(t, False, False, 0)
        self.e = {}
        known = clients().get(client, {}) if client else {}
        for key, ph, val in (("client", "Full name", client), ("dob", "Date of birth  YYYY-MM-DD", known.get("dob", "")), ("phone", "Phone", known.get("phone", "")),
                             ("address", "Address", known.get("address", "")), ("email", "E-mail (optional)", known.get("email", "")),
                             ("design", "The tattoo", what), ("placement", "Where on the body", "")):
            ent = Gtk.Entry(placeholder_text=ph); ent.set_text(val or ""); ent.set_width_chars(40)
            self.e[key] = ent
            who.pack_start(ent, False, False, 0)
        row = Gtk.Box(spacing=10, margin_top=10)
        row.pack_start(app.button("Next", self.to_statements, primary=True), False, False, 0)
        row.pack_start(app.button("Cancel", self.win.destroy), False, False, 0)
        who.pack_start(row, False, False, 0)
        self.stack.add_named(who, "who")
        # 2 statements
        st = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin=40, halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
        k = Gtk.Label(label="CONSENT · 2 OF 3", xalign=0); k.get_style_context().add_class("kicker"); st.pack_start(k, False, False, 0)
        t = Gtk.Label(label="Read with the client. Tap each one that is true.", xalign=0, wrap=True); t.get_style_context().add_class("title"); t.set_max_width_chars(40); st.pack_start(t, False, False, 0)
        self.checks = {}
        for key, text in CONSENT_STATEMENTS:
            cb = Gtk.CheckButton(label=text); cb.get_child().set_line_wrap(True); cb.get_child().set_max_width_chars(80); cb.get_child().set_xalign(0)
            self.checks[key] = cb
            st.pack_start(cb, False, False, 0)
        self.photo_cb = Gtk.CheckButton(label="Optional: " + PHOTO_STATEMENT); self.photo_cb.get_child().set_line_wrap(True); self.photo_cb.get_child().set_max_width_chars(80)
        st.pack_start(self.photo_cb, False, False, 6)
        row = Gtk.Box(spacing=10, margin_top=10)
        row.pack_start(app.button("Next: sign", self.to_sign, primary=True), False, False, 0)
        row.pack_start(app.button("Back", lambda: self.stack.set_visible_child_name("who")), False, False, 0)
        st.pack_start(row, False, False, 0)
        self.stack.add_named(st, "statements")
        # 3 sign
        sg = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, margin=40, halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
        k = Gtk.Label(label="CONSENT · 3 OF 3", xalign=0); k.get_style_context().add_class("kicker"); sg.pack_start(k, False, False, 0)
        t = Gtk.Label(label="Sign with a finger", xalign=0); t.get_style_context().add_class("title"); sg.pack_start(t, False, False, 0)
        self.pad = Gtk.DrawingArea(); self.pad.set_size_request(760, 300); self.pad.get_style_context().add_class("sigpad")
        self.pad.add_events(app.Gdk.EventMask.BUTTON_PRESS_MASK | app.Gdk.EventMask.BUTTON_RELEASE_MASK | app.Gdk.EventMask.POINTER_MOTION_MASK | app.Gdk.EventMask.TOUCH_MASK)
        self.pad.connect("draw", self.on_draw)
        self.pad.connect("button-press-event", self.pen_down)
        self.pad.connect("motion-notify-event", self.pen_move)
        self.pad.connect("button-release-event", self.pen_up)
        self.pad.connect("touch-event", self.on_touch)
        sg.pack_start(self.pad, False, False, 0)
        row = Gtk.Box(spacing=10, margin_top=10)
        row.pack_start(app.button("Save the form", self.finish, primary=True), False, False, 0)
        row.pack_start(app.button("Clear", self.clear), False, False, 0)
        row.pack_start(app.button("Back", lambda: self.stack.set_visible_child_name("statements")), False, False, 0)
        sg.pack_start(row, False, False, 0)
        self.stack.add_named(sg, "sign")
        # done
        dn = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin=40, halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
        self.done_title = Gtk.Label(); self.done_title.get_style_context().add_class("title"); dn.pack_start(self.done_title, False, False, 0)
        self.done_sub = Gtk.Label(wrap=True); self.done_sub.get_style_context().add_class("sub"); dn.pack_start(self.done_sub, False, False, 0)
        row = Gtk.Box(spacing=10, margin_top=10)
        row.pack_start(app.button("Print a copy", self.print_copy), False, False, 0)
        row.pack_start(app.button("Done", self.win.destroy, primary=True), False, False, 0)
        dn.pack_start(row, False, False, 0)
        self.stack.add_named(dn, "done")
        self.out = None
        self.win.show_all()

    def say(self, text):
        """A line at the bottom of this window (the main window's toast would sit behind it)."""
        self.note.set_text(text); self.note.show()
        self.app.GLib.timeout_add(4000, lambda: self.note.hide() or False)

    def to_statements(self):
        if not self.e["client"].get_text().strip():
            self.say("The client's name is needed."); return
        dob = self.e["dob"].get_text().strip()
        try:
            age = (now().date() - dt.date.fromisoformat(dob)).days // 365
        except ValueError:
            self.say("Date of birth as YYYY-MM-DD, please."); return
        if age < 18:
            self.say(f"Under 18 ({age}). Tattooing a minor is not allowed in North Carolina; stop here."); return
        self.stack.set_visible_child_name("statements")

    def to_sign(self):
        missing = [k for k, cb in self.checks.items() if not cb.get_active()]
        if missing:
            self.say("Every statement has to be ticked before signing."); return
        self.stack.set_visible_child_name("sign")

    def pen_down(self, _w, ev):
        self.cur_stroke = [self.norm(ev.x, ev.y)]
        self.strokes.append(self.cur_stroke)
        return True

    def pen_move(self, _w, ev):
        if self.cur_stroke is not None and (ev.state & self.app.Gdk.ModifierType.BUTTON1_MASK):
            self.cur_stroke.append(self.norm(ev.x, ev.y)); self.pad.queue_draw()
        return True

    def pen_up(self, *_a):
        self.cur_stroke = None; self.pad.queue_draw()
        return True

    def on_touch(self, _w, ev):
        Gdk = self.app.Gdk
        if ev.type == Gdk.EventType.TOUCH_BEGIN:
            self.cur_stroke = [self.norm(ev.x, ev.y)]; self.strokes.append(self.cur_stroke)
        elif ev.type == Gdk.EventType.TOUCH_UPDATE and self.cur_stroke is not None:
            self.cur_stroke.append(self.norm(ev.x, ev.y)); self.pad.queue_draw()
        elif ev.type in (Gdk.EventType.TOUCH_END, Gdk.EventType.TOUCH_CANCEL):
            self.cur_stroke = None; self.pad.queue_draw()
        return True

    def norm(self, x, y):
        a = self.pad.get_allocation()
        return (round(min(max(x / max(a.width, 1), 0), 1), 4), round(min(max(y / max(a.height, 1), 0), 1), 4))

    def on_draw(self, w, cr):
        a = w.get_allocation()
        cr.set_source_rgb(1, 1, 1); cr.paint()
        cr.set_source_rgb(0.8, 0.8, 0.85); cr.set_line_width(1)
        cr.move_to(40, a.height - 60); cr.line_to(a.width - 40, a.height - 60); cr.stroke()
        cr.set_source_rgb(0.05, 0.05, 0.25); cr.set_line_width(3.2); cr.set_line_cap(1); cr.set_line_join(1)
        for s in self.strokes:
            pts = [(x * a.width, y * a.height) for x, y in s]
            if len(pts) == 1:
                cr.arc(pts[0][0], pts[0][1], 1.6, 0, 6.3); cr.fill(); continue
            cr.move_to(*pts[0])
            for p in pts[1:]:
                cr.line_to(*p)
            cr.stroke()

    def clear(self):
        self.strokes = []; self.pad.queue_draw()

    def finish(self):
        if sum(len(s) for s in self.strokes) < 8:
            self.say("A signature is needed."); return
        g = {k: e.get_text().strip() for k, e in self.e.items()}
        self.out = save_consent(g["client"], g["dob"], g["phone"], g["address"], g["design"], g["placement"], self.strokes, photos=self.photo_cb.get_active(), email=g["email"])
        self.done_title.set_text("Saved")
        self.done_sub.set_text(self.out.replace(HOME, "~") + "\nKept with the studio's records for at least two years.")
        self.stack.set_visible_child_name("done")

    def print_copy(self):
        if self.out:
            ok, msg = print_file(self.out)
            self.say("Printing a copy." if ok else (msg or "Could not print."))


# ------------------------------------------------------------------ CLI

def fmt_booking(b):
    return f"{b['id']}  {b['when']}  {b['client']:<18} {b['what']:<28} {money(b['price'])}" + (f"  deposit {money(b['deposit'])}{'' if b['deposit_paid'] else ' OWED'}" if b["deposit"] else "") + f"  [{b['status']}]"


def main(argv=None):
    ap = argparse.ArgumentParser(prog="flattoo-till", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd")
    g = sub.add_parser("gui"); g.add_argument("--page", default="feed"); g.add_argument("--shot"); g.add_argument("--quit-after", type=float); g.add_argument("--fullscreen", action="store_true")
    p = sub.add_parser("pay"); p.add_argument("amount", nargs="?"); p.add_argument("--client", default=""); p.add_argument("--kind", default="balance"); p.add_argument("--note", default="")
    p.add_argument("--shot"); p.add_argument("--quit-after", type=float)
    p = sub.add_parser("paid"); p.add_argument("amount"); p.add_argument("--method", required=True); p.add_argument("--client", default=""); p.add_argument("--kind", default="other"); p.add_argument("--note", default="")
    p.add_argument("--booking")
    p = sub.add_parser("book"); p.add_argument("--client", required=True); p.add_argument("--what", default="Tattoo"); p.add_argument("--when", required=True); p.add_argument("--price", type=float, default=0); p.add_argument("--deposit", type=float, default=0)
    p = sub.add_parser("book-gui"); p.add_argument("--client", default=""); p.add_argument("--what", default=""); p.add_argument("--when", default="")
    p = sub.add_parser("bookings"); p.add_argument("range", nargs="?", default="week", choices=["today", "week", "all"])
    for c in ("done", "cancel", "deposit-paid"):
        p = sub.add_parser(c); p.add_argument("id", help="booking id, or the client's name (their latest open booking)")
    p = sub.add_parser("consent"); p.add_argument("--client", default=""); p.add_argument("--what", default=""); p.add_argument("--step", default="who", choices=["who", "statements", "sign"]); p.add_argument("--shot")
    p = sub.add_parser("consent-pdf")
    for a in ("--client", "--dob", "--phone", "--address", "--design", "--placement"):
        p.add_argument(a, default="")
    p.add_argument("--email", default=""); p.add_argument("--signature", help="JSON [[ [x,y], ... ], ...] in 0..1"); p.add_argument("--photos", action="store_true"); p.add_argument("out")
    p = sub.add_parser("aftercare"); p.add_argument("how", nargs="?", default="show", choices=["show", "print", "pdf"]); p.add_argument("out", nargs="?")
    sub.add_parser("review"); sub.add_parser("booklink")
    p = sub.add_parser("money"); p.add_argument("range", nargs="?", default="today", choices=["today", "week", "month", "year"])
    p = sub.add_parser("export"); p.add_argument("year", nargs="?", type=int)
    p = sub.add_parser("feed"); p.add_argument("--json", action="store_true")
    p = sub.add_parser("paylink"); p.add_argument("method", choices=METHODS); p.add_argument("amount"); p.add_argument("note", nargs="?", default="")
    sub.add_parser("brief"); sub.add_parser("settings")
    p = sub.add_parser("set"); p.add_argument("key"); p.add_argument("value")
    p = sub.add_parser("get"); p.add_argument("key")
    a = ap.parse_args(argv)
    cmd = a.cmd or "gui"

    if cmd == "gui":
        App(page=a.page, shot=a.shot, quit_after=a.quit_after, fullscreen=a.fullscreen); _main_loop(); return 0
    if cmd == "pay":
        pre = {"amount": a.amount, "kind": a.kind, "client": a.client} if a.amount else {}
        App(page="pay", prefill=pre, shot=a.shot, quit_after=a.quit_after); _main_loop(); return 0
    if cmd == "paid":
        e = record_payment(a.amount, a.method, a.client, a.kind, a.note, booking=a.booking)
        print(f"{e['id']}  {e['when']}  {money(e['amount'])}  {METHOD_TITLES.get(a.method, a.method)}  {e['kind']}  {e['client']}"); return 0
    if cmd == "book":
        b = add_booking(a.client, a.what, parse_when(a.when), a.price, a.deposit)
        print(fmt_booking(b)); return 0
    if cmd == "book-gui":
        App(page="book", prefill={"client": a.client, "what": a.what, "when": a.when}); _main_loop(); return 0
    if cmd == "bookings":
        ref = now()
        for b in sorted(bookings(), key=booking_dt):
            d = booking_dt(b).date()
            if a.range == "today" and d != ref.date():
                continue
            if a.range == "week" and not (ref.date() <= d <= ref.date() + dt.timedelta(days=7)):
                continue
            if a.range != "all" and b["status"] != "booked":
                continue
            print(fmt_booking(b))
        return 0
    if cmd in ("done", "cancel", "deposit-paid"):
        b = update_booking(a.id, **({"status": "done"} if cmd == "done" else {"status": "cancelled"} if cmd == "cancel" else {"deposit_paid": True}))
        if not b:
            print("no such booking", file=sys.stderr); return 1
        print(fmt_booking(b)); return 0
    if cmd == "consent":
        App(page="papers", prefill={"consent": True, "client": a.client, "what": a.what, "step": a.step}, shot=a.shot); _main_loop(); return 0
    if cmd == "consent-pdf":
        strokes = json.load(open(a.signature)) if a.signature else []
        print(consent_pdf(a.out, a.client, a.dob, a.phone, a.address, a.design, a.placement, strokes, photos=a.photos, email=a.email)); return 0
    if cmd == "aftercare":
        out = a.out or os.path.join(BUSINESS, "Aftercare.pdf")
        aftercare_pdf(out)
        if a.how == "print":
            ok, msg = print_file(out); print(msg or ("printed" if ok else "could not print")); return 0 if ok else 1
        if a.how == "show":
            spawn(["xdg-open", out])
        print(out); return 0
    if cmd in ("review", "booklink"):
        App(page="qr", prefill={"which": "review" if cmd == "review" else "booking"}); _main_loop(); return 0
    if cmd == "money":
        t = totals()
        print(money(t[a.range]))
        if a.range == "today":
            print(f"{t['count_today']} payments today · week {money(t['week'])} · month {money(t['month'])} · year {money(t['year'])}")
        return 0
    if cmd == "export":
        print(export_csv(a.year)); return 0
    if cmd == "feed":
        cards = build_feed()
        if a.json:
            print(json.dumps(cards, indent=1))
        else:
            for c in cards:
                print(f"[{c['kicker']}] {c['title']}  {c['big']}  — {c['sub']}\n    → {c['primary']['label']}" + ("  | " + " · ".join(x["label"] for x in c["actions"]) if c["actions"] else ""))
        return 0
    if cmd == "paylink":
        link = pay_link(a.method, a.amount, a.note)
        if not link:
            print(f"{a.method} is not set up (flattoo-till set {a.method} HANDLE)", file=sys.stderr); return 1
        print(link); return 0
    if cmd == "brief":
        text = brief_text()
        print(text)
        if (os.environ.get("DBUS_SESSION_BUS_ADDRESS") or os.environ.get("DISPLAY")) and shutil.which("notify-send"):  # the user timer has the session bus
            run(["notify-send", "-a", "Money", "-i", "flattoo-till", "Today at the shop", text])
        return 0
    if cmd == "settings":
        App(page="settings"); _main_loop(); return 0
    if cmd == "set":
        set_setting(a.key, a.value); print(f"{a.key} = {a.value}"); return 0
    if cmd == "get":
        s = settings()
        print(s["pay"].get(a.key, "") if a.key in METHODS else s.get(a.key, "")); return 0
    ap.print_help()
    return 2


def _main_loop():
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk
    Gtk.main()


if __name__ == "__main__":
    sys.exit(main())
