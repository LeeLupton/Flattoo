#!/usr/bin/env python3
"""Money: the part of the laptop that gets the artist paid.

One screen, one thumb. The feed is a stack of cards — the next client, a
deposit that is still owed, today's take, a client who is due to rebook —
and every card has one big button. Swipe up for the next card, like a
phone. The tabs at the bottom are the four things that make money happen:

  Feed       what is next and what is owed
  Get paid   a number pad, then a QR code the client scans (Venmo, Cash App,
             PayPal, Square, Zelle), then one tap records it
  Book       client, what, when, price, deposit — six taps
  Papers     the consent form (signed with a finger, saved as PDF, kept two
             years) and the aftercare sheet to print or show
  Money      today / week / month / year, every payment, export for taxes

Nothing leaves the laptop. The QR code is a link into the artist's own
payment app on the client's phone; the laptop never talks to Venmo or
anyone else. A payment is recorded because the artist tapped "Paid", not
because an API said so. Bookings, payments and clients live in
~/.local/share/flattoo/till/ (JSON); what the artist keeps — consent forms,
the ledger for the accountant — is written to ~/Documents/Business/.

  flattoo-till [gui]                       the app (menu entry "Money")
  flattoo-till pay AMOUNT [--client N] [--kind deposit|balance|tip|flash|other] [--note T]
  flattoo-till paid AMOUNT --method M [--client N] [--kind K] [--note T]
  flattoo-till book --client N --what W --when "tomorrow 2pm" [--price P] [--deposit D]
  flattoo-till book-gui [--client N] [--what W] [--when T]
  flattoo-till bookings [today|week|all]      done ID | cancel ID | deposit-paid ID
  flattoo-till consent [--client N]           the signing flow
  flattoo-till consent-pdf --client N --dob YYYY-MM-DD --phone P --address A \
               --design D --placement PL --signature strokes.json [--photos] OUT.pdf
  flattoo-till aftercare show|print|pdf [OUT]
  flattoo-till review | booklink              the QR card for the client
  flattoo-till money [today|week|month|year]  totals;  export [YEAR]  the CSV
  flattoo-till feed --json                    the cards, as the feed would show them
  flattoo-till paylink METHOD AMOUNT [NOTE]   the link a QR encodes
  flattoo-till brief                          one notification: today's clients, deposits owed
  flattoo-till settings | set KEY VALUE | get KEY
"""

import argparse
import csv
import datetime as dt
import io
import json
import os
import re
import shutil
import subprocess
import sys
import urllib.parse
import uuid

HOME = os.path.expanduser("~")
DATA_DIR = os.environ.get("FLATTOO_TILL_DATA") or os.path.join(
    os.environ.get("XDG_DATA_HOME", os.path.join(HOME, ".local", "share")), "flattoo", "till")
CFG_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config")), "flattoo")
USER_SETTINGS = os.path.join(CFG_DIR, "till.json")
SYSTEM_SETTINGS = os.environ.get("FLATTOO_TILL_SYSTEM_SETTINGS", "/etc/flattoo/till.json")
PROFILE = os.path.join(CFG_DIR, "profile.json")
PALETTE = os.path.join(CFG_DIR, "palette.json")
BUSINESS = os.environ.get("FLATTOO_TILL_DOCS") or os.path.join(HOME, "Documents", "Business")
SHARE = "@share@"  # …/share/flattoo/till (aftercare text)

METHODS = ("venmo", "cashapp", "paypal", "square", "zelle")
METHOD_TITLES = {"venmo": "Venmo", "cashapp": "Cash App", "paypal": "PayPal", "square": "Square", "zelle": "Zelle", "cash": "Cash", "card": "Card"}
KINDS = ("deposit", "balance", "tip", "flash", "other")
KIND_TITLES = {"deposit": "Deposit", "balance": "Balance", "tip": "Tip", "flash": "Flash", "other": "Other"}
DEFAULTS = {
    "currency": "$",
    "pay": {m: "" for m in METHODS},
    "review_link": "",
    "booking_link": "",
    "default_deposit": 50,
    "rebook_after_days": 28,
    "printer": "",
    "hours": ["10:00", "19:30"],
}
WEEKDAYS = ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]


# ------------------------------------------------------------------ small helpers

def run(cmd, **kw):
    try:
        return subprocess.run(cmd, text=True, capture_output=True, **kw)
    except OSError as e:
        return subprocess.CompletedProcess(cmd, 127, "", str(e))


def spawn(cmd):
    try:
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        return True
    except OSError:
        return False


def now():
    t = os.environ.get("FLATTOO_TILL_NOW")  # tests pin the clock
    return dt.datetime.fromisoformat(t) if t else dt.datetime.now()


def money(amount, cur=None):
    cur = cur if cur is not None else settings()["currency"]
    a = float(amount)
    s = f"{a:,.0f}" if a == int(a) else f"{a:,.2f}"
    return f"{cur}{s}"


def load_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def save_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=1, ensure_ascii=False)
    os.replace(tmp, path)


def safe_name(s):
    return re.sub(r"[^A-Za-z0-9 _.-]+", "", s).strip()[:60] or "client"


# ------------------------------------------------------------------ settings and profile

def settings():
    s = json.loads(json.dumps(DEFAULTS))
    for path in (SYSTEM_SETTINGS, USER_SETTINGS):
        d = load_json(path, {})
        for k, v in d.items():
            if k == "pay" and isinstance(v, dict):
                s["pay"].update({m: str(v.get(m, s["pay"].get(m, ""))) for m in METHODS})
            elif k in s:
                s[k] = v
    return s


def set_setting(key, value):
    d = load_json(USER_SETTINGS, {})
    if key in METHODS:
        d.setdefault("pay", {})[key] = value
    elif key in ("default_deposit", "rebook_after_days"):
        try:
            d[key] = int(value)
        except ValueError:
            raise SystemExit(f"{key} has to be a whole number, not {value!r}") from None
    elif key in DEFAULTS:
        d[key] = value
    else:
        raise SystemExit(f"unknown setting {key}; one of: {', '.join(list(METHODS) + [k for k in DEFAULTS if k != 'pay'])}")
    save_json(USER_SETTINGS, d)


def profile():
    p = load_json(PROFILE, {})
    return {"name": p.get("name", ""), "studio": p.get("studio", ""), "city": p.get("city", ""),
            "links": p.get("links", {}) or {}}


def configured_methods(s=None):
    s = s or settings()
    return [m for m in METHODS if s["pay"].get(m)]


def pay_link(method, amount, note="", s=None):
    """The URL a payment QR encodes. Venmo, Cash App and PayPal take the amount
    in the link; Square is a fixed checkout link; Zelle has no link — the QR
    carries the phone number or e-mail as text for the client to copy."""
    s = s or settings()
    handle = s["pay"].get(method, "").strip()
    if not handle:
        return None
    amt = f"{float(amount):.2f}".rstrip("0").rstrip(".") if amount else ""
    if method == "venmo":
        user = handle.lstrip("@")
        q = {"txn": "pay"}
        if amt:
            q["amount"] = amt
        if note:
            q["note"] = note[:60]
        return f"https://venmo.com/{urllib.parse.quote(user)}?{urllib.parse.urlencode(q)}"
    if method == "cashapp":
        tag = handle.lstrip("$")
        return f"https://cash.app/${urllib.parse.quote(tag)}" + (f"/{amt}" if amt else "")
    if method == "paypal":
        user = handle.split("paypal.me/")[-1].strip("/")
        return f"https://paypal.me/{urllib.parse.quote(user)}" + (f"/{amt}USD" if amt else "")
    if method == "square":
        return handle if handle.startswith("http") else "https://" + handle
    if method == "zelle":
        return handle
    return None


# ------------------------------------------------------------------ the store

def _path(name):
    return os.path.join(DATA_DIR, name + ".json")


def bookings():
    return load_json(_path("bookings"), [])


def ledger():
    return load_json(_path("ledger"), [])


def clients():
    return load_json(_path("clients"), {})


def touch_client(name, **fields):
    if not name:
        return
    cs = clients()
    c = cs.setdefault(name, {"visits": 0, "consents": []})
    for k, v in fields.items():
        if v:
            c[k] = v
    save_json(_path("clients"), cs)


def parse_when(text, ref=None):
    """'2026-11-15 14:00', 'tomorrow 2pm', 'friday at 11:30', 'today 3' -> datetime."""
    ref = ref or now()
    t = text.strip().lower().replace(" at ", " ")
    try:
        return dt.datetime.fromisoformat(t.replace("t", "T") if "t" in t and "-" in t else t)
    except ValueError:
        pass
    day = ref.date()
    if "tomorrow" in t:
        day = day + dt.timedelta(days=1)
    elif "today" in t:
        pass
    else:
        for i, w in enumerate(WEEKDAYS):
            if w in t or w[:3] in t.split():
                ahead = (i - day.weekday()) % 7
                day = day + dt.timedelta(days=ahead or 7)
                break
        m = re.search(r"\b(\d{4})-(\d{2})-(\d{2})\b", t)
        if m:
            day = dt.date(int(m.group(1)), int(m.group(2)), int(m.group(3)))
    m = re.search(r"\b(\d{1,2})(?::(\d{2}))?\s*(am|pm)?\b", re.sub(r"\d{4}-\d{2}-\d{2}", "", t))
    if not m:
        raise ValueError(f"no time in {text!r}")
    h, mi, ap = int(m.group(1)), int(m.group(2) or 0), m.group(3)
    if ap == "pm" and h < 12:
        h += 12
    if ap == "am" and h == 12:
        h = 0
    if not ap and 1 <= h <= 7:  # "today 3" in a tattoo shop is 3 pm
        h += 12
    if not (0 <= h < 24 and 0 <= mi < 60):
        raise ValueError(f"bad time in {text!r}")
    return dt.datetime.combine(day, dt.time(h, mi))


def add_booking(client, what, when, price=0, deposit=0, notes=""):
    b = {"id": uuid.uuid4().hex[:8], "client": client.strip(), "what": what.strip(), "when": when.strftime("%Y-%m-%d %H:%M"),
         "price": float(price or 0), "deposit": float(deposit or 0), "deposit_paid": False, "status": "booked",
         "notes": notes, "created": now().strftime("%Y-%m-%d %H:%M")}
    bs = bookings()
    bs.append(b)
    save_json(_path("bookings"), bs)
    touch_client(b["client"])
    return b


def update_booking(bid, **fields):
    """By id (or a prefix), or by client name: the client's latest booking that is still open."""
    bs = bookings()
    hit = next((b for b in bs if b["id"] == bid or b["id"].startswith(bid)), None)
    if hit is None:
        mine = [b for b in bs if b["client"].lower() == bid.strip().lower() and b["status"] == "booked"]
        hit = max(mine, key=booking_dt) if mine else None
    if hit is None:
        return None
    hit.update(fields)
    save_json(_path("bookings"), bs)
    return hit


def booking_dt(b):
    return dt.datetime.strptime(b["when"], "%Y-%m-%d %H:%M")


def paid_so_far(b, lg=None):
    lg = lg if lg is not None else ledger()
    return sum(e["amount"] for e in lg if e.get("booking") == b["id"] and e.get("kind") != "tip")


def record_payment(amount, method, client="", kind="other", note="", booking=None, when=None):
    e = {"id": uuid.uuid4().hex[:8], "when": (when or now()).strftime("%Y-%m-%d %H:%M"), "amount": round(float(amount), 2),
         "method": method, "client": client.strip(), "kind": kind if kind in KINDS else "other", "note": note.strip(), "booking": booking}
    lg = ledger()
    lg.append(e)
    save_json(_path("ledger"), lg)
    if booking and kind == "deposit":
        update_booking(booking, deposit_paid=True)
    if client:
        touch_client(client)
    export_csv(int(e["when"][:4]), lg)  # the accountant's file is always current
    return e


def totals(lg=None, ref=None):
    lg = lg if lg is not None else ledger()
    ref = ref or now()
    today = ref.date()
    week_start = today - dt.timedelta(days=today.weekday())
    out = {"today": 0.0, "week": 0.0, "month": 0.0, "year": 0.0, "count_today": 0}
    for e in lg:
        d = dt.datetime.strptime(e["when"], "%Y-%m-%d %H:%M").date()
        if d.year == today.year:
            out["year"] += e["amount"]
            if d.month == today.month:
                out["month"] += e["amount"]
        if week_start <= d <= today:
            out["week"] += e["amount"]
        if d == today:
            out["today"] += e["amount"]
            out["count_today"] += 1
    return out


def export_csv(year=None, lg=None):
    lg = lg if lg is not None else ledger()
    year = year or now().year
    os.makedirs(os.path.join(BUSINESS, "Money"), exist_ok=True)
    path = os.path.join(BUSINESS, "Money", f"ledger-{year}.csv")
    rows = [e for e in lg if e["when"].startswith(str(year))]
    with open(path, "w", newline="") as f:
        w = csv.writer(f)
        w.writerow(["date", "time", "amount", "method", "kind", "client", "note"])
        for e in sorted(rows, key=lambda e: e["when"]):
            d, t = e["when"].split(" ")
            w.writerow([d, t, f"{e['amount']:.2f}", METHOD_TITLES.get(e["method"], e["method"]), KIND_TITLES.get(e["kind"], e["kind"]), e["client"], e["note"]])
        w.writerow([])
        w.writerow(["total", "", f"{sum(e['amount'] for e in rows):.2f}", "", "", "", f"{len(rows)} payments"])
    return path


# ------------------------------------------------------------------ the feed

def build_feed(ref=None, s=None):
    """The cards, top to bottom. Pure data: the GUI draws them, `feed --json`
    prints them, the morning brief reads the first ones."""
    ref = ref or now()
    s = s or settings()
    cur = s["currency"]
    bs = bookings()
    lg = ledger()
    cards = []
    today = ref.date()
    live = [b for b in bs if b["status"] == "booked"]
    todays = sorted([b for b in live if booking_dt(b).date() == today], key=booking_dt)
    upcoming = sorted([b for b in live if booking_dt(b).date() > today], key=booking_dt)
    methods = configured_methods(s)

    def booking_card(b, kicker):
        paid = paid_so_far(b, lg)
        owed = max(b["price"] - paid, 0)
        bits = [booking_dt(b).strftime("%-I:%M %p") if booking_dt(b).date() == today else booking_dt(b).strftime("%a %b %-d, %-I:%M %p")]
        if b["price"]:
            bits.append(f"{money(b['price'], cur)}" + (f" · {money(paid, cur)} paid" if paid else ""))
        if b["deposit"] and not b["deposit_paid"]:
            bits.append(f"deposit {money(b['deposit'], cur)} owed")
        acts = [{"label": "Consent form", "do": "consent", "client": b["client"], "what": b["what"]},
                {"label": "Print stencil", "do": "stencil"}]
        if b["deposit"] and not b["deposit_paid"]:
            primary = {"label": f"Get deposit {money(b['deposit'], cur)}", "do": "pay", "amount": b["deposit"], "kind": "deposit", "client": b["client"], "booking": b["id"]}
        elif owed > 0:
            primary = {"label": f"Get paid {money(owed, cur)}", "do": "pay", "amount": owed, "kind": "balance", "client": b["client"], "booking": b["id"]}
        else:
            primary = {"label": "Get paid", "do": "pay", "kind": "balance", "client": b["client"], "booking": b["id"]}
        acts.append({"label": "Done ✓", "do": "done", "booking": b["id"]})
        return {"id": "booking:" + b["id"], "kind": "booking", "kicker": kicker, "title": b["client"], "big": b["what"],
                "sub": " · ".join(bits), "primary": primary, "actions": acts}

    if todays:
        for i, b in enumerate(todays):
            cards.append(booking_card(b, "Next up" if i == 0 else f"Later today · {len(todays) - i} more"))
    else:
        cards.append({"id": "empty-today", "kind": "empty", "kicker": "Today", "title": "Nothing booked today",
                      "big": "", "sub": "A walk-in? Book them in six taps, then take the deposit.",
                      "primary": {"label": "Book a client", "do": "book"}, "actions": [{"label": "Get paid", "do": "pay"}]})
    for b in upcoming:
        if b["deposit"] and not b["deposit_paid"]:
            cards.append({"id": "deposit:" + b["id"], "kind": "deposit", "kicker": "Deposit owed", "title": b["client"],
                          "big": money(b["deposit"], cur), "sub": f"{b['what']} · {booking_dt(b).strftime('%a %b %-d, %-I:%M %p')} · no deposit yet, the slot is not reserved",
                          "primary": {"label": "Show the pay code", "do": "pay", "amount": b["deposit"], "kind": "deposit", "client": b["client"], "booking": b["id"]},
                          "actions": [{"label": "Cancel booking", "do": "cancel", "booking": b["id"]}]})
    t = totals(lg, ref)
    cards.append({"id": "money", "kind": "money", "kicker": "Today", "title": f"{t['count_today']} payment{'s' if t['count_today'] != 1 else ''}",
                  "big": money(t["today"], cur), "sub": f"this week {money(t['week'], cur)} · this month {money(t['month'], cur)} · this year {money(t['year'], cur)}",
                  "primary": {"label": "Get paid", "do": "pay"}, "actions": [{"label": "Every payment", "do": "money"}, {"label": "Export for taxes", "do": "export"}]})
    for b in upcoming[:3]:
        cards.append(booking_card(b, "Coming up"))
    # rebook: finished clients with nothing booked, a month on
    done = [b for b in bs if b["status"] == "done"]
    booked_clients = {b["client"] for b in live}
    last_by_client = {}
    for b in sorted(done, key=booking_dt):
        last_by_client[b["client"]] = b
    for name, b in sorted(last_by_client.items(), key=lambda kv: booking_dt(kv[1])):
        days = (today - booking_dt(b).date()).days
        if name not in booked_clients and days >= int(s.get("rebook_after_days", 28)):
            cards.append({"id": "rebook:" + b["id"], "kind": "rebook", "kicker": "Due to rebook", "title": name,
                          "big": f"{days} days", "sub": f"since {b['what']} · nothing booked next. Healed by now — the next session or a touch-up.",
                          "primary": {"label": f"Book {name.split()[0]}", "do": "book", "client": name},
                          "actions": [{"label": "Not now", "do": "dismiss", "booking": b["id"]}]})
            if len([c for c in cards if c["kind"] == "rebook"]) >= 3:
                break
    if s.get("review_link"):
        cards.append({"id": "review", "kind": "qr", "kicker": "After the session", "title": "Leave a review", "big": "",
                      "sub": "Turn the laptop round: the client scans and the review is a tap away while the chair is still warm.",
                      "primary": {"label": "Show the review code", "do": "qr", "which": "review"}, "actions": []})
    if s.get("booking_link") or profile()["links"].get("booking"):
        cards.append({"id": "booklink", "kind": "qr", "kicker": "Before they leave", "title": "Book the next one", "big": "",
                      "sub": "The booking page as a code the client keeps on their phone.",
                      "primary": {"label": "Show the booking code", "do": "qr", "which": "booking"}, "actions": []})
    cards.append({"id": "aftercare", "kind": "paper", "kicker": "Papers", "title": "Aftercare sheet", "big": "",
                  "sub": "Print one for every client who walks out, or show it on the screen.",
                  "primary": {"label": "Print aftercare", "do": "aftercare", "how": "print"}, "actions": [{"label": "Show on screen", "do": "aftercare", "how": "show"}]})
    if not methods:
        cards.insert(1 if todays else 0, {"id": "setup-pay", "kind": "setup", "kicker": "One-time setup", "title": "How do you get paid?",
                     "big": "", "sub": "Add your Venmo, Cash App, PayPal, Square or Zelle once; from then on clients scan a code with the amount filled in.",
                     "primary": {"label": "Set up payments", "do": "settings"}, "actions": []})
    return cards


def brief_text(ref=None):
    ref = ref or now()
    cards = build_feed(ref)
    todays = [c for c in cards if c["kind"] == "booking" and c["kicker"].startswith(("Next up", "Later today"))]
    owed = [c for c in cards if c["kind"] == "deposit"]
    lines = []
    if todays:
        lines.append(f"{len(todays)} client{'s' if len(todays) != 1 else ''} today: " + ", ".join(f"{c['title']} {c['sub'].split(' · ')[0]}" for c in todays))
    else:
        lines.append("Nothing booked today.")
    if owed:
        lines.append(f"{len(owed)} deposit{'s' if len(owed) != 1 else ''} owed: " + ", ".join(f"{c['title']} {c['big']}" for c in owed))
    rebook = [c for c in cards if c["kind"] == "rebook"]
    if rebook:
        lines.append("Due to rebook: " + ", ".join(c["title"] for c in rebook))
    return "\n".join(lines)


# ------------------------------------------------------------------ QR codes

def qr_png(text, box=12):
    import qrcode
    q = qrcode.QRCode(error_correction=qrcode.constants.ERROR_CORRECT_M, box_size=box, border=2)
    q.add_data(text)
    q.make(fit=True)
    img = q.make_image(fill_color="black", back_color="white")
    buf = io.BytesIO()
    img.get_image().save(buf, format="PNG") if hasattr(img, "get_image") else img.save(buf, format="PNG")
    return buf.getvalue()


# ------------------------------------------------------------------ PDFs: consent and aftercare

def aftercare_text():
    try:
        with open(os.path.join(SHARE, "aftercare.txt")) as f:
            return f.read()
    except OSError:
        return AFTERCARE_FALLBACK


AFTERCARE_FALLBACK = """Aftercare
Keep the wrap on for the time your artist told you, then wash gently with lukewarm water and unscented soap. Pat dry. Thin layer of the ointment you were given, two or three times a day, for the first days; then an unscented lotion.
No soaking (baths, pools, the ocean) and no sun on it for two to three weeks. Don't pick or scratch; it will flake and itch, that is normal.
Clean hands before you touch it. Loose clothes over it. If it gets hot, swollen, oozes or you run a fever, call us and see a doctor.
"""


def _pdf_text(cr, pango, x, y, w, text, size=11, bold=False, color=(0, 0, 0)):
    from gi.repository import PangoCairo
    layout = PangoCairo.create_layout(cr)
    fd = pango.FontDescription(f"{'Sans Bold' if bold else 'Sans'} {size}")
    layout.set_font_description(fd)
    layout.set_width(int(w * pango.SCALE))
    layout.set_wrap(pango.WrapMode.WORD_CHAR)
    layout.set_text(text, -1)
    cr.set_source_rgb(*color)
    cr.move_to(x, y)
    PangoCairo.show_layout(cr, layout)
    _, lh = layout.get_pixel_size()
    return y + lh


def _pdf_begin(out):
    import cairo
    import gi
    gi.require_version("Pango", "1.0")
    gi.require_version("PangoCairo", "1.0")
    from gi.repository import Pango
    os.makedirs(os.path.dirname(os.path.abspath(out)), exist_ok=True)
    surf = cairo.PDFSurface(out, 612, 792)  # US Letter, points
    return surf, cairo.Context(surf), Pango


CONSENT_STATEMENTS = [
    ("adult", "I am 18 or older and have shown valid photo ID."),
    ("sober", "I am not under the influence of alcohol or drugs."),
    ("health", "I have told the artist about any medical condition, allergy, medication, pregnancy, or skin condition that could matter. The skin at the site is healthy — no rash, sunburn, infection or open wound."),
    ("permanent", "I understand a tattoo is permanent, that removal is costly and may not be complete, and that the final result can vary with my skin and healing."),
    ("design", "I have reviewed the design, its size, spelling and placement, and I approve it as drawn."),
    ("aftercare", "I have received aftercare instructions and will follow them; healing is my responsibility once I leave."),
    ("risk", "I accept the risks that come with tattooing — infection, allergic reaction, scarring — when the studio's sterile procedures are followed, and I release the artist and studio from claims arising from my own failure to follow aftercare or to disclose a condition."),
]
PHOTO_STATEMENT = "The artist may photograph the finished tattoo and use the photo (no face, no name) in their portfolio and social media."


def consent_pdf(out, client, dob, phone, address, design, placement, strokes, photos=False, artist=None, studio=None, when=None, email=""):
    """One page: who, what, the statements, the finger signature as vector
    strokes, the artist's line. `strokes` is [[(x, y), ...], ...] in 0..1."""
    surf, cr, Pango = _pdf_begin(out)
    when = when or now()
    p = profile()
    artist = artist or p["name"] or "Artist"
    studio = studio or p["studio"] or "Studio"
    m, w = 54, 612 - 108
    y = 54
    cr.set_source_rgb(0, 0, 0)
    y = _pdf_text(cr, Pango, m, y, w, studio, 18, bold=True)
    y = _pdf_text(cr, Pango, m, y + 2, w, f"Tattoo consent and client record · {when.strftime('%B %-d, %Y')}", 10, color=(0.35, 0.35, 0.35))
    y += 10
    cr.set_line_width(0.8)
    cr.move_to(m, y); cr.line_to(612 - m, y); cr.stroke()
    y += 12
    try:
        age = (when.date() - dt.date.fromisoformat(dob)).days // 365
        age_s = f"{dob} (age {age})"
    except ValueError:
        age_s = dob
    rows = [("Client", client), ("Date of birth", age_s), ("Phone", phone), ("Address", address)]
    if email:
        rows.append(("E-mail", email))
    rows += [("Tattoo", design), ("Placement", placement), ("Artist", artist)]
    for k, v in rows:
        _pdf_text(cr, Pango, m, y, 120, k, 10, bold=True, color=(0.3, 0.3, 0.3))
        y = _pdf_text(cr, Pango, m + 124, y, w - 124, v or "—", 11) + 4
    y += 8
    for key, text in CONSENT_STATEMENTS:
        cr.rectangle(m, y + 2, 9, 9); cr.set_source_rgb(0, 0, 0); cr.set_line_width(0.8); cr.stroke()
        cr.move_to(m + 1.5, y + 7); cr.line_to(m + 4, y + 9.5); cr.line_to(m + 8, y + 3); cr.set_line_width(1.4); cr.stroke()
        y = _pdf_text(cr, Pango, m + 16, y, w - 16, text, 9.5) + 5
    cr.rectangle(m, y + 2, 9, 9); cr.set_line_width(0.8); cr.stroke()
    if photos:
        cr.move_to(m + 1.5, y + 7); cr.line_to(m + 4, y + 9.5); cr.line_to(m + 8, y + 3); cr.set_line_width(1.4); cr.stroke()
    y = _pdf_text(cr, Pango, m + 16, y, w - 16, PHOTO_STATEMENT + ("" if photos else "  (not granted)"), 9.5) + 14
    # signature box
    bw, bh = 300, 110
    bx, by = m, y + 12
    cr.set_source_rgb(0.75, 0.75, 0.75); cr.set_line_width(0.6)
    cr.rectangle(bx, by, bw, bh); cr.stroke()
    cr.set_source_rgb(0.05, 0.05, 0.25); cr.set_line_width(1.6)
    cr.set_line_cap(1); cr.set_line_join(1)  # round
    for stroke in strokes or []:
        pts = [(bx + 6 + float(px) * (bw - 12), by + 6 + float(py) * (bh - 12)) for px, py in stroke]
        if len(pts) == 1:
            cr.arc(pts[0][0], pts[0][1], 0.9, 0, 6.3); cr.fill()
            continue
        cr.move_to(*pts[0])
        for pt in pts[1:]:
            cr.line_to(*pt)
        cr.stroke()
    _pdf_text(cr, Pango, bx, by + bh + 4, bw, f"Client signature · {when.strftime('%Y-%m-%d %H:%M')}", 8.5, color=(0.35, 0.35, 0.35))
    ax = bx + bw + 24
    cr.set_source_rgb(0.75, 0.75, 0.75); cr.set_line_width(0.6)
    cr.move_to(ax, by + bh - 20); cr.line_to(612 - m, by + bh - 20); cr.stroke()
    _pdf_text(cr, Pango, ax, by + bh - 16, 612 - m - ax, f"Artist · {artist}", 8.5, color=(0.35, 0.35, 0.35))
    _pdf_text(cr, Pango, m, 792 - 54, w, "Studio record. Kept on file for at least two years and available to the health department on request.", 8, color=(0.45, 0.45, 0.45))
    cr.show_page()
    surf.finish()
    return out


def save_consent(client, dob, phone, address, design, placement, strokes, photos=False, email=""):
    d = os.path.join(BUSINESS, "Consent")
    os.makedirs(d, exist_ok=True)
    stamp = now().strftime("%Y-%m-%d %H%M")
    out = os.path.join(d, f"{stamp} {safe_name(client)}.pdf")
    consent_pdf(out, client, dob, phone, address, design, placement, strokes, photos=photos, email=email)
    cs = clients()
    c = cs.setdefault(client, {"visits": 0, "consents": []})
    c.update({"phone": phone, "dob": dob, "address": address, "visits": c.get("visits", 0) + 1, "last_seen": stamp[:10], "photos_ok": bool(photos)})
    c.setdefault("consents", []).append(out)
    save_json(_path("clients"), cs)
    return out


def aftercare_pdf(out):
    surf, cr, Pango = _pdf_begin(out)
    p = profile()
    m, w = 54, 612 - 108
    y = 60
    y = _pdf_text(cr, Pango, m, y, w, p["studio"] or "Aftercare", 24, bold=True)
    sub = " · ".join(x for x in (p["name"], p["city"], p["links"].get("instagram", ""), p["links"].get("website", "")) if x)
    if sub:
        y = _pdf_text(cr, Pango, m, y + 2, w, sub, 11, color=(0.35, 0.35, 0.35))
    y += 14
    cr.set_source_rgb(0, 0, 0); cr.set_line_width(1); cr.move_to(m, y); cr.line_to(612 - m, y); cr.stroke()
    y += 18
    for para in aftercare_text().strip().split("\n"):
        if not para.strip():
            y += 8
            continue
        head = para.strip() == para.strip().split(" ")[0] and len(para.strip()) < 30
        y = _pdf_text(cr, Pango, m, y, w, para.strip(), 15 if head else 12.5, bold=head) + (6 if head else 10)
    cr.show_page()
    surf.finish()
    return out


def print_file(path, printer=None):
    printer = printer or settings().get("printer") or ""
    if not shutil.which("lp"):
        return False, "No printing on this system (lp is missing)."
    cmd = ["lp"] + (["-d", printer] if printer else []) + [path]
    r = run(cmd)
    return r.returncode == 0, (r.stdout + r.stderr).strip()


