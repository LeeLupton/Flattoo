#!/usr/bin/env bash
# Map pen tablets to the right screen on X11.
#
#   flattoo-tablet-map          map every pen device now
#   flattoo-tablet-map --watch  keep doing it as devices and monitors come and go
#
# Rule: a display tablet (Cintiq, Kamvas, Artist, "Pro 1x", Pen Display…)
# maps to the external output when one is connected, so the pen lands where
# the hand is. Everything else maps to the primary output, which keeps the
# tablet's aspect ratio honest instead of stretching across two screens.
# Works with the wacom and libinput X drivers alike (map-to-output sets the
# Coordinate Transformation Matrix).
set -uo pipefail

DISPLAY_KEYWORDS='cintiq|kamvas|pen display|artist|pro 1[0-9]|pro 2[0-9]|one by wacom|dtk|dth|pd1|pd2'
PEN_KEYWORDS='pen|stylus|eraser|tablet'
EXCLUDE='virtual core|keyboard|pad$|touch$|finger|mouse|xtest|consumer control|system control'

outputs() {
  xrandr --query 2>/dev/null | awk '/ connected/ {print $1, ($3=="primary")?"primary":"-"}'
}

choose_output() { # choose_output "<device name>"
  local name primary external
  name="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  primary="$(outputs | awk '$2=="primary" {print $1; exit}')"
  [ -n "$primary" ] || primary="$(outputs | awk 'NR==1 {print $1}')"
  external="$(outputs | awk -v p="$primary" '$1!=p {print $1; exit}')"
  if [ -n "$external" ] && printf '%s' "$name" | grep -Eq "$DISPLAY_KEYWORDS"; then
    printf '%s' "$external"
  else
    printf '%s' "$primary"
  fi
}

pen_devices() { # id<TAB>name for slave pointers that look like pens
  xinput list --short 2>/dev/null \
    | grep -i 'slave  *pointer' \
    | sed -E 's/^[^A-Za-z0-9]*(.*[^ ])[[:space:]]+id=([0-9]+).*/\2\t\1/' \
    | grep -Ei "$PEN_KEYWORDS" \
    | grep -Eiv "$EXCLUDE"
}

declare -A done_map
map_all() {
  local key id name out sig
  sig="$(outputs | tr '\n' ';')"
  while IFS=$'\t' read -r id name; do
    [ -n "$id" ] || continue
    out="$(choose_output "$name")"
    [ -n "$out" ] || continue
    key="$id|$name|$out|$sig"
    [ -n "${done_map[$key]:-}" ] && continue
    if xinput map-to-output "$id" "$out" 2>/dev/null; then
      echo "$(date +%T) mapped '$name' (id $id) -> $out"
      done_map[$key]=1
    fi
  done < <(pen_devices)
}

if [ "${1:-}" = "--watch" ]; then
  while true; do
    map_all
    sleep 4
  done
else
  map_all
fi
