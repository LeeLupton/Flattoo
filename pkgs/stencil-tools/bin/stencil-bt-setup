#!/usr/bin/env python3
"""Add a Bluetooth stencil printer. Menu entry: "Add Bluetooth Stencil Printer".

Scans, lets the artist pick the printer, pairs it (trying the PINs these
printers ship with before asking), finds its serial-port channel, and hands
the result to stencil-queue-setup so the Stencil queue points at
bluetooth://MAC/channel with the right PPD and stencil defaults.

Command line: stencil-bt-setup [--no-gui] [--mac AA:BB:CC:DD:EE:FF]
"""

import argparse
import os
import pty
import re
import select
import subprocess
import sys
import time

KNOWN = re.compile(r"(M0[0-9]|M08|TP8[0-9]|T08|Phomemo|QuYin|PJ-?[678][0-9]{2}|Brother|Stencil|Printer)", re.I)
PIN_GUESSES = ["0000", "1234", "default", "1111"]  # Phomemo/QuYin, generic, Brother PJ, generic


def have_gui():
    return bool(os.environ.get("DISPLAY")) and subprocess.run(["which", "zenity"], capture_output=True).returncode == 0


def zenity(*args):
    r = subprocess.run(["zenity", *args], capture_output=True, text=True)
    return r.returncode, r.stdout.strip()


def say(gui, kind, text):
    if gui:
        zenity(f"--{kind}", "--title=Bluetooth stencil printer", f"--text={text}", "--width=400")
    else:
        print(text)


def btctl(*args, timeout=30):
    return subprocess.run(["bluetoothctl", *args], capture_output=True, text=True, timeout=timeout)


def scan(seconds=12):
    btctl("power", "on")
    btctl("agent", "on")
    try:
        subprocess.run(["bluetoothctl", "--timeout", str(seconds), "scan", "on"], capture_output=True, text=True, timeout=seconds + 10)
    except subprocess.TimeoutExpired:
        pass
    devices = {}
    for line in btctl("devices").stdout.splitlines():
        m = re.match(r"Device\s+([0-9A-F:]{17})\s+(.*)", line.strip(), re.I)
        if m:
            devices[m.group(1).upper()] = m.group(2).strip()
    return devices


def pair(mac, pin_candidates, ask_pin):
    """Drive an interactive bluetoothctl on a pty. Returns (ok, message)."""
    if "Paired: yes" in btctl("info", mac).stdout:
        return True, "already paired"
    pins = list(pin_candidates)
    pid, fd = pty.fork()
    if pid == 0:
        os.execvp("bluetoothctl", ["bluetoothctl"])
    buf = b""
    def send(s):
        os.write(fd, (s + "\n").encode())
    def read_for(sec):
        nonlocal buf
        t0 = time.time()
        while time.time() - t0 < sec:
            r, _, _ = select.select([fd], [], [], 0.3)
            if r:
                try:
                    buf += os.read(fd, 4096)
                except OSError:
                    return
    try:
        read_for(1.0)
        send("agent KeyboardOnly"); read_for(0.5)
        send("default-agent"); read_for(0.5)
        send(f"pair {mac}")
        t0 = time.time()
        while time.time() - t0 < 60:
            read_for(0.5)
            text = buf.decode(errors="replace")
            if "Pairing successful" in text or "AlreadyExists" in text:
                send(f"trust {mac}"); read_for(1.0)
                send("quit")
                return True, "paired"
            if re.search(r"Failed to pair|AuthenticationFailed|AuthenticationCanceled|Connection attempt failed|Device .* not available", text):
                buf = b""
                if pins:
                    # retry pairing with the next PIN candidate
                    send(f"remove {mac}"); read_for(1.0)
                    send(f"pair {mac}")
                    continue
                send("quit")
                return False, text.strip().splitlines()[-1] if text.strip() else "pairing failed"
            if re.search(r"Enter PIN code:|PIN code:", text) and not re.search(r"\[agent\] Enter PIN code: \S", text):
                pin = pins.pop(0) if pins else ask_pin()
                if pin is None:
                    send("quit"); return False, "no PIN"
                send(pin); buf = buf.replace(b"PIN code:", b"PIN code-")
            if re.search(r"Confirm passkey .* \(yes/no\)|Request confirmation", text) and "[agent] yes" not in text:
                send("yes"); buf = buf.replace(b"(yes/no)", b"(yes-no)")
            if re.search(r"Authorize service .* \(yes/no\)", text):
                send("yes"); buf = buf.replace(b"(yes/no)", b"(yes-no)")
        send("quit")
        return False, "timed out waiting for the printer; is it in pairing mode?"
    finally:
        try:
            os.close(fd)
        except OSError:
            pass


def spp_channel(mac):
    """RFCOMM channel of the Serial Port service, from sdptool. Default 1."""
    try:
        out = subprocess.run(["sdptool", "browse", mac], capture_output=True, text=True, timeout=40).stdout
    except Exception:  # noqa: BLE001
        return 1
    channel = None
    for record in out.split("\n\n"):
        if re.search(r"Serial Port|SPP|0x1101|Printing", record, re.I):
            m = re.search(r"Channel:\s*(\d+)", record)
            if m:
                channel = int(m.group(1))
                break
    if channel is None:
        m = re.search(r"Channel:\s*(\d+)", out)
        channel = int(m.group(1)) if m else 1
    return channel


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--mac")
    ap.add_argument("--no-gui", action="store_true")
    ap.add_argument("--scan-seconds", type=int, default=12)
    args = ap.parse_args()
    gui = have_gui() and not args.no_gui

    if subprocess.run(["bluetoothctl", "list"], capture_output=True, text=True).stdout.strip() == "":
        say(gui, "error", "This laptop has no Bluetooth adapter (or it is switched off with a hardware key).")
        return 2

    mac = args.mac
    name = ""
    if not mac:
        if gui:
            zenity("--info", "--title=Bluetooth stencil printer", "--width=400", "--timeout=4",
                   "--text=Switch the printer on and put it in pairing mode (usually: hold the power button until the light blinks).\n\nScanning for 12 seconds…")
        devices = scan(args.scan_seconds)
        candidates = {m: n for m, n in devices.items() if KNOWN.search(n)}
        if not candidates:
            candidates = devices
        if not candidates:
            say(gui, "error", "No Bluetooth devices found. Make sure the printer is on and in pairing mode, then try again.")
            return 1
        if gui:
            rows = []
            for m, n in sorted(candidates.items(), key=lambda kv: kv[1]):
                rows += [m, n]
            rc, mac = zenity("--list", "--title=Bluetooth stencil printer", "--width=460", "--height=320",
                             "--text=Pick the stencil printer:", "--column=Address", "--column=Name", "--print-column=1", *rows)
            if rc != 0 or not mac:
                return 1
            mac = mac.strip()
        else:
            for m, n in candidates.items():
                print(f"{m}  {n}")
            mac = input("MAC to pair: ").strip().upper()
        name = devices.get(mac, "")
    else:
        mac = mac.upper()
        name = re.sub(r".*Name: ", "", next((l for l in btctl("info", mac).stdout.splitlines() if "Name:" in l), "")).strip()

    def ask_pin():
        if gui:
            rc, pin = zenity("--entry", "--title=Printer PIN", "--text=The printer asks for a PIN. It is in the printer's manual (often 0000, 1234 or 'default').")
            return pin.strip() if rc == 0 and pin.strip() else None
        v = input("PIN: ").strip()
        return v or None

    ok, msg = pair(mac, PIN_GUESSES, ask_pin)
    if not ok:
        say(gui, "error", f"Could not pair with {name or mac}: {msg}")
        return 1

    channel = spp_channel(mac)
    uri = f"bluetooth://{mac}/{channel}"
    r = subprocess.run(["stencil-queue-setup", "--uri", uri, "--model", name or "M08F"], capture_output=True, text=True)
    if r.returncode != 0:
        say(gui, "error", f"Paired, but setting up the print queue failed:\n{(r.stderr or r.stdout)[-400:]}")
        return 1
    # Remember the channel for the backend's discovery listing.
    try:
        d = os.path.expanduser("~/.config/flattoo")
        os.makedirs(d, exist_ok=True)
        with open(os.path.join(d, f"bt-{mac.replace(':', '')}.channel"), "w") as f:
            f.write(str(channel))
    except OSError:
        pass
    say(gui, "info", f"{name or mac} is set up as the Stencil printer over Bluetooth (channel {channel}).\n\n"
                     "Print the calibration page to check it. If the printer is also plugged in by USB, the cable is used.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
