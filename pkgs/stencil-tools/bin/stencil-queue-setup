#!/usr/bin/env bash
# Create or re-point the CUPS queue "Stencil" for whatever stencil printer is
# attached, with stencil defaults. Runs as root from the udev-triggered
# systemd unit (any USB printer appearing), 45 s after boot, and from the
# "Fix Stencil Printer" menu entry. Safe to run by hand.
#
# Recognized:
#   Brother PocketJet 7  usb://Brother/PJ-7xx   -> vendor PPD for that model
#   Brother PocketJet 8  driverless (ipp-usb or Wi-Fi) -> everywhere
#   Phomemo / QuYin      usb://<vendor>/<model> -> vendor PPD whose name is the
#                        longest prefix of the model string (M08F-WS-Q803 ->
#                        M08F-WS, M08F_PLUS -> M08F, TP88 -> TP88)
set -euo pipefail

QUEUE="${FLATTOO_QUEUE:-Stencil}"
DENSITY="${FLATTOO_DENSITY:-6}"

# --uri URI --model NAME: explicit target (from stencil-bt-setup).
FORCE_URI=""; FORCE_MODEL=""
while [ $# -gt 0 ]; do
  case "$1" in
    --uri) FORCE_URI="$2"; shift 2 ;;
    --model) FORCE_MODEL="$2"; shift 2 ;;
    *) echo "usage: stencil-queue-setup [--uri URI --model NAME]" >&2; exit 2 ;;
  esac
done

log() { echo "stencil-queue-setup: $*"; }

# Wait for cupsd.
for _ in $(seq 1 30); do
  lpstat -r >/dev/null 2>&1 && break
  sleep 1
done
lpstat -r >/dev/null 2>&1 || { log "cups is not running"; exit 0; }

models_list="$(lpinfo -m 2>/dev/null || true)"

# ppd_for_prefix <model-string>: longest Phomemo PPD whose basename is a
# case-insensitive prefix of the model string (after normalising _ and space to -).
ppd_for_prefix() {
  local want norm best bestlen line ppd base b
  want="$1"
  norm="$(printf '%s' "$want" | tr '_ ' '--' | tr '[:upper:]' '[:lower:]')"
  best=""; bestlen=0
  while IFS= read -r line; do
    ppd="${line%% *}"
    case "$ppd" in Phomemo/*|*/qy/*) ;; *) continue ;; esac
    base="$(basename "$ppd" .ppd)"
    b="$(printf '%s' "$base" | tr '_ ' '--' | tr '[:upper:]' '[:lower:]')"
    if [ "${norm#"$b"}" != "$norm" ] && [ "${#b}" -gt "$bestlen" ]; then
      best="$ppd"; bestlen="${#b}"
    fi
  done <<<"$models_list"
  printf '%s' "$best"
}

uri=""; ppd=""; kind=""

# ppd_for_model <name>: Brother PJ by model number, else Phomemo by prefix.
ppd_for_model() {
  local n="$1" short
  if printf '%s' "$n" | grep -qiE 'PJ-?[67][0-9]{2}'; then
    short="$(printf '%s' "$n" | grep -oiE 'PJ-?[67][0-9]{2}' | head -n1 | tr -d '-' | tr '[:upper:]' '[:lower:]')"
    printf '%s\n' "$models_list" | awk -v s="$short" 'tolower($1) ~ ("brother_" s "_printer") {print $1; exit}'
  else
    ppd_for_prefix "$n"
  fi
}

# 0. Explicit target from the Bluetooth wizard.
if [ -n "$FORCE_URI" ]; then
  uri="$FORCE_URI"; ppd="$(ppd_for_model "$FORCE_MODEL")"
  case "$FORCE_MODEL" in *PJ-7*|*PJ7*|*pj7*) kind="brother" ;; *) kind="phomemo" ;; esac
  [ -n "$ppd" ] || log "no vendor PPD matches '$FORCE_MODEL'; using a raw queue"
fi

# 1. USB devices CUPS can see.
[ -n "$uri" ] || while read -r _ u _; do
  case "$u" in
    usb://Brother/PJ-7*)
      model="$(printf '%s' "$u" | sed -E 's#usb://Brother/(PJ-[0-9]+).*#\1#' | tr -d '-' | tr '[:upper:]' '[:lower:]')"  # pj723
      ppd="$(printf '%s\n' "$models_list" | awk -v s="$model" 'tolower($1) ~ ("brother_" s "_printer") {print $1; exit}')"
      uri="$u"; kind="brother"; break ;;
    usb://Brother/PJ-8*)
      # Prefer the driverless (ipp-usb) path below; fall through only if that is absent.
      uri="$u"; kind="brother-raw" ;;
    usb://*)
      vendor="$(printf '%s' "$u" | sed -E 's#usb://([^/]+)/.*#\1#')"
      model="$(printf '%s' "$u" | sed -E 's#usb://[^/]+/([^?]+).*#\1#' | sed 's/%20/ /g')"
      case "$vendor $model" in
        *[Pp]homemo*|*QuYin*|*QUYIN*|*M08*|*TP8[0-9]*|*T08*|*M0[0-9]*)
          cand="$(ppd_for_prefix "$model")"
          if [ -n "$cand" ]; then
            uri="$u"; ppd="$cand"; kind="phomemo"; break
          fi ;;
      esac ;;
  esac
done < <(lpinfo -v 2>/dev/null || true)

# 2. Driverless (PJ-8xx over ipp-usb or Wi-Fi). lpinfo -m lists these as driverless:ipp://...
if [ -z "$uri" ] || [ "$kind" = "brother-raw" ]; then
  line="$(printf '%s\n' "$models_list" | grep -i 'driverless:.*PJ-8' | head -n1 || true)"
  if [ -n "$line" ]; then
    ppd="${line%% *}"
    uri="${ppd#driverless:}"
    kind="driverless"
  fi
fi

# 3. A paired Bluetooth stencil printer (set up once with stencil-bt-setup).
if [ -z "$uri" ] && command -v bluetoothctl >/dev/null; then
  while read -r _ mac name; do
    case "$name" in
      *M08*|*TP8[0-9]*|*T08*|*[Pp]homemo*|*QuYin*|*PJ-7*|*PJ7*)
        cand="$(ppd_for_model "$name")"
        chan=1
        for f in /var/lib/flattoo/bt-"$(printf '%s' "$mac" | tr -d ':')".channel /home/*/.config/flattoo/bt-"$(printf '%s' "$mac" | tr -d ':')".channel; do
          [ -r "$f" ] && chan="$(tr -dc '0-9' < "$f")" && break
        done
        uri="bluetooth://$mac/${chan:-1}"; ppd="$cand"
        case "$name" in *PJ-7*|*PJ7*) kind="brother" ;; *) kind="phomemo" ;; esac
        break ;;
    esac
  done < <(bluetoothctl devices Paired 2>/dev/null || true)
fi

if [ -z "$uri" ]; then
  log "no stencil printer found (usb: $(lpinfo -v 2>/dev/null | awk '/usb:/ {print $2}' | tr '\n' ' '))"
  exit 0
fi

log "found $kind printer at $uri${ppd:+ (ppd: $ppd)}"

if lpstat -p "$QUEUE" >/dev/null 2>&1; then
  current="$(lpstat -v "$QUEUE" 2>/dev/null | awk '{print $NF}')"
  if [ "$current" = "$uri" ]; then
    log "queue $QUEUE already points at $uri"
  else
    log "re-pointing $QUEUE from $current to $uri"
    if [ -n "$ppd" ]; then lpadmin -p "$QUEUE" -v "$uri" -m "$ppd"; else lpadmin -p "$QUEUE" -v "$uri"; fi
  fi
else
  if [ -n "$ppd" ]; then
    lpadmin -p "$QUEUE" -E -v "$uri" -m "$ppd" -D "Stencil printer" -L "Studio"
  else
    log "no PPD for this model; adding as driverless/raw"
    lpadmin -p "$QUEUE" -E -v "$uri" -m everywhere -D "Stencil printer" -L "Studio" \
      || lpadmin -p "$QUEUE" -E -v "$uri" -D "Stencil printer" -L "Studio"
  fi
fi

# Stencil defaults: no scaling, Letter if the PPD has it, monochrome, not shared,
# and never leave the queue stopped after a paper-out or unplug.
media=Letter
lpoptions -p "$QUEUE" -l 2>/dev/null | grep -q '^PageSize.*\bLetter\b' || media=A4
lpadmin -p "$QUEUE" \
  -o "media-default=$media" \
  -o print-scaling-default=none \
  -o print-color-mode-default=monochrome \
  -o printer-is-shared=false \
  -o printer-error-policy=retry-current-job || true

case "$kind" in
  brother)
    # Binary halftone keeps line art crisp; density from flattoo.stencil.density.
    lpadmin -p "$QUEUE" -o BrHalftonePattern=BrBinary -o "BrDensity=$DENSITY" -o BrMirror=OFF 2>/dev/null || true ;;
  phomemo)
    # Vendor options: Darkness (Default/Light/Dark...), DegreeOfBlackRecognition 1-10.
    lpadmin -p "$QUEUE" -o ColorOption=GrayScale -o Rotate=0 2>/dev/null || true ;;
esac

cupsenable "$QUEUE" 2>/dev/null || true
cupsaccept "$QUEUE" 2>/dev/null || true
lpadmin -p "$QUEUE" -E 2>/dev/null || true
log "queue $QUEUE ready ($kind, $media, no scaling)"
