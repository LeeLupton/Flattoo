[Desktop Entry]
Type=Application
Name=Clean Lines (Sketch to Stencil)
Comment=Turn a scanned or photographed pencil sketch into clean black lines
Exec=stencil-clean-lines --gui %f
Icon=image-x-generic
Terminal=false
Categories=Graphics;
MimeType=image/png;image/jpeg;image/webp;image/heif;image/heic;image/avif;image/bmp;image/tiff;application/pdf;
Keywords=stencil;sketch;scan;lines;threshold;
