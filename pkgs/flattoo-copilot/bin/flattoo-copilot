#!/usr/bin/env python3
"""Ask Flattoo: the artist's copilot for everything that would otherwise be a terminal.

It never runs a shell command the user typed. A request is mapped to one of
a fixed set of actions — install/remove an app from the curated catalog, open
an app, put it on the panel, update now, fix the printer, free disk space,
show Wi-Fi/Bluetooth/battery status, change the look or layout, lock — and
anything else is answered with what it *can* do. Changes are described in
plain words and confirmed before they happen. The privileged part is a
single helper (flattoo-admin, via polkit) with four subcommands.

An LLM (Anthropic API or local Ollama) can be used to *understand* the
request; its answer is a structured choice that is validated against the
same allowlist and catalog, never a command.

  flattoo-copilot                 GUI (menu entry "Ask Flattoo")
  flattoo-copilot "install something like paint"
  flattoo-copilot --dry-run "update now"
"""

import argparse
import difflib
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.request

CATALOG_PATH = "@catalog@"
STATE_DIR = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "flattoo")
LOG = os.path.join(STATE_DIR, "copilot.log")
APPS_NIX = "/etc/nixos/hosts/{host}/apps.nix"

ACTIONS = {
    "install": "Install an app from the catalog",
    "remove": "Remove an app that was installed through me",
    "open": "Open an installed app",
    "panel": "Put an app on the panel",
    "suggest": "Suggest apps for a need",
    "update": "Install updates now (they also arrive every night by themselves)",
    "update-status": "Say when the last update ran and whether it worked",
    "printer-fix": "Find the stencil printer again",
    "printer-bluetooth": "Pair a Bluetooth stencil printer",
    "printer-network": "Add a Wi-Fi stencil printer",
    "printer-calibrate": "Print the calibration page",
    "print": "Print a stencil",
    "disk": "Show free space and clean up old system versions",
    "wifi": "Wi-Fi status and the Wi-Fi settings",
    "bluetooth": "Bluetooth settings",
    "battery": "Battery status",
    "power": "Shut down, restart, sleep or log out",
    "display": "Screen brightness and a second screen",
    "look": "Change the look of the desktop (a look by name, dark or light)",
    "night-look": "Automatic night look: the dark twin of your look in the evening, a warmer screen",
    "effects": "Window effects on or off (rounded corners, shadows, blur, animations)",
    "client": "Show a client your work: the portfolio fills the screen, Esc ends it and locks the laptop",
    "shop-display": "Shop display: show your work on the screen when the laptop sits idle",
    "layout": "Open a window layout",
    "lock": "Lock the setup",
    "installed": "List what is installed",
    "portfolio": "Build a gallery from your finished-work photos (nothing uploaded)",
    "profile": "Your artist profile: résumé, bio, certifications",
    "profile-skill": "Add a style or skill to your profile",
    "exposure": "The free places you are listed, and which need a refresh",
    "learn": "Open the help page about something (how do I…, what is…)",
    "help": "Explain what I can do",
}

# Checked in order, after a strong catalog hit. First match wins.
SYNONYMS = {
    "update-status": ["last update", "up to date", "when did it update", "did it update", "is it updated"],
    "update": ["update", "upgrade", "security", "patch", "latest version"],
    "disk": ["disk", "storage", "free space", "free up", "clean up", "cleanup", "running out of", "out of space", "out of room", "space left", "full"],
    "wifi": ["wifi", "wi-fi", "internet", "network", "wireless"],
    "bluetooth": ["bluetooth", "pair", "headphones", "speaker"],
    "shop-display": ["shop display", "screensaver", "screen saver", "when idle", "idle screen", "when nobody", "when i'm not using it", "slideshow of my work",
                     "show my work when", "display my work", "window display"],
    "client": ["show a client", "show the client", "client mode", "client wants to see", "show my work", "show them my work", "show her my work",
               "show him my work", "hand the laptop", "hand them the laptop", "let them browse", "let them look", "present my work", "walk-in wants to see"],
    "night-look": ["night look", "night mode", "automatic dark", "dark at night", "dark in the evening", "at night", "in the evening", "night shift",
                   "warm screen", "warmer screen", "automatic night", "switch to dark automatically", "dark automatically", "schedule"],
    "effects": ["effects", "animation", "rounded corners", "shadows", "blur", "transparen", "feels slow", "laggy", "lagging", "stutter",
                "slow desktop", "desktop is slow", "windows are slow", "fancy stuff", "eye candy", "wobbly", "flat look"],
    "power": ["turn off", "shut down", "shutdown", "power off", "switch off", "restart", "reboot", "log out", "logout", "go to sleep"],
    "display": ["brightness", "too dark", "too bright", "dim", "second screen", "external screen", "monitor", "projector", "mirror the screen"],
    "battery": ["battery", "charge", "charging", "power"],
    "layout": ["layout", "workspace", "arrange windows", "side by side", "windows next to"],
    "lock": ["lock the setup", "lock this", "make it permanent", "freeze", "lock down", "lock it"],
    "look": ["theme", "dark mode", "light mode", "look", "colors", "colours", "wallpaper", "panel", "bigger text", "text bigger", "larger text", "font size", "appearance", "icons", "cursor"],
    "installed": ["what is installed", "what do i have", "list apps", "installed apps", "what apps", "which apps"],
    "portfolio": ["portfolio", "gallery", "showcase", "photos for instagram", "photos for my website", "post my work", "my work online", "contact sheet"],
    "profile": ["resume", "résumé", "cv ", " cv", "my bio", "biography", "my profile", "artist profile", "certification", "press kit", "my skills"],
    "exposure": ["exposure", "more clients", "reviews", "google listing", "google business", "promote", "promotion", "reputation", "marketing", "followers", "get found", "get noticed"],
    "help": ["help", "what can you do", "what do you do"],
}

# Phrasings that ask to be shown or told something: the wiki answers those.
LEARN_WORDS = ["how do i", "how to", "how can i", "what is", "what does", "what are", "show me", "explain", "teach",
               "where is", "where are", "where do i", "help with", "help me", "guide", "manual", "wiki", "tutorial",
               "learn", "tell me about", "instructions", "walk me through", "why does", "why is", "can i ",
               "is it ", "is this", "should i", "do i need", "is there a way"]

# Anything about printing goes to one of the printer actions.
PRINTER_WORDS = ("print", "stencil", "thermal")
PRINTER_RULES = [
    ("printer-network", ["wifi", "wi-fi", "network", "lan", "ethernet", "ip address"]),
    ("printer-bluetooth", ["bluetooth", "pair", "wireless"]),
    ("printer-calibrate", ["calibrat", "too small", "too big", "wrong size", "size is", "ruler", "test page", "scale", "measure"]),
    ("print", ["print a", "print my", "print this", "print the", "print it", "print out", "make a stencil", "print stencil", "how do i print", "how to print", "want to print", "print something"]),
]


def log(line):
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(LOG, "a") as f:
        f.write(time.strftime("%Y-%m-%d %H:%M:%S ") + line + "\n")


def run(cmd, **kw):
    try:
        return subprocess.run(cmd, text=True, capture_output=True, **kw)
    except OSError as e:  # tool missing: report, never crash the dialog
        return subprocess.CompletedProcess(cmd, 127, "", str(e))


def spawn(cmd):
    try:
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        return True
    except OSError as e:
        log(f"spawn {cmd[0]} failed: {e}")
        return False


def have_gui():
    return bool(os.environ.get("DISPLAY")) and shutil.which("zenity") is not None


# ------------------------------------------------------------------ catalog and machine

def catalog():
    with open(CATALOG_PATH) as f:
        return json.load(f)


def host():
    try:
        with open("/etc/flattoo/host") as f:
            return f.read().strip() or "shop-laptop"
    except OSError:
        return "shop-laptop"


def extra_apps():
    """Packages added through the copilot (parsed from apps.nix)."""
    try:
        with open(APPS_NIX.format(host=host())) as f:
            m = re.search(r"extra\s*=\s*\[([^\]]*)\]", f.read())
            return re.findall(r'"([^"]+)"', m.group(1)) if m else []
    except OSError:
        return []


def is_installed(entry):
    if entry.get("default") or entry["pkg"] in extra_apps():
        return True
    d = entry.get("desktop")
    if d:
        for base in os.environ.get("XDG_DATA_DIRS", "/run/current-system/sw/share").split(":"):
            if os.path.exists(os.path.join(base, "applications", d)):
                return True
    return False


def machine():
    ram = 0
    try:
        with open("/proc/meminfo") as f:
            ram = int(re.search(r"MemTotal:\s+(\d+)", f.read()).group(1)) // (1024 * 1024)
    except Exception:  # noqa: BLE001
        pass
    gpu = run(["sh", "-c", "lspci 2>/dev/null | grep -iE 'vga|3d|display'"]).stdout.strip()
    disk = shutil.disk_usage("/")
    return {"ram_gb": ram, "gpu": gpu, "free_gb": disk.free // (1024 ** 3), "dedicated_gpu": bool(re.search(r"nvidia|radeon|amd/ati.*(rx|vega|navi)", gpu, re.I))}


def fit_note(entry, m):
    notes = []
    if m["ram_gb"] and entry.get("min_ram_gb", 2) > m["ram_gb"]:
        notes.append(f"wants {entry['min_ram_gb']} GB RAM, this laptop has {m['ram_gb']}")
    if entry.get("gpu") == "recommended" and not m["dedicated_gpu"]:
        notes.append("runs better with a dedicated graphics card, which this laptop does not have")
    if entry.get("heavy") and m["free_gb"] < 8:
        notes.append(f"big download; only {m['free_gb']} GB free")
    return "; ".join(notes)


# ------------------------------------------------------------------ the wiki

def wiki_dir():
    for base in [os.environ.get("FLATTOO_WIKI", "")] + os.environ.get("XDG_DATA_DIRS", "").split(":") + ["/run/current-system/sw/share"]:
        if not base:
            continue
        d = base if base.endswith("wiki") else os.path.join(base, "flattoo", "wiki")
        if os.path.exists(os.path.join(d, "index.json")):
            return d
    return None


def wiki_pages():
    d = wiki_dir()
    if not d:
        return []
    try:
        with open(os.path.join(d, "index.json")) as f:
            return json.load(f)["pages"]
    except (OSError, ValueError, KeyError):
        return []


def wiki_search(text, n=4):
    """Rank wiki pages for a request; the ranking lives in flattoo-wiki so there is one of it."""
    if not shutil.which("flattoo-wiki") or not wiki_pages():
        return []
    r = run(["flattoo-wiki", "search", "--json", text])
    try:
        hits = json.loads(r.stdout or "[]")
    except ValueError:
        return []
    byid = {p["id"]: p for p in wiki_pages()}
    return [(h["score"], byid[h["id"]]) for h in hits[:n] if h["id"] in byid]


def wiki_candidates(hits):
    """One page when the best hit is clear, otherwise the top three to pick from."""
    if len(hits) == 1 or hits[0][0] >= 3.0 or hits[0][0] >= 1.8 * hits[1][0]:
        return [hits[0][1]["id"]]
    return [p["id"] for _, p in hits[:3]]


def wiki_open(page_id):
    d = wiki_dir()
    if not d:
        return False
    path = os.path.join(d, page_id + ".html")
    return os.path.exists(path) and spawn(["xdg-open", "file://" + path])


# ------------------------------------------------------------------ understanding

def norm(s):
    return re.sub(r"[^a-z0-9+#. ]+", " ", s.lower()).strip()


def match_catalog(text, cat):
    """Score catalog entries against the request. Returns sorted [(score, entry)]."""
    t = norm(text)
    words = set(t.split())
    scored = []
    for e in cat:
        score = 0.0
        names = [e["name"].lower(), e["pkg"].lower().split(".")[-1]] + [x.lower() for x in e["tags"]]
        for n in names:
            if re.search(r"\b" + re.escape(n) + r"\b", t):
                score = max(score, 1.0 + len(n) / 40)
            else:
                r = difflib.SequenceMatcher(None, n, t).ratio()
                if r > 0.8:
                    score = max(score, r)
                for w in words:
                    if len(w) > 3 and (w == n or (len(n) > 3 and difflib.SequenceMatcher(None, w, n).ratio() > 0.86)):
                        score = max(score, 0.9)
        if score:
            scored.append((score, e))
    scored.sort(key=lambda x: -x[0])
    return scored


def looks():
    """name -> title of every look flattoo-look knows (system and user presets)."""
    out = {}
    r = run(["flattoo-look", "list"])
    for line in r.stdout.splitlines():
        parts = line.split(None, 1)
        if parts:
            title = parts[1].split("  —")[0].strip() if len(parts) > 1 else parts[0]
            out[parts[0]] = title
    return out


def match_look(t):
    """A look named in the text, by name or title, longest match first; None if none."""
    cands = []
    for name, title in looks().items():
        for key in {name, name.replace("-", " "), title.lower(), title.lower().replace("&", "and")}:
            if key and re.search(r"(?<![a-z0-9])" + re.escape(key) + r"(?![a-z0-9])", t):
                cands.append((len(key), name))
    if not cands:
        return None
    cands.sort(reverse=True)
    return cands[0][1]


def classify(text, cat):
    """Rule-based understanding. Returns (action, args, confidence)."""
    t = norm(text)
    verbs_install = any(v in t for v in ["install", "get me", "add ", "download", "i need", "i want", "something like", "like", "app for", "program for", "do you have", "is there", "get "])
    verbs_remove = any(v in t for v in ["remove", "uninstall", "delete", "get rid"])
    verbs_open = any(v in t for v in ["open", "launch", "start ", "run "])
    verbs_panel = any(v in t for v in ["panel", "dock", "taskbar", "shortcut", "pin "])

    # 1. Printing: every complaint about the printer is one of four fixes.
    if any(w in t for w in PRINTER_WORDS):
        for action, words in PRINTER_RULES:
            if any(w in t for w in words):
                return action, {}, 0.8
        return "printer-fix", {}, 0.7

    # 2. A catalog app named outright (name, pkg or a tag spelled out). A
    #    question ("how do I scan a sketch") only counts here when it names
    #    an app; otherwise the wiki answers it below.
    asks = any(w in t for w in LEARN_WORDS)
    hits = match_catalog(text, cat)
    strong = [(s, e) for s, e in hits if s >= 1.0]
    named = bool(strong) and (strong[0][1]["name"].lower() in t or strong[0][1]["pkg"].lower().split(".")[-1] in t)
    if strong and not (asks and not named):
        top = strong[0][1]
        if verbs_remove:
            return "remove", {"pkg": top["pkg"]}, 0.8
        if verbs_panel and is_installed(top):
            return "panel", {"pkg": top["pkg"]}, 0.8
        if verbs_open and is_installed(top):
            return "open", {"pkg": top["pkg"]}, 0.8
        if named or (verbs_install and len(strong) == 1):
            return ("open" if is_installed(top) else "install"), {"pkg": top["pkg"]}, 0.8
        return "suggest", {"query": text, "candidates": [e["pkg"] for _, e in hits[:5]]}, 0.7

    # 3. "How do I…" — the wiki, when it has a page that fits. Status questions
    #    ("is it up to date") are answered live, not from a page.
    if any(p in t for p in SYNONYMS["update-status"]):
        return "update-status", {}, 0.8
    explicit_install = any(v in t for v in ["install", "download", "add ", "get me", "i want", "i need"])
    if asks and not (explicit_install or verbs_remove):
        hits = wiki_search(text)
        if hits and hits[0][0] >= 1.0:
            return "learn", {"page": hits[0][1]["id"], "candidates": wiki_candidates(hits)}, 0.8

    # 4. "add fine line to my skills / résumé / profile"
    m = re.search(r"(?:add|put)\s+(.+?)\s+(?:to|on|in)\s+my\s+(?:skills?|r[eé]sum[eé]|cv|profile|bio)", t)
    if m:
        return "profile-skill", {"skill": re.sub(r"[^a-z0-9 +&/-]", "", m.group(1)).strip()[:40]}, 0.8

    # 5. A look by name ("neon", "switch to sakura", "the blackwork look") or
    #    dark/light mode — unless a time or "automatically" makes it a schedule.
    scheduled = any(w in t for w in ("automatic", "at night", "in the evening", "every night", "every evening", "when it gets dark",
                                     "schedule", "evenings", "nights")) \
        or re.search(r"\b(at|from|after|until|till|to)\s+\d{1,2}(:\d{2})?\s*(am|pm)?\b", t)
    look = match_look(t)
    if look and not scheduled:
        return "look", {"name": look}, 0.8
    if not scheduled:
        # "night look" is the automatic one (below); "dark mode"/"dark look" is a switch now
        if re.search(r"\b(dark|night)\s*(mode|theme)\b|\bdark look\b", t) or t.strip() in ("dark", "go dark", "make it dark", "darker"):
            return "look", {"mode": "dark"}, 0.8
        if re.search(r"\b(light|day|bright)\s*(mode|theme|look)\b", t) or t.strip() in ("go light", "make it light", "lighter"):
            return "look", {"mode": "light"}, 0.8

    # 6. System chores.
    for action, syns in SYNONYMS.items():
        if any(s in t for s in syns) or (action == "night-look" and scheduled and re.search(r"dark|night|light|warm", t)):
            args = {}
            if action in ("shop-display", "effects", "night-look"):
                if re.search(r"\b(off|stop|disable|no more|turn it off|get rid)\b", t):
                    args = {"state": "off"}
                elif re.search(r"\b(on|start|enable|turn it on|back on)\b", t) or (action == "night-look" and scheduled):
                    args = {"state": "on"}
            if action == "night-look" and args.get("state") == "on":
                m = re.findall(r"\b(\d{1,2})(?::(\d{2}))?\s*(am|pm)?\b", text.lower())  # the raw text keeps the colon in 20:30
                times = []
                for h, mi, ap in m:
                    h = int(h)
                    if ap == "pm" and h < 12:
                        h += 12
                    if ap == "am" and h == 12:
                        h = 0
                    if h < 24:
                        times.append(f"{h:02d}:{mi or '00'}")
                if times:
                    args = {"state": "on", "night": times[0], "day": times[1] if len(times) > 1 else None}
            return action, args, 0.8

    # 7. A vague app wish ("something for photos").
    if hits:
        return "suggest", {"query": text, "candidates": [e["pkg"] for _, e in hits[:5]]}, 0.6
    # 8. Anything the wiki knows about.
    whits = wiki_search(text)
    if whits and whits[0][0] >= 1.0:
        return "learn", {"page": whits[0][1]["id"], "candidates": wiki_candidates(whits)}, 0.5
    return "help", {"unknown": text}, 0.3


# ------------------------------------------------------------------ optional LLM

LLM_SYSTEM = """You help a tattoo artist use a Linux laptop. You can only choose ONE action from this list and fill its arguments; you cannot run commands.
Actions: {actions}
Catalog packages (pkg: name — tags): {catalog}
Reply with JSON only: {{"action": "<action>", "args": {{...}}, "say": "<one or two friendly sentences in plain English, no jargon>"}}
For install/remove/open/panel the only argument is "pkg" and it MUST be one of the catalog pkg values. For suggest, args = {{"candidates": [pkg,...]}} with up to 4 pkgs ranked for the need, preferring installed ones and apps that fit the hardware: {machine}. Already installed: {installed}.
Help pages (id: title — summary): {wiki}
When the person asks how something works, where something is, or what something means, use "learn" with args = {{"page": "<id>"}} from that list and answer briefly in "say" using the page summary.
If the request is not covered by the actions, use "help" and explain in "say" what you can do instead."""


def llm_choose(text, cat, provider, machine_info, installed):
    sysmsg = LLM_SYSTEM.format(
        actions="; ".join(f"{k}: {v}" for k, v in ACTIONS.items()),
        catalog="; ".join(f"{e['pkg']}: {e['name']} — {', '.join(e['tags'][:5])}" for e in cat),
        machine=f"RAM {machine_info['ram_gb']} GB, dedicated GPU: {machine_info['dedicated_gpu']}, free disk {machine_info['free_gb']} GB",
        installed=", ".join(installed),
        wiki="; ".join(f"{p['id']}: {p['title']} — {p['summary']}" for p in wiki_pages()))
    try:
        if provider == "anthropic":
            key = open(os.environ.get("FLATTOO_COPILOT_KEYFILE", "/etc/flattoo/copilot.key")).read().strip()
            body = {"model": os.environ.get("FLATTOO_COPILOT_MODEL", "claude-haiku-5-5"), "max_tokens": 400,
                    "system": sysmsg, "messages": [{"role": "user", "content": text}]}
            req = urllib.request.Request("https://api.anthropic.com/v1/messages", data=json.dumps(body).encode(),
                                         headers={"content-type": "application/json", "x-api-key": key, "anthropic-version": "2023-06-01"})
            with urllib.request.urlopen(req, timeout=30) as r:
                out = json.load(r)["content"][0]["text"]
        elif provider == "ollama":
            body = {"model": os.environ.get("FLATTOO_COPILOT_MODEL", "qwen2.5:3b"), "stream": False, "format": "json",
                    "messages": [{"role": "system", "content": sysmsg}, {"role": "user", "content": text}]}
            req = urllib.request.Request("http://127.0.0.1:11434/api/chat", data=json.dumps(body).encode(), headers={"content-type": "application/json"})
            with urllib.request.urlopen(req, timeout=120) as r:
                out = json.load(r)["message"]["content"]
        else:
            return None
        m = re.search(r"\{.*\}", out, re.S)
        d = json.loads(m.group(0)) if m else None
    except Exception as e:  # noqa: BLE001
        log(f"llm {provider} failed: {e}")
        return None
    # validate: this is the security boundary for the model's output
    if not isinstance(d, dict) or d.get("action") not in ACTIONS:
        return None
    args = d.get("args") or {}
    pkgs = {e["pkg"] for e in cat}
    if d["action"] in ("install", "remove", "open", "panel"):
        if args.get("pkg") not in pkgs:
            return None
        args = {"pkg": args["pkg"]}
    elif d["action"] == "suggest":
        args = {"candidates": [p for p in (args.get("candidates") or []) if p in pkgs][:4], "query": text}
    elif d["action"] == "learn":
        ids = {p["id"] for p in wiki_pages()}
        if args.get("page") not in ids:
            return None
        args = {"page": args["page"], "candidates": [args["page"]]}
    elif d["action"] == "profile-skill":
        skill = re.sub(r"[^A-Za-z0-9 +&/-]", "", str(args.get("skill", ""))).strip()[:40]
        if not skill:
            return None
        args = {"skill": skill}
    elif d["action"] == "look":
        a = {}
        if args.get("name") in looks():
            a["name"] = args["name"]
        elif args.get("mode") in ("dark", "light"):
            a["mode"] = args["mode"]
        args = a
    elif d["action"] in ("shop-display", "effects", "night-look"):
        a = {}
        if args.get("state") in ("on", "off"):
            a["state"] = args["state"]
        for k in ("night", "day"):
            v = str(args.get(k, "") or "")
            if re.fullmatch(r"\d{1,2}:\d{2}", v) and int(v.split(":")[0]) < 24 and int(v.split(":")[1]) < 60:
                a[k] = v
        args = a
    else:
        args = {}
    say = str(d.get("say", ""))[:400]
    return d["action"], args, say


# ------------------------------------------------------------------ actions

def admin(*args):
    """Privileged helper through polkit. Returns (rc, output)."""
    r = run(["pkexec", "/run/current-system/sw/bin/flattoo-admin", *args])
    return r.returncode, (r.stdout + r.stderr)


def do_install(pkg, cat, ui):
    e = next(x for x in cat if x["pkg"] == pkg)
    if is_installed(e):
        return f"{e['name']} is already installed.", "open:" + pkg
    note = fit_note(e, machine())
    text = f"Install {e['name']}?\n\n{e['blurb']}" + (f"\n\nNote: {note}." if note else "") + "\n\nThis rebuilds the system; a few minutes, then it is in the menu."
    if not ui.confirm(text, "Install"):
        return "Okay, not installing.", None
    ui.progress_start(f"Installing {e['name']}…")
    rc, out = admin("install", pkg)
    ui.progress_end()
    log(f"install {pkg} rc={rc}")
    if rc == 0:
        return f"{e['name']} is installed. You will find it in the menu" + (" and I can put it on the panel if you like." if e.get("desktop") else "."), "open:" + pkg
    return f"Installing {e['name']} did not finish:\n{out[-400:]}", None


def do_remove(pkg, cat, ui):
    e = next(x for x in cat if x["pkg"] == pkg)
    if e.get("default"):
        return f"{e['name']} is part of the base setup; I can take it off the panel but not remove it.", None
    if pkg not in extra_apps():
        return f"{e['name']} was not installed through me, so there is nothing to remove.", None
    if not ui.confirm(f"Remove {e['name']}?", "Remove"):
        return "Okay, keeping it.", None
    ui.progress_start(f"Removing {e['name']}…")
    rc, out = admin("remove", pkg)
    ui.progress_end()
    log(f"remove {pkg} rc={rc}")
    return (f"{e['name']} is removed." if rc == 0 else f"Removing did not finish:\n{out[-400:]}"), None


def do_open(pkg, cat):
    e = next(x for x in cat if x["pkg"] == pkg)
    d = e.get("desktop")
    ok = spawn(["gtk-launch", d]) if d and shutil.which("gtk-launch") else spawn([pkg.split(".")[-1]])
    return (f"Opening {e['name']}." if ok else f"Could not start {e['name']}."), None


def do_panel(pkg, cat):
    e = next(x for x in cat if x["pkg"] == pkg)
    d = e.get("desktop")
    if not d:
        return f"{e['name']} has no launcher I can add.", None
    r = run(["xfce4-panel", "--add=launcher", d])
    return (f"{e['name']} is on the panel now." if r.returncode == 0 else "Could not add it to the panel (is the XFCE panel running?)."), None


def do_suggest(query, candidates, cat, ui):
    m = machine()
    lines = []
    entries = [next(x for x in cat if x["pkg"] == p) for p in candidates]
    for e in entries[:4]:
        state = "installed" if is_installed(e) else "not installed"
        note = fit_note(e, m)
        lines.append(f"• {e['name']} ({state}) — {e['blurb']}" + (f" Note: {note}." if note else ""))
    text = "Here is what fits:\n\n" + "\n\n".join(lines)
    if ui.gui:
        rows = []
        for e in entries[:4]:
            rows += [e["pkg"], e["name"], ("Open" if is_installed(e) else "Install") + " — " + e["blurb"][:90]]
        pick = ui.pick("Which one?", rows, text)
        if pick:
            e = next(x for x in cat if x["pkg"] == pick)
            return (do_open(pick, cat) if is_installed(e) else do_install(pick, cat, ui))
        return "Okay.", None
    return text, None


def do_update(ui):
    if not ui.confirm("Install updates now?\n\nUpdates also arrive every night by themselves. Doing it now takes a few minutes; keep the laptop plugged in and open.", "Update"):
        return "Okay, the nightly update will take care of it.", None
    ui.progress_start("Updating…")
    rc, out = admin("update")
    ui.progress_end()
    log(f"update rc={rc}")
    return ("Updated. Most changes apply right away; anything deeper (like the kernel) lands at the next restart." if rc == 0 else f"The update did not finish:\n{out[-400:]}"), None


def do_update_status():
    r = run(["systemctl", "show", "nixos-upgrade.service", "-p", "ExecMainStatus", "-p", "ExecMainExitTimestamp", "-p", "Result"])
    info = dict(l.split("=", 1) for l in r.stdout.splitlines() if "=" in l)
    when = info.get("ExecMainExitTimestamp", "") or "never"
    ok = info.get("ExecMainStatus") == "0"
    gen = run(["sh", "-c", "ls -1 /nix/var/nix/profiles/ 2>/dev/null | grep -c system-"]).stdout.strip() or "?"
    ver = run(["nixos-version"]).stdout.strip()
    return (f"Last update: {when} — {'succeeded' if ok else 'did not finish' if info.get('ExecMainStatus') else 'no run recorded yet'}.\n"
            f"System: {ver}\n{gen} versions kept for rollback at the boot menu."), None


def do_disk(ui):
    du = shutil.disk_usage("/")
    free, total = du.free // (1024 ** 3), du.total // (1024 ** 3)
    text = f"{free} GB free of {total} GB."
    if ui.confirm(text + "\n\nClean up old system versions and caches? Keeps the last two weeks for rollback.", "Clean up"):
        ui.progress_start("Cleaning up…")
        rc, out = admin("cleanup")
        ui.progress_end()
        du2 = shutil.disk_usage("/")
        return f"Done. {du2.free // (1024 ** 3)} GB free now (was {free}).", None
    return text, None


def do_simple(action):
    if action == "printer-fix":
        spawn(["stencil-fix-printer"]); return "Looking for the stencil printer…", None
    if action == "printer-bluetooth":
        spawn(["stencil-bt-setup"]); return "Opening the Bluetooth printer setup.", None
    if action == "printer-network":
        spawn(["stencil-net-setup"]); return "Opening the network printer setup.", None
    if action == "printer-calibrate":
        spawn(["stencil-calibrate", "--gui"]); return "Printing the calibration page.", None
    if action == "print":
        spawn(["stencil-print", "--gui"]); return "Opening Print Stencil. Pick the image and the size.", None
    if action == "wifi":
        st = run(["nmcli", "-t", "-f", "NAME,TYPE,DEVICE", "connection", "show", "--active"]).stdout.strip().replace(":", " · ")
        spawn(["nm-connection-editor"])
        return (f"Connected: {st}" if st else "Not connected.") + "\nOpening the Wi-Fi settings.", None
    if action == "bluetooth":
        spawn(["blueman-manager"]); return "Opening Bluetooth.", None
    if action == "portfolio":
        spawn(["flattoo-portfolio"]); return "Opening Portfolio. It finds your finished-work photos and builds a gallery folder; originals stay put, nothing is uploaded.", None
    if action == "profile":
        spawn(["flattoo-profile"]); return "Opening Artist Profile: résumé, bio, certifications, links.", None
    if action == "exposure":
        spawn(["flattoo-profile", "exposure-gui"]); return "Opening the exposure checklist: the free places a studio is listed and which ones need a refresh.", None
    if action == "power":
        spawn(["flattoo-power"]); return "Pick Lock, Sleep, Restart, Shut down or Log out.", None
    if action == "display":
        spawn(["xfce4-display-settings"]); return "Opening the screen settings. Brightness is the sun keys on the keyboard (hold Fn if they do nothing).", None
    if action == "battery":
        out = run(["sh", "-c", "upower -i $(upower -e | grep -m1 BAT) 2>/dev/null | grep -E 'state|percentage|time to'"]).stdout.strip()
        return (out or "No battery found."), None
    if action == "look":
        return do_look(args)
    if action == "night-look":
        return do_night_look(args)
    if action == "effects":
        st = args.get("state")
        if st in ("on", "off"):
            run(["flattoo-look", "effects", st])
            return ("Window effects on: rounded corners, shadows, blur, animations." if st == "on"
                    else "Window effects off. The desktop is flat and quick now; say “effects on” to bring them back."), None
        cur = run(["flattoo-look", "effects", "status"]).stdout.strip()
        new = "off" if cur != "xfwm" else "on"
        run(["flattoo-look", "effects", new])
        return f"Window effects {new}. Say “effects {'on' if new == 'off' else 'off'}” to switch back.", None
    if action == "client":
        spawn(["flattoo-showcase", "gui"]); return "Opening “Show a client”: your portfolio fills the screen; Esc ends it and locks the laptop.", None
    if action == "shop-display":
        st = args.get("state")
        if st in ("on", "off"):
            r = run(["flattoo-showcase", "display", st])
            if r.returncode != 0:
                spawn(["flattoo-portfolio"])
                return "There is no gallery yet — opening Portfolio to build one from your finished-work photos first.", None
            return ("Shop display on: when the laptop sits idle it shows your work. Anyone walking past will see it." if st == "on"
                    else "Shop display off: an idle laptop goes dark again."), None
        spawn(["flattoo-showcase", "display", "gui"]); return "Opening Shop display.", None
    if action == "layout":
        spawn(["flattoo-layout", "gui"]); return "Opening Layouts.", None
    if action == "lock":
        spawn(["flattoo-lock"]); return "Opening Lock This Setup.", None
    return None


def do_look(args):
    name = args.get("name")
    mode = args.get("mode")
    known = looks()
    if not name and mode:
        cur = run(["flattoo-look", "current-name"]).stdout.strip()
        if cur and cur in known:
            twin = run(["flattoo-look", "twin", cur, mode]).stdout.strip()
            if twin:
                name = twin
            elif mode == "dark" and cur in ("home", "sakura", "flash", "paper", "classic-desktop"):
                name = None
        if not name:
            spawn(["flattoo-look", "gui"])
            return f"Opening Looks — pick a {mode} one (Home Dark, Blackwork, Neon, Forest, Kanagawa, Sakura Night, Night Session, Studio Dark…)." if mode == "dark" \
                else "Opening Looks — pick a light one (Home, Sakura, Flash Sheet, Paper, Classic Desktop).", None
    if name and name in known:
        r = run(["flattoo-look", "apply", name])
        if r.returncode == 0:
            return f"Look changed to {known[name]}.", None
        return f"Could not apply {known[name]}: {r.stderr.strip()[-200:]}", None
    spawn(["flattoo-look", "gui"]); return "Opening Looks.", None


def do_night_look(args):
    st = args.get("state")
    if st == "off":
        run(["flattoo-look", "schedule", "off"])
        return "Automatic night look off. The look stays as you set it.", None
    if st == "on":
        cmd = ["flattoo-look", "schedule", "set"]
        if args.get("night"):
            cmd.append(args["night"])
            if args.get("day"):
                cmd.append(args["day"])
        r = run(cmd)
        st_ = run(["flattoo-look", "schedule", "status"]).stdout
        try:
            sch = json.loads(st_)
        except ValueError:
            sch = {}
        return (f"Automatic night look on: dark from {sch.get('night', '20:00')} to {sch.get('day', '07:00')}. "
                "Looks with a dark twin switch over (Home → Home Dark, Sakura → Sakura Night, Flash Sheet → Blackwork); the others just get a warmer screen."), None
    spawn(["flattoo-look", "schedule", "gui"]); return "Opening the automatic night look settings.", None


def do_installed(cat):
    base = [e["name"] for e in cat if e.get("default")]
    extra = [next((e["name"] for e in cat if e["pkg"] == p), p) for p in extra_apps()]
    return ("Base apps: " + ", ".join(base) + "." + (f"\n\nAdded: {', '.join(extra)}." if extra else "\n\nNothing added yet.")), None


def do_learn(page, candidates, ui):
    pages = {p["id"]: p for p in wiki_pages()}
    if page not in pages:
        return do_help()
    if ui.gui and len(candidates) > 1:
        rows = []
        for pid in candidates:
            if pid in pages:
                rows += [pid, pages[pid]["title"], pages[pid]["summary"][:100]]
        pick = ui.pick("Which page?", rows, "") or None
        if pick is None:
            return "Okay.", None
        page = pick
    if wiki_open(page):
        return f"Opening “{pages[page]['title']}”.\n\n{pages[page]['summary']}", None
    return pages[page]["summary"], None


def do_help(unknown=None):
    lead = f"I don't know how to do \"{unknown}\".\n\n" if unknown else ""
    tail = "\n\nFor anything else, ask Lee."
    if wiki_dir():
        tail = "\n\nAsk me “how do I…” for the help pages, or open Help & How-To from the menu. For anything else, ask Lee."
    return lead + "I can:\n" + "\n".join(f"• {v}" for v in ACTIONS.values()) + tail, None


# ------------------------------------------------------------------ UI

class UI:
    def __init__(self, gui, dry_run=False):
        self.gui = gui
        self.dry = dry_run
        self._prog = None

    def ask(self):
        if self.gui:
            r = run(["zenity", "--entry", "--title=Ask Flattoo", "--width=520",
                     "--text=What do you need? (\"something like Paint\", \"fix the printer\", \"update now\", \"free up space\"…)"])
            return r.stdout.strip() if r.returncode == 0 else None
        return input("What do you need? ").strip()

    def confirm(self, text, ok="OK"):
        if self.dry:
            print("[dry-run] would ask:", text.replace("\n", " ")[:200]); return False
        if self.gui:
            return run(["zenity", "--question", "--title=Ask Flattoo", "--width=460", f"--text={text}", f"--ok-label={ok}", "--cancel-label=Not now"]).returncode == 0
        print(text); return input(f"{ok}? [y/N] ").lower().startswith("y")

    def pick(self, title, rows, intro):
        if not self.gui:
            print(intro); return None
        r = run(["zenity", "--list", "--title=Ask Flattoo", "--width=640", "--height=360", f"--text={title}",
                 "--column=id", "--column=App", "--column=About", "--hide-column=1", "--print-column=1", *rows])
        return r.stdout.strip() if r.returncode == 0 and r.stdout.strip() else None

    def progress_start(self, text):
        if self.gui:
            self._prog = subprocess.Popen(["zenity", "--progress", "--title=Ask Flattoo", f"--text={text}", "--pulsate", "--no-cancel", "--auto-close", "--width=380"],
                                          stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        else:
            print(text)

    def progress_end(self):
        if self._prog:
            try:
                self._prog.stdin.write(b"100\n"); self._prog.stdin.flush()
            except OSError:
                pass
            self._prog.terminate(); self._prog = None

    def say(self, text, follow=None):
        if self.gui:
            if follow and follow.startswith("open:"):
                if run(["zenity", "--question", "--title=Ask Flattoo", "--width=460", f"--text={text}", "--ok-label=Open it", "--cancel-label=Done"]).returncode == 0:
                    do_open(follow[5:], catalog())
            else:
                run(["zenity", "--info", "--title=Ask Flattoo", "--width=460", f"--text={text}"])
        else:
            print(text)


def handle(text, ui, provider="none"):
    cat = catalog()
    installed = [e["pkg"] for e in cat if is_installed(e)]
    choice = llm_choose(text, cat, provider, machine(), installed) if provider != "none" else None
    say = ""
    if choice:
        action, args, say = choice
    else:
        action, args, _ = classify(text, cat)
    log(f"request={text!r} action={action} args={json.dumps(args)} via={'llm' if choice else 'rules'}")
    if ui.dry:
        return action, args
    if action == "install":
        msg, follow = do_install(args["pkg"], cat, ui)
    elif action == "remove":
        msg, follow = do_remove(args["pkg"], cat, ui)
    elif action == "open":
        msg, follow = do_open(args["pkg"], cat)
    elif action == "panel":
        msg, follow = do_panel(args["pkg"], cat)
    elif action == "suggest":
        cands = args.get("candidates") or [e["pkg"] for _, e in match_catalog(text, cat)[:4]]
        msg, follow = do_suggest(text, cands, cat, ui) if cands else do_help(text)
    elif action == "update":
        msg, follow = do_update(ui)
    elif action == "update-status":
        msg, follow = do_update_status()
    elif action == "disk":
        msg, follow = do_disk(ui)
    elif action == "installed":
        msg, follow = do_installed(cat)
    elif action == "profile-skill":
        skill = args.get("skill", "")
        if skill and ui.confirm(f"Add “{skill}” to the styles and skills on your profile?", "Add"):
            r = run(["flattoo-profile", "add-skill", skill])
            msg, follow = (f"Added “{skill}”. Ask me for “my resume” to render it." if r.returncode == 0 else "Could not update the profile."), None
        else:
            msg, follow = "Okay, nothing added.", None
    elif action == "learn":
        msg, follow = do_learn(args.get("page"), args.get("candidates") or [args.get("page")], ui)
    elif action == "help":
        msg, follow = do_help(args.get("unknown"))
    else:
        r = do_simple(action)
        msg, follow = r if r else do_help(text)
    if say and action not in ("suggest",):
        msg = say + "\n\n" + msg
    ui.say(msg, follow)
    return action, args


def main(argv=None):
    ap = argparse.ArgumentParser(prog="flattoo-copilot", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("request", nargs="*")
    ap.add_argument("--dry-run", action="store_true", help="print the chosen action, change nothing")
    ap.add_argument("--provider", default=os.environ.get("FLATTOO_COPILOT_PROVIDER", "none"), choices=["none", "anthropic", "ollama"])
    ap.add_argument("--no-gui", action="store_true")
    ap.add_argument("--list-actions", action="store_true", help="print the action allowlist as JSON")
    args = ap.parse_args(argv)
    if args.list_actions:
        print(json.dumps(list(ACTIONS)))
        return 0
    ui = UI(have_gui() and not args.no_gui and not args.dry_run, dry_run=args.dry_run)
    text = " ".join(args.request).strip() or ui.ask()
    if not text:
        return 1
    action, a = handle(text, ui, args.provider)
    if args.dry_run:
        print(json.dumps({"action": action, "args": a}))
    return 0


if __name__ == "__main__":
    sys.exit(main())
