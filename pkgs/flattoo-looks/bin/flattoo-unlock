#!/usr/bin/env bash
# Unlock: back to the customizable mode. Needs the admin password (polkit).
set -uo pipefail
gui() { [ -n "${DISPLAY:-}" ] && command -v zenity >/dev/null; }

if [ ! -e /etc/flattoo/locked ]; then
  if gui; then zenity --info --title="Unlock" --text="This laptop is not locked."; else echo "not locked"; fi
  exit 0
fi
msg="Unlock the setup?\n\nThe desktop stays as it is, but settings can be changed again and the stricter mode is switched off. You will be asked for the admin password."
if gui; then
  zenity --question --title="Unlock" --width=420 --text="$msg" --ok-label="Unlock" --cancel-label="Cancel" || exit 1
fi
log="$(mktemp)"
if gui; then
  ( pkexec /run/current-system/sw/bin/flattoo-unlock-apply > "$log" 2>&1; echo "rc=$?" >> "$log" ) &
  pid=$!
  ( while kill -0 $pid 2>/dev/null; do echo "# Rebuilding…"; sleep 2; done; echo 100 ) \
    | zenity --progress --title="Unlock" --text="Rebuilding…" --pulsate --auto-close --no-cancel --width=380
  wait $pid
else
  pkexec /run/current-system/sw/bin/flattoo-unlock-apply | tee "$log"; echo "rc=${PIPESTATUS[0]}" >> "$log"
fi
if grep -q '^rc=0$' "$log"; then
  if gui; then zenity --info --title="Unlock" --width=380 --text="Unlocked. Restart to finish."; else echo unlocked; fi
else
  if gui; then zenity --error --title="Unlock" --width=480 --text="Unlock did not finish:\n\n$(tail -n 8 "$log")"; else tail -n 20 "$log"; fi
  exit 1
fi
