#!/usr/bin/env python3
"""Looks: whole-desktop presets for XFCE, and the capture/restore that the lock uses.

  flattoo-look gui                 pick a look (menu entry "Looks")
  flattoo-look list
  flattoo-look apply NAME          theme, icons, cursor, fonts, panel, wallpaper, workspaces, xfwm
  flattoo-look save NAME           snapshot the current desktop as a user preset
  flattoo-look export DIR          capture the current desktop config files (for flattoo-lock)
  flattoo-look restore-files DIR   write a captured bundle into ~/.config before the session starts
  flattoo-look effects on|off      window effects (picom: rounded corners, shadows, blur, animations)
  flattoo-look schedule …          automatic night look: set HH:MM HH:MM | off | status | daemon | tick

Presets are JSON in @presets@ (system) and ~/.config/flattoo/looks (user).
A preset can be partial: only the keys it has are applied. Keys beyond the
obvious ones:

  effects      {"corners": 12, "shadows": true, "blur": true, "animations": true,
                "inactive_opacity": 1.0}  or false (xfwm's own compositor)
  palette      {"bg", "fg", "muted", "accent", "on_accent", "border", "card", "rofi_bg", "radius"}:
               colours for the notification bubbles and the app grid / power sheet
  notify       {"position": "top-center", "opacity": 0.96, "theme": "<a notifyd theme, else the palette's>"}
  night_light  colour temperature in kelvin (warm screen); absent = neutral
  night        name of this look's dark twin, used by the automatic night look
"""

import argparse
import glob
import hashlib
import io
import json
import os
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time
import xml.etree.ElementTree as ET

PRESETS_DIR = "@presets@"
WALLPAPER_DIR = "@wallpapers@"
HOME = os.path.expanduser("~")
CFG = os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config"))
CACHE = os.environ.get("XDG_CACHE_HOME", os.path.join(HOME, ".cache"))
FLATTOO_CFG = os.path.join(CFG, "flattoo")
USER_LOOKS = os.path.join(FLATTOO_CFG, "looks")
XFCONF_DIR = os.path.join(CFG, "xfce4", "xfconf", "xfce-perchannel-xml")
PANEL_DIR = os.path.join(CFG, "xfce4", "panel")
SCHEDULE = os.path.join(FLATTOO_CFG, "schedule.json")
CURRENT = os.path.join(FLATTOO_CFG, "current-look")

CHANNELS = ["xsettings", "xfwm4", "xfce4-panel", "xfce4-desktop", "xfce4-keyboard-shortcuts",
            "keyboards", "thunar", "xfce4-screensaver", "xfce4-power-manager", "xfce4-notifyd"]

# Launchers by short name -> desktop id (what the panel launcher stores).
LAUNCHERS = {
    "menu": None,
    "copilot": "flattoo-copilot.desktop",
    "wiki": "flattoo-wiki.desktop",
    "apps": "flattoo-apps.desktop",
    "photos": "org.xfce.ristretto.desktop",
    "settings": "xfce-settings-manager.desktop",
    "print": "stencil-print.desktop",
    "portfolio": "flattoo-portfolio.desktop",
    "profile": "flattoo-profile.desktop",
    "krita": "org.kde.krita.desktop",
    "mypaint": "mypaint.desktop",
    "inkscape": "org.inkscape.Inkscape.desktop",
    "rnote": "com.github.flxzt.rnote.desktop",
    "azpainter": "azpainter.desktop",
    "gimp": "gimp.desktop",
    "xournalpp": "com.github.xournalpp.xournalpp.desktop",
    "files": "thunar.desktop",
    "scan": "simple-scan.desktop",
    "calibrate": "stencil-calibrate.desktop",
    "fix-printer": "stencil-fix-printer.desktop",
    "localsend": "LocalSend.desktop",
    "firefox": "firefox.desktop",
    "terminal": "xfce4-terminal.desktop",
    "looks": "flattoo-look.desktop",
    "layouts": "flattoo-layout.desktop",
    "gpick": "gpick.desktop",
    "client": "flattoo-showcase.desktop",  # hand the laptop to a client: portfolio, then lock
    "powersheet": "flattoo-power.desktop",  # the big Lock / Sleep / Restart / Shut down sheet
}


def run(cmd, **kw):
    return subprocess.run(cmd, text=True, capture_output=True, **kw)


def xq(channel, prop, *args):
    return run(["xfconf-query", "-c", channel, "-p", prop, *args])


def xq_set(channel, prop, typ, value):
    r = xq(channel, prop, "-n", "-t", typ, "-s", str(value))
    return r.returncode == 0


def xq_set_array(channel, prop, typ, values):
    args = ["xfconf-query", "-c", channel, "-p", prop, "-n", "-a"]
    for v in values:
        args += ["-t", typ, "-s", str(v)]
    return run(args).returncode == 0


def have_display():
    return bool(os.environ.get("DISPLAY")) and shutil.which("xfconf-query") is not None


# ------------------------------------------------------------------ presets

def preset_files():
    files = {}
    for d in (PRESETS_DIR, USER_LOOKS):
        for p in sorted(glob.glob(os.path.join(d, "*.json"))):
            files[os.path.splitext(os.path.basename(p))[0]] = p
    return files


def load_preset(name):
    files = preset_files()
    if name not in files:
        sys.exit(f"no look named {name!r}; have: {', '.join(files)}")
    with open(files[name]) as f:
        return json.load(f)


# ------------------------------------------------------------------ panel profile

POSITIONS = {  # xfce4-panel snap positions (panel-window.c)
    "top": "p=6;x=0;y=0", "top-center": "p=9;x=0;y=0", "bottom": "p=10;x=0;y=0",
    "bottom-center": "p=10;x=0;y=0", "left": "p=5;x=0;y=0", "right": "p=1;x=0;y=0",
}
WIDGETS = {  # item name -> (plugin type, props)
    "menu": ("whiskermenu", {}),
    "apps": ("launcher", {"items": ("as", ["flattoo-apps.desktop"])}),
    "sep": ("separator", {"style": ("uint32", 0)}),
    "line": ("separator", {"style": ("uint32", 1)}),
    "spacer": ("separator", {"expand": ("bool", True), "style": ("uint32", 0)}),
    "dock": ("docklike", {}),
    "tray": ("systray", {"square-icons": ("bool", True)}),
    "volume": ("pulseaudio", {"enable-keyboard-shortcuts": ("bool", True)}),
    "power": ("power-manager-plugin", {}),
    "showdesktop": ("showdesktop", {}),
}


def panel_items(panel):
    """The ordered plugin list for one panel: `items` as given, or the classic
    launchers + window list + tray + clock arrangement built from `launchers`."""
    if "items" in panel:
        names = panel["items"]
    else:
        names = list(panel.get("launchers", ["menu", "krita", "mypaint", "inkscape", "files", "scan", "calibrate", "localsend", "firefox"]))
        names += ["tasklist", "spacer", "tray", "volume", "power", "clock"] + (["showdesktop"] if panel.get("show_desktop", True) else [])
    plugins = []
    for name in names:
        if name == "tasklist":
            plugins.append(("tasklist", {"grouping": ("bool", True), "show-labels": ("bool", panel.get("show_labels", True))}))
        elif name == "clock":
            plugins.append(("clock", {"digital-layout": ("uint32", 3), "digital-time-format": ("s", panel.get("clock", "%a %b %-d  %-I:%M %p"))}))
        elif name in WIDGETS:
            plugins.append(WIDGETS[name])
        elif name in LAUNCHERS and LAUNCHERS[name]:
            plugins.append(("launcher", {"items": ("as", [LAUNCHERS[name]])}))
        elif name.endswith(".desktop"):
            plugins.append(("launcher", {"items": ("as", [name])}))
    return plugins


def panel_profile_tar(panel, out_path):
    """Build an xfce4-panel-profiles tarball from one panel description or a
    list of them (`panels` in a preset).

    panel = {"position": "top"|"bottom"|"bottom-center"|"left", "size": 40, "icon_size": 24,
             "dark": true, "autohide": false, "length": 100, "length_adjust": true,
             "background": [r, g, b, a] (translucent dock) or absent (theme),
             "launchers": ["menu","krita",...]  or  "items": ["apps","files","dock","spacer","tray","clock"],
             "clock": "%a %b %-d  %-I:%M %p", "show_labels": true}
    """
    panels = panel if isinstance(panel, list) else [panel]
    props = {"/configver": "2", "/panels": "[" + ", ".join(f"<{i}>" for i in range(1, len(panels) + 1)) + "]",
             "/panels/dark-mode": "true" if panels[0].get("dark", True) else "false"}
    desktops = {}
    pid = 0
    for n, pn in enumerate(panels, 1):
        plugins = panel_items(pn)
        ids = list(range(pid + 1, pid + 1 + len(plugins)))
        pid += len(plugins)
        pos = POSITIONS.get(pn.get("position", "top"), POSITIONS["top"])
        props.update({
            f"/panels/panel-{n}/position": f"'{pos}'",
            f"/panels/panel-{n}/length": f"uint32 {pn.get('length', 100)}",
            f"/panels/panel-{n}/length-adjust": "true" if pn.get("length_adjust", True) else "false",
            f"/panels/panel-{n}/position-locked": "true",
            f"/panels/panel-{n}/icon-size": f"uint32 {pn.get('icon_size', 24)}",
            f"/panels/panel-{n}/size": f"uint32 {pn.get('size', 40)}",
            f"/panels/panel-{n}/nrows": f"uint32 {pn.get('rows', 1)}",
            f"/panels/panel-{n}/autohide-behavior": f"uint32 {1 if pn.get('autohide') else 0}",
            f"/panels/panel-{n}/mode": f"uint32 {1 if pn.get('position') in ('left', 'right') else 0}",
            f"/panels/panel-{n}/plugin-ids": "[" + ", ".join(f"<{i}>" for i in ids) + "]",
        })
        if pn.get("background"):
            r, g, b, a = pn["background"]
            props[f"/panels/panel-{n}/background-style"] = "uint32 1"
            # xfconf arrays are arrays of variants; a bare [0.9, ...] (ad) crashes xfconfd
            props[f"/panels/panel-{n}/background-rgba"] = f"[<{r}>, <{g}>, <{b}>, <{a}>]"
        for i, (ptype, pprops) in zip(ids, plugins):
            props[f"/plugins/plugin-{i}"] = f"'{ptype}'"
            for k, (t, v) in pprops.items():
                if t == "as":
                    props[f"/plugins/plugin-{i}/{k}"] = "[" + ", ".join(f"'{x}'" for x in v) + "]"
                    for d in v:
                        desktops[f"launcher-{i}/{d}"] = find_desktop_file(d)
                elif t == "bool":
                    props[f"/plugins/plugin-{i}/{k}"] = "true" if v else "false"
                elif t == "uint32":
                    props[f"/plugins/plugin-{i}/{k}"] = f"uint32 {v}"
                elif t == "s":
                    props[f"/plugins/plugin-{i}/{k}"] = "'" + v.replace("'", "\\'") + "'"
    config = "\n".join(f"{k} {v}" for k, v in sorted(props.items())) + "\n"
    with tarfile.open(out_path, "w:bz2") as t:
        def add(name, data):
            ti = tarfile.TarInfo(name)
            ti.size = len(data)
            ti.mtime = int(time.time())
            t.addfile(ti, io.BytesIO(data))
        add("config.txt", config.encode())
        for arc, content in desktops.items():
            add(arc, content)
    return props


def find_desktop_file(desktop_id, stub=True):
    """Contents of a system .desktop file by id; a stub if not installed (or None)."""
    for base in os.environ.get("XDG_DATA_DIRS", "/run/current-system/sw/share:/usr/share").split(":"):
        p = os.path.join(base, "applications", desktop_id)
        if os.path.exists(p):
            with open(p, "rb") as f:
                return f.read()
    if not stub:
        return None
    name = desktop_id.rsplit(".desktop", 1)[0].split(".")[-1]
    return f"[Desktop Entry]\nType=Application\nName={name}\nExec={name}\nIcon={name}\n".encode()


# ------------------------------------------------------------------ apply (live)

def apply_live(p, quiet=False, scheduled=False):
    if not have_display():
        sys.exit("apply needs a running XFCE session (DISPLAY and xfconf-query)")
    say = (lambda *a: None) if quiet else print
    apply_effects(p.get("effects", "keep"))
    apply_palette(p.get("palette"), p.get("icon_theme"))
    apply_notify(p.get("notify"))
    apply_night_light(p.get("night_light"))
    if "gtk_theme" in p:
        xq_set("xsettings", "/Net/ThemeName", "string", p["gtk_theme"]); say("theme:", p["gtk_theme"])
    if "icon_theme" in p:
        xq_set("xsettings", "/Net/IconThemeName", "string", p["icon_theme"])
    if "cursor_theme" in p:
        xq_set("xsettings", "/Gtk/CursorThemeName", "string", p["cursor_theme"])
        xq_set("xsettings", "/Gtk/CursorThemeSize", "int", p.get("cursor_size", 24))
    if "font" in p:
        xq_set("xsettings", "/Gtk/FontName", "string", p["font"])
    if "dpi" in p:
        xq_set("xsettings", "/Xft/DPI", "int", p["dpi"])
    if "xfwm_theme" in p:
        xq_set("xfwm4", "/general/theme", "string", p["xfwm_theme"])
    if "title_font" in p:
        xq_set("xfwm4", "/general/title_font", "string", p["title_font"])
    for k, v in p.get("xfwm", {}).items():
        typ = "bool" if isinstance(v, bool) else "int" if isinstance(v, int) else "string"
        xq_set("xfwm4", f"/general/{k}", typ, str(v).lower() if isinstance(v, bool) else v)
    ws = p.get("workspaces")
    if ws:
        xq_set("xfwm4", "/general/workspace_count", "int", ws.get("count", len(ws.get("names", [])) or 1))
        if ws.get("names"):
            xq_set_array("xfwm4", "/general/workspace_names", "string", ws["names"])
    if "wallpaper" in p:
        set_wallpaper(resolve_wallpaper(p["wallpaper"]))
    if "panels" in p:
        apply_panel(p["panels"])
    elif "panel" in p:
        apply_panel(p["panel"])
    if "keyboard" in p:
        for combo, cmd in p["keyboard"].items():
            xq_set("xfce4-keyboard-shortcuts", f"/commands/custom/{combo}", "string", cmd)
    for channel, prop, typ, value in p.get("xfconf", []):
        xq_set(channel, prop, typ, value)
    apply_app_names(p.get("app_names"))
    apply_desktop_launchers(p.get("desktop_launchers"))
    if p.get("name"):
        os.makedirs(FLATTOO_CFG, exist_ok=True)
        with open(CURRENT, "w") as f:
            f.write(p["name"] + "\n")
        if not scheduled:
            schedule_note_choice(p["name"])
    say("applied", p.get("name", ""))


def current_look():
    try:
        with open(CURRENT) as f:
            return f.read().strip() or None
    except OSError:
        return None


# ------------------------------------------------------------------ effects (picom)

PICOM_DEFAULTS = {"corners": 12, "shadows": True, "blur": True, "animations": True, "fade": True,
                  "inactive_opacity": 1.0, "shadow_opacity": 0.35, "shadow_color": "#000000"}


def picom_config(effects, xrender=False):
    """A picom.conf for one look. The xrender variant is what the compositor
    falls back to when GL is unavailable: no blur (dual_kawase needs GL)."""
    e = dict(PICOM_DEFAULTS, **effects)
    corners = int(e["corners"])
    blur = bool(e["blur"]) and not xrender
    lines = [
        f"# generated by flattoo-look ({'xrender' if xrender else 'glx'} variant) — do not edit, change the look instead",
        "vsync = true;",
        "use-damage = true;",
        "detect-client-opacity = true;",
        "detect-transient = true;",
        "unredir-if-possible = false;",
        f"corner-radius = {corners};",
        f"shadow = {'true' if e['shadows'] else 'false'};",
        "shadow-radius = 22;",
        f"shadow-opacity = {float(e['shadow_opacity']):.2f};",
        "shadow-offset-x = -22;",
        "shadow-offset-y = -16;",
        f"shadow-color = \"{e['shadow_color']}\";",
        f"fading = {'true' if e['fade'] else 'false'};",
        "fade-in-step = 0.07;",
        "fade-out-step = 0.07;",
        "fade-delta = 8;",
    ]
    if blur:
        lines += ["blur-method = \"dual_kawase\";", "blur-strength = 6;", "blur-background = true;",
                  "blur-background-frame = false;", "blur-background-fixed = false;"]
    if e["animations"]:
        lines += [
            "animations = (",
            "  { triggers = [\"open\", \"show\"]; preset = \"appear\"; scale = 0.94; duration = 0.16; },",
            "  { triggers = [\"close\", \"hide\"]; preset = \"disappear\"; scale = 0.94; duration = 0.14; }",
            ");",
        ]
    inactive = float(e["inactive_opacity"])
    rules = [
        "{ match = \"window_type = 'desktop'\"; shadow = false; corner-radius = 0; blur-background = false; fade = false; }",
        # a centred dock floats: rounded with a shadow; a full-width bar stays square
        f"{{ match = \"window_type = 'dock' && width <= 900\"; shadow = {'true' if e['shadows'] else 'false'}; corner-radius = {max(corners, 16) if corners else 0}; blur-background = {'true' if blur else 'false'}; }}",
        f"{{ match = \"window_type = 'dock' && width > 900\"; shadow = false; corner-radius = 0; blur-background = {'true' if blur else 'false'}; }}",
        "{ match = \"window_type = 'tooltip'\"; shadow = false; corner-radius = 8; opacity = 0.96; blur-background = false; }",
        f"{{ match = \"window_type = 'menu' || window_type = 'dropdown_menu' || window_type = 'popup_menu' || window_type = 'combo'\"; corner-radius = {min(corners, 10)}; blur-background = false; }}",
        f"{{ match = \"window_type = 'notification'\"; corner-radius = {max(corners, 14) if corners else 0}; blur-background = {'true' if blur else 'false'}; }}",
        "{ match = \"window_type = 'dnd'\"; shadow = false; corner-radius = 0; blur-background = false; }",
        "{ match = \"class_g = 'Rofi'\"; corner-radius = 0; shadow = false; }",
        "{ match = \"class_g = 'xfce4-screensaver' || class_g = 'Xfce4-screensaver' || class_g = 'Xfwm4'\"; shadow = false; corner-radius = 0; blur-background = false; fade = false; }",
        "{ match = \"fullscreen\"; corner-radius = 0; shadow = false; }",
    ]
    if inactive < 1.0:
        rules.append(f"{{ match = \"window_type = 'normal' && !focused\"; opacity = {inactive:.2f}; }}")
    lines += ["rules = (", ",\n".join("  " + r for r in rules), ");", ""]
    return "\n".join(lines)


def apply_effects(effects):
    """effects: dict (picom with these settings), False (xfwm's compositor), or "keep"."""
    if effects == "keep":
        return
    os.makedirs(FLATTOO_CFG, exist_ok=True)
    if effects is False or effects is None:
        with open(os.path.join(FLATTOO_CFG, "compositor"), "w") as f:
            f.write("xfwm\n")
        run(["flattoo-compositor", "off"])
        return
    if effects is True:
        effects = {}
    with open(os.path.join(FLATTOO_CFG, "picom.conf"), "w") as f:
        f.write(picom_config(effects))
    with open(os.path.join(FLATTOO_CFG, "picom-xrender.conf"), "w") as f:
        f.write(picom_config(effects, xrender=True))
    with open(os.path.join(FLATTOO_CFG, "compositor"), "w") as f:
        f.write("picom\n")
    run(["flattoo-compositor", "restart"])


# ------------------------------------------------------------------ notifications, night light

NOTIFY_POSITIONS = {"top-left": 0, "bottom-left": 1, "top-right": 2, "bottom-right": 3, "top-center": 4, "bottom-center": 5}


NOTIFY_CSS = """/* written by flattoo-look from the current look's palette */
#XfceNotifyWindow {{
    background-color: {bg};
    color: {fg};
    border-radius: {radius}px;
    border: 1px solid {border};
    padding: 14px 18px;
}}
#XfceNotifyWindow:hover {{ border-color: {accent}; }}
#XfceNotifyWindow label, #XfceNotifyWindow image {{ color: {fg}; }}
#XfceNotifyWindow label#summary {{ font-weight: 600; font-size: 1.05em; }}
#XfceNotifyWindow label#body {{ color: {muted}; }}
#XfceNotifyWindow button {{
    border-style: none; background-image: none;
    background-color: {accent}; color: {on_accent};
    border-radius: 999px; padding: 4px 14px; margin: 2px;
}}
#XfceNotifyWindow button:hover {{ background-image: none; background-color: {border}; color: {fg}; }}
#XfceNotifyWindow progressbar trough {{ background-color: {border}; border-style: none; border-radius: 999px; min-height: 6px; }}
#XfceNotifyWindow progressbar progress {{ background-image: none; background-color: {accent}; border-style: none; border-radius: 999px; min-height: 6px; }}
"""

ROFI_CSS = """/* written by flattoo-look from the current look's palette */
configuration {{ icon-theme: "{icon_theme}"; }}
* {{ text-color: {fg}; }}
window {{ background-color: {rofi_bg}; }}
inputbar {{ background-color: {card}; }}
element selected {{ background-color: {card}; }}
entry {{ placeholder-color: {muted}; }}
prompt {{ text-color: {muted}; }}
"""

PALETTE_DEFAULTS = {"bg": "#f7f7fa", "fg": "#1c1c1e", "muted": "#6b6b73", "accent": "#2f6fed", "on_accent": "#ffffff",
                    "border": "#d9d9e0", "card": "rgba(255, 255, 255, 0.75)", "rofi_bg": "rgba(245, 245, 250, 0.90)", "radius": 18}
USER_THEMES = os.path.join(os.environ.get("XDG_DATA_HOME", os.path.join(HOME, ".local", "share")), "themes")


def apply_palette(pal, icon_theme=None):
    """One palette per look drives the notification bubbles (an xfce4-notifyd
    theme written to ~/.local/share/themes/Flattoo) and the app grid / power
    sheet colours (a rofi theme fragment the launchers read)."""
    if not pal:
        return
    c = dict(PALETTE_DEFAULTS, **pal)
    c["icon_theme"] = icon_theme or xq("xsettings", "/Net/IconThemeName").stdout.strip() or "Adwaita"
    write_notify_theme(NOTIFY_CSS.format(**c))
    os.makedirs(FLATTOO_CFG, exist_ok=True)
    with open(os.path.join(FLATTOO_CFG, "rofi-colors.rasi"), "w") as f:
        f.write(ROFI_CSS.format(**c))


def write_notify_theme(css):
    """xfce4-notifyd looks in ~/.themes and the XDG data dirs; write both so
    the bubbles follow the look wherever libxfce4util decides to look."""
    for base in (USER_THEMES, os.path.join(HOME, ".themes")):
        d = os.path.join(base, "Flattoo", "xfce-notify-4.0")
        os.makedirs(d, exist_ok=True)
        with open(os.path.join(d, "gtk.css"), "w") as f:
            f.write(css)


def apply_notify(n):
    """xfce4-notifyd: the bubble theme (share/themes/<name>/xfce-notify-4.0),
    where bubbles appear, how solid they are."""
    if not n:
        return
    theme = n.get("theme") or ("Flattoo" if os.path.exists(os.path.join(USER_THEMES, "Flattoo", "xfce-notify-4.0", "gtk.css")) else None)
    if theme:
        xq_set("xfce4-notifyd", "/theme", "string", theme)
    if n.get("position") in NOTIFY_POSITIONS:
        xq_set("xfce4-notifyd", "/notify-location", "uint", NOTIFY_POSITIONS[n["position"]])
    if "opacity" in n:
        xq_set("xfce4-notifyd", "/initial-opacity", "double", f"{float(n['opacity']):.2f}")
    xq_set("xfce4-notifyd", "/do-fadeout", "bool", "true")
    xq_set("xfce4-notifyd", "/do-slideout", "bool", "true" if n.get("slide", True) else "false")


def apply_night_light(kelvin):
    """A warm screen for the evening looks (redshift one-shot); neutral otherwise."""
    if not shutil.which("redshift"):
        return
    if kelvin:
        run(["redshift", "-P", "-O", str(int(kelvin))])
    else:
        run(["redshift", "-x"])


# ------------------------------------------------------------------ automatic night look

def load_schedule():
    try:
        with open(SCHEDULE) as f:
            s = json.load(f)
    except (OSError, ValueError):
        s = {}
    s.setdefault("enabled", False)
    s.setdefault("night", "20:00")
    s.setdefault("day", "07:00")
    s.setdefault("day_look", None)
    return s


def save_schedule(s):
    os.makedirs(FLATTOO_CFG, exist_ok=True)
    with open(SCHEDULE, "w") as f:
        json.dump(s, f, indent=2)


def schedule_note_choice(name):
    """A look picked by hand becomes the day look, unless it is just the
    night twin of the current day look (the daemon switching, or the artist
    toggling dark by hand in the evening)."""
    s = load_schedule()
    if not s["enabled"]:
        return
    files = preset_files()
    day = s.get("day_look")
    if day and day in files:
        with open(files[day]) as f:
            if json.load(f).get("night") == name:
                return
    if name != day:
        s["day_look"] = name
        save_schedule(s)


def hhmm(s):
    h, m = s.split(":")
    return int(h) * 60 + int(m)


def is_night(s, now_minutes):
    night, day = hhmm(s["night"]), hhmm(s["day"])
    if night == day:
        return False
    if night > day:  # 20:00 .. 07:00 wraps midnight
        return now_minutes >= night or now_minutes < day
    return night <= now_minutes < day


def schedule_decide(s, now_minutes):
    """What the daemon would apply right now: (phase, look-or-None, kelvin-or-None).
    Looks without a night twin keep their colours and just get a warm screen."""
    phase = "night" if is_night(s, now_minutes) else "day"
    day_look = s.get("day_look") or current_look()
    if not day_look:
        return phase, None, None
    files = preset_files()
    if day_look not in files:
        return phase, None, None
    with open(files[day_look]) as f:
        p = json.load(f)
    if phase == "night":
        twin = p.get("night")
        if twin and twin in files:
            return phase, twin, None
        return phase, None, int(s.get("kelvin", 3800))
    return phase, day_look, None


def schedule_tick(now_minutes=None, dry=False):
    s = load_schedule()
    if not s["enabled"]:
        return "off"
    if now_minutes is None:
        t = time.localtime()
        now_minutes = t.tm_hour * 60 + t.tm_min
    phase, look, kelvin = schedule_decide(s, now_minutes)
    state_path = os.path.join(CACHE, "flattoo", "schedule-state")
    try:
        with open(state_path) as f:
            last = f.read().strip()
    except OSError:
        last = ""
    want = f"{phase}:{look or ''}:{kelvin or ''}"
    if want == last:
        return "same " + want
    if not dry:
        if look:
            apply_live(load_preset(look), quiet=True, scheduled=True)
        elif kelvin:
            apply_night_light(kelvin)
        if phase == "day" and not look:
            apply_night_light(None)
        os.makedirs(os.path.dirname(state_path), exist_ok=True)
        with open(state_path, "w") as f:
            f.write(want)
    return "apply " + want


def schedule_daemon():
    """Runs for the session (autostart): checks the clock every 30 s. Does
    nothing until the schedule is switched on. Waits out the first-login
    seed before its first look at the clock."""
    time.sleep(90)
    while True:
        try:
            r = schedule_tick()
            if r.startswith("apply"):
                phase = r.split()[1].split(":")[0]
                run(["notify-send", "-a", "Flattoo", "-i", "weather-clear-night" if phase == "night" else "weather-clear",
                     "Night look" if phase == "night" else "Day look", "Switched automatically. Looks → “Automatic night look” changes the times."])
        except Exception as ex:  # keep the loop alive whatever a single apply does
            print("schedule:", ex, file=sys.stderr)
        time.sleep(30)


# Familiar names: the same apps, called what a phone or a Windows/Mac user
# expects, with the icon theme's standard glyphs (the office documents come
# out in the familiar blue/green/orange). Per user, in ~/.local/share/applications,
# marked so a look without them removes them again.
FAMILIAR = {
    "thunar.desktop": ("Files", "system-file-manager"),
    "org.xfce.ristretto.desktop": ("Photos", "multimedia-photo-viewer"),
    "simple-scan.desktop": ("Scanner", "scanner"),
    "xfce-settings-manager.desktop": ("Settings", "preferences-system"),
    "com.github.flxzt.rnote.desktop": ("Notes", "accessories-text-editor"),
    "startcenter.desktop": ("Office", "x-office-document"),
    "libreoffice-writer.desktop": ("Documents", "x-office-document"),
    "libreoffice-calc.desktop": ("Spreadsheets", "x-office-spreadsheet"),
    "libreoffice-impress.desktop": ("Slides", "x-office-presentation"),
    "thunderbird.desktop": ("Mail", "internet-mail"),
    "signal.desktop": ("Messages", "internet-chat"),
    "org.gnome.Calendar.desktop": ("Calendar", "x-office-calendar"),
    "org.gnome.Calculator.desktop": ("Calculator", "accessories-calculator"),
    "xfce4-terminal.desktop": ("Terminal", "utilities-terminal"),
    "flattoo-wiki.desktop": ("Help", "help-browser"),
}
USER_APPS = os.path.join(os.environ.get("XDG_DATA_HOME", os.path.join(HOME, ".local", "share")), "applications")
MARK = "X-Flattoo-Familiar=true"


def apply_app_names(mode):
    os.makedirs(USER_APPS, exist_ok=True)
    for f in os.listdir(USER_APPS):
        path = os.path.join(USER_APPS, f)
        try:
            with open(path, errors="replace") as fh:
                if MARK in fh.read():
                    os.unlink(path)
        except OSError:
            pass
    if mode != "familiar":
        return
    for desktop_id, (name, icon) in FAMILIAR.items():
        src = find_desktop_file(desktop_id, stub=False)
        if not src:
            continue
        out = []
        in_main = False
        for line in src.decode(errors="replace").splitlines():
            if line.startswith("["):
                in_main = line.strip() == "[Desktop Entry]"
                out.append(line)
                if in_main:
                    out.append(MARK)
                continue
            if in_main and re.match(r"(Name|Icon)=", line):
                continue
            if in_main and line.startswith("Name["):
                continue
            out.append(line)
        at = out.index(MARK) + 1 if MARK in out else 0
        out.insert(at, f"Icon={icon}")
        out.insert(at, f"Name={name}")
        with open(os.path.join(USER_APPS, desktop_id), "w") as fh:
            fh.write("\n".join(out) + "\n")


def apply_desktop_launchers(ids):
    """App icons on the desktop (the phone-style home screen). Managed files
    only: launchers we put there are marked and removed by looks without them."""
    desk = os.path.join(HOME, "Desktop")
    os.makedirs(desk, exist_ok=True)
    for f in os.listdir(desk):
        path = os.path.join(desk, f)
        if f.endswith(".desktop"):
            try:
                with open(path, errors="replace") as fh:
                    if "X-Flattoo-Home=true" in fh.read():
                        os.unlink(path)
            except OSError:
                pass
    if not ids:
        return
    for name in ids:
        desktop_id = LAUNCHERS.get(name, name if name.endswith(".desktop") else None)
        if not desktop_id:
            continue
        src = None
        override = os.path.join(USER_APPS, desktop_id)  # the familiar name, when the look uses them
        if os.path.exists(override):
            with open(override, "rb") as fh:
                src = fh.read()
        src = src or find_desktop_file(desktop_id, stub=False)
        if not src:
            continue
        text = src.decode(errors="replace").replace("[Desktop Entry]", "[Desktop Entry]\nX-Flattoo-Home=true", 1)
        path = os.path.join(desk, desktop_id)
        with open(path, "w") as fh:
            fh.write(text)
        os.chmod(path, 0o755)
        # xfdesktop trusts a launcher whose checksum it has seen
        h = hashlib.sha256(text.encode()).hexdigest()
        run(["gio", "set", "-t", "string", path, "metadata::xfce-exe-checksum", h])


def resolve_wallpaper(name):
    if os.path.isabs(name):
        return name
    for d in (WALLPAPER_DIR, os.path.join(HOME, "Pictures", "Wallpapers")):
        for ext in ("", ".png", ".jpg"):
            cand = os.path.join(d, name + ext)
            if os.path.exists(cand):
                return cand
    return name


def set_wallpaper(path):
    """Every backdrop property xfdesktop already has, plus one per connected
    monitor and workspace (a fresh profile has none yet)."""
    out = run(["xfconf-query", "-c", "xfce4-desktop", "-l"]).stdout
    props = {l.strip() for l in out.splitlines() if l.strip().endswith("/last-image")}
    mons = re.findall(r"^\s*\d+:\s+\+?\*?(\S+)", run(["xrandr", "--listmonitors"]).stdout, re.M)
    for m in mons or ["0"]:
        for ws in range(4):
            props.add(f"/backdrop/screen0/monitor{m}/workspace{ws}/last-image")
    for prop in sorted(props):
        xq_set("xfce4-desktop", prop, "string", path)
        xq_set("xfce4-desktop", prop.replace("last-image", "image-style"), "int", 5)  # zoomed
    run(["xfdesktop", "--reload"])


def apply_panel(panel):
    with tempfile.NamedTemporaryFile(suffix=".tar.bz2", delete=False) as tf:
        path = tf.name
    panel_profile_tar(panel, path)
    if shutil.which("xfce4-panel-profiles"):
        r = run(["xfce4-panel-profiles", "load", path])
        if r.returncode != 0:
            print("panel profile load failed:", r.stderr.strip()[-300:], file=sys.stderr)
    else:
        print("xfce4-panel-profiles not installed; panel unchanged", file=sys.stderr)
    os.unlink(path)


# ------------------------------------------------------------------ capture

def capture_dict():
    """Current look as a preset dict (what `save` writes)."""
    def get(channel, prop):
        r = xq(channel, prop)
        return r.stdout.strip() if r.returncode == 0 else None
    d = {"name": "custom", "captured": time.strftime("%Y-%m-%d %H:%M")}
    for key, ch, prop in (("gtk_theme", "xsettings", "/Net/ThemeName"), ("icon_theme", "xsettings", "/Net/IconThemeName"),
                          ("cursor_theme", "xsettings", "/Gtk/CursorThemeName"), ("font", "xsettings", "/Gtk/FontName"),
                          ("xfwm_theme", "xfwm4", "/general/theme"), ("title_font", "xfwm4", "/general/title_font")):
        v = get(ch, prop)
        if v:
            d[key] = v
    dpi = get("xsettings", "/Xft/DPI")
    if dpi and dpi.lstrip("-").isdigit() and int(dpi) > 0:
        d["dpi"] = int(dpi)
    cnt = get("xfwm4", "/general/workspace_count")
    names = run(["xfconf-query", "-c", "xfwm4", "-p", "/general/workspace_names"]).stdout
    names = [l.strip() for l in names.splitlines() if l.strip() and not l.startswith("Value is an array")]
    if cnt and cnt.isdigit():
        d["workspaces"] = {"count": int(cnt), "names": names[: int(cnt)]}
    wp = None
    for l in run(["xfconf-query", "-c", "xfce4-desktop", "-l"]).stdout.splitlines():
        if l.strip().endswith("/last-image"):
            wp = get("xfce4-desktop", l.strip())
            break
    if wp:
        d["wallpaper"] = wp
    cur = current_look()
    if effects_mode() == "xfwm":
        d["effects"] = False
    elif cur and cur in preset_files():
        e = load_preset(cur).get("effects")
        if isinstance(e, dict):
            d["effects"] = e
        if load_preset(cur).get("night_light"):
            d["night_light"] = load_preset(cur)["night_light"]
    nt = get("xfce4-notifyd", "/theme")
    if nt:
        d["notify"] = {"theme": nt}
    return d


def export_bundle(dest):
    """Copy the config files that make up the current desktop into dest/."""
    os.makedirs(dest, exist_ok=True)
    copied = []
    xdest = os.path.join(dest, "xfce-perchannel-xml")
    os.makedirs(xdest, exist_ok=True)
    for ch in CHANNELS:
        src = os.path.join(XFCONF_DIR, ch + ".xml")
        if os.path.exists(src):
            shutil.copy2(src, xdest)
            copied.append(ch + ".xml")
    if os.path.isdir(PANEL_DIR):
        shutil.copytree(PANEL_DIR, os.path.join(dest, "panel"), dirs_exist_ok=True)
        copied.append("panel/")
    for rel in ("flattoo/layouts", "flattoo/looks", "flattoo/picom.conf", "flattoo/picom-xrender.conf", "flattoo/compositor",
                "flattoo/rofi-colors.rasi", "flattoo/schedule.json", "flattoo/display.json", "flattoo/current-look",
                "Thunar/uca.xml", "mimeapps.list", "kritarc", "xfce4/helpers.rc", "xfce4/terminal/terminalrc"):
        src = os.path.join(CFG, rel)
        if os.path.isdir(src):
            shutil.copytree(src, os.path.join(dest, "config", rel), dirs_exist_ok=True); copied.append(rel + "/")
        elif os.path.exists(src):
            os.makedirs(os.path.dirname(os.path.join(dest, "config", rel)), exist_ok=True)
            shutil.copy2(src, os.path.join(dest, "config", rel)); copied.append(rel)
    theme = os.path.join(USER_THEMES, "Flattoo")  # the notification bubbles of the current look
    if os.path.isdir(theme):
        shutil.copytree(theme, os.path.join(dest, "data", "themes", "Flattoo"), dirs_exist_ok=True)
        copied.append("data/themes/Flattoo/")
    with open(os.path.join(dest, "look.json"), "w") as f:
        json.dump(capture_dict() if have_display() else {"name": "custom"}, f, indent=2)
    with open(os.path.join(dest, "MANIFEST"), "w") as f:
        f.write("\n".join(copied) + "\n")
    return copied


def restore_files(src):
    """Write a bundle into ~/.config. Meant to run before xfconfd starts (sessionCommands)."""
    xsrc = os.path.join(src, "xfce-perchannel-xml")
    if os.path.isdir(xsrc):
        os.makedirs(XFCONF_DIR, exist_ok=True)
        for p in glob.glob(os.path.join(xsrc, "*.xml")):
            shutil.copy2(p, XFCONF_DIR)
    psrc = os.path.join(src, "panel")
    if os.path.isdir(psrc):
        if os.path.isdir(PANEL_DIR):
            shutil.rmtree(PANEL_DIR)
        shutil.copytree(psrc, PANEL_DIR)
    for sub, base in (("config", CFG), ("data", os.path.dirname(USER_THEMES))):
        csrc = os.path.join(src, sub)
        if os.path.isdir(csrc):
            for root, _dirs, files in os.walk(csrc):
                for fn in files:
                    rel = os.path.relpath(os.path.join(root, fn), csrc)
                    dst = os.path.join(base, rel)
                    os.makedirs(os.path.dirname(dst), exist_ok=True)
                    shutil.copy2(os.path.join(root, fn), dst)
    css = os.path.join(src, "data", "themes", "Flattoo", "xfce-notify-4.0", "gtk.css")
    if os.path.exists(css):
        with open(css) as f:
            write_notify_theme(f.read())
    return True


# ------------------------------------------------------------------ gui

def gui():
    files = preset_files()
    rows = []
    for name, path in files.items():
        with open(path) as f:
            p = json.load(f)
        rows += [name, p.get("title", name), p.get("description", "")]
    s = load_schedule()
    auto = f"on: dark from {s['night']} to {s['day']}" if s["enabled"] else "off"
    fx = "off" if effects_mode() == "xfwm" else "on"
    rows += ["__save__", "Save my current look…", "Snapshot the desktop as it is now into a new look",
             "__auto__", "Automatic night look…", f"Switch to this look's dark twin in the evening ({auto})",
             "__effects__", "Window effects", f"Rounded corners, shadows, blur, animations ({fx}). Turn off if the laptop feels slow."]
    r = run(["zenity", "--list", "--title=Looks", "--width=680", "--height=480",
             "--text=Pick a look. Everything changes at once: colors, icons, panel, wallpaper, workspaces.",
             "--column=id", "--column=Look", "--column=What it is", "--hide-column=1", "--print-column=1", *rows])
    if r.returncode != 0 or not r.stdout.strip():
        return 1
    pick = r.stdout.strip()
    if pick == "__auto__":
        return schedule_gui()
    if pick == "__effects__":
        on = fx == "off"
        set_effects(on)
        run(["notify-send", "-a", "Flattoo", "Window effects " + ("on" if on else "off"), "Looks → Window effects toggles them again."])
        return 0
    if pick == "__save__":
        r = run(["zenity", "--entry", "--title=Save look", "--text=Name for this look:"])
        if r.returncode != 0 or not r.stdout.strip():
            return 1
        name = re.sub(r"[^A-Za-z0-9 _-]", "", r.stdout.strip()).strip().replace(" ", "-").lower()
        os.makedirs(USER_LOOKS, exist_ok=True)
        d = capture_dict(); d["name"] = name; d["title"] = r.stdout.strip(); d["description"] = "Saved " + d["captured"]
        with open(os.path.join(USER_LOOKS, name + ".json"), "w") as f:
            json.dump(d, f, indent=2)
        run(["notify-send", "-a", "Flattoo", "Look saved", d["title"]])
        return 0
    apply_live(load_preset(pick), quiet=True)
    run(["notify-send", "-a", "Flattoo", "Look applied", files and pick])
    return 0


def effects_mode():
    try:
        with open(os.path.join(FLATTOO_CFG, "compositor")) as f:
            return f.read().strip() or "picom"
    except OSError:
        return "picom"


def set_effects(on):
    """Window effects on or off, keeping the current look's settings for them."""
    if not on:
        apply_effects(False)
        return
    name = current_look()
    effects = {}
    if name and name in preset_files():
        e = load_preset(name).get("effects")
        effects = e if isinstance(e, dict) else {}
    apply_effects(effects)


def schedule_gui():
    s = load_schedule()
    r = run(["zenity", "--forms", "--title=Automatic night look", "--width=460",
             "--text=In the evening the desktop switches to this look's dark twin (Home → Home Dark, Sakura → Sakura Night…). Looks without a twin just get a warmer screen.\nTimes as HH:MM, 24-hour.",
             "--add-combo=Automatic night look", "--combo-values=on|off",
             "--add-entry=Dark from", "--add-entry=Back to the day look at", "--separator=|"])
    if r.returncode != 0:
        return 1
    parts = (r.stdout.strip().split("|") + ["", "", ""])[:3]
    on = (parts[0] or ("on" if s["enabled"] else "off")) == "on"
    for key, val in (("night", parts[1]), ("day", parts[2])):
        val = val.strip()
        if val:
            if not re.fullmatch(r"\d{1,2}:\d{2}", val) or hhmm(val) >= 24 * 60 or int(val.split(":")[1]) >= 60:
                run(["zenity", "--error", "--title=Automatic night look", f"--text=“{val}” is not a time. Use HH:MM, like 20:30."])
                return 1
            s[key] = f"{hhmm(val) // 60:02d}:{hhmm(val) % 60:02d}"
    s["enabled"] = on
    if on and not s.get("day_look"):
        s["day_look"] = current_look()
    save_schedule(s)
    if on:
        schedule_tick()
    run(["notify-send", "-a", "Flattoo", "Automatic night look " + ("on" if on else "off"),
         f"Dark from {s['night']} to {s['day']}." if on else "The look stays as you set it."])
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser(prog="flattoo-look", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("gui"); sub.add_parser("list"); sub.add_parser("current"); sub.add_parser("current-name")
    tw = sub.add_parser("twin", help="the dark twin of a look, or the day look a dark twin belongs to"); tw.add_argument("name"); tw.add_argument("mode", choices=["dark", "light"])
    a = sub.add_parser("apply"); a.add_argument("name")
    s = sub.add_parser("save"); s.add_argument("name")
    e = sub.add_parser("export"); e.add_argument("dir")
    r = sub.add_parser("restore-files"); r.add_argument("dir")
    t = sub.add_parser("panel-tar"); t.add_argument("name"); t.add_argument("out")
    pc = sub.add_parser("picom-conf", help="print the picom config a look generates"); pc.add_argument("name"); pc.add_argument("--xrender", action="store_true")
    fx = sub.add_parser("effects"); fx.add_argument("state", choices=["on", "off", "status"])
    sc = sub.add_parser("schedule"); sc.add_argument("what", choices=["set", "off", "on", "status", "daemon", "tick", "gui"])
    sc.add_argument("night", nargs="?", help="HH:MM the dark twin comes on (set)")
    sc.add_argument("day", nargs="?", help="HH:MM the day look returns (set)")
    sc.add_argument("--now", help="HH:MM instead of the clock (tick)")
    sc.add_argument("--dry-run", action="store_true", help="say what tick would do, change nothing")
    args = ap.parse_args(argv)

    if args.cmd == "gui":
        return gui()
    if args.cmd == "picom-conf":
        p = load_preset(args.name)
        e = p.get("effects", {})
        if e is False:
            print("# this look uses xfwm's own compositor"); return 0
        print(picom_config(e if isinstance(e, dict) else {}, xrender=args.xrender)); return 0
    if args.cmd == "effects":
        if args.state == "status":
            print(effects_mode()); return 0
        set_effects(args.state == "on"); print("effects", args.state); return 0
    if args.cmd == "schedule":
        if args.what == "gui":
            return schedule_gui()
        if args.what == "daemon":
            schedule_daemon(); return 0
        if args.what == "tick":
            now = hhmm(args.now) if args.now else None
            print(schedule_tick(now, dry=args.dry_run)); return 0
        s = load_schedule()
        if args.what == "status":
            print(json.dumps(s, indent=2)); return 0
        if args.what == "off":
            s["enabled"] = False; save_schedule(s); print("automatic night look off"); return 0
        if args.what in ("set", "on"):
            for key, val in (("night", args.night), ("day", args.day)):
                if val:
                    if not re.fullmatch(r"\d{1,2}:\d{2}", val) or hhmm(val) >= 24 * 60 or int(val.split(":")[1]) >= 60:
                        sys.exit(f"not a time: {val!r} (HH:MM)")
                    s[key] = f"{hhmm(val) // 60:02d}:{hhmm(val) % 60:02d}"
            s["enabled"] = True
            if not s.get("day_look"):
                s["day_look"] = current_look()
            save_schedule(s)
            print(f"automatic night look on: dark from {s['night']} to {s['day']}")
            if have_display():
                print(schedule_tick())
            return 0
    if args.cmd == "list":
        for name, path in preset_files().items():
            with open(path) as f:
                p = json.load(f)
            print(f"{name:18s} {p.get('title', '')}  — {p.get('description', '')}")
        return 0
    if args.cmd == "current":
        print(json.dumps(capture_dict(), indent=2)); return 0
    if args.cmd == "current-name":
        print(current_look() or ""); return 0
    if args.cmd == "twin":
        files = preset_files()
        if args.name not in files:
            return 1
        if args.mode == "dark":
            twin = load_preset(args.name).get("night")
            print(twin if twin in files else ""); return 0
        for name in files:
            if load_preset(name).get("night") == args.name:
                print(name); return 0
        print(""); return 0
    if args.cmd == "apply":
        apply_live(load_preset(args.name)); return 0
    if args.cmd == "save":
        os.makedirs(USER_LOOKS, exist_ok=True)
        d = capture_dict(); d["name"] = args.name; d["title"] = args.name
        with open(os.path.join(USER_LOOKS, args.name + ".json"), "w") as f:
            json.dump(d, f, indent=2)
        print("saved", os.path.join(USER_LOOKS, args.name + ".json")); return 0
    if args.cmd == "export":
        print("\n".join(export_bundle(args.dir))); return 0
    if args.cmd == "restore-files":
        restore_files(args.dir); return 0
    if args.cmd == "panel-tar":
        pr = load_preset(args.name)
        panel_profile_tar(pr.get("panels") or pr.get("panel", {}), args.out); print(args.out); return 0
    return 2


if __name__ == "__main__":
    sys.exit(main())
