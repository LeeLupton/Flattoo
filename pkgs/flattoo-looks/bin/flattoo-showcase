#!/usr/bin/env python3
"""The laptop as a shop display, and handing it to a client.

  flattoo-showcase gui                menu entry "Show a client": confirm, then client mode
  flattoo-showcase client [FOLDER]    full-screen slideshow of the portfolio: tap or swipe
                                      to move on, a Done button (or Esc) ends it and LOCKS
                                      the laptop, so a client can browse and nothing else.
                                      Notifications are muted meanwhile.
  flattoo-showcase display on|off     shop display: when the laptop sits idle, the
                                      screensaver shows the portfolio instead of going black
  flattoo-showcase display status|gui
  flattoo-showcase slideshow          (internal) the screensaver theme itself

The portfolio is what Portfolio built (~/Portfolio/<date>/web); a folder of
your own can be chosen instead. Nothing leaves the laptop.
"""
import argparse
import glob
import json
import os
import shutil
import subprocess
import sys

HOME = os.path.expanduser("~")
CFG = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config")), "flattoo")
DISPLAY_CFG = os.path.join(CFG, "display.json")
PORTFOLIO = os.path.join(HOME, "Portfolio")
SLIDESHOW = "@slideshow@"  # xfce4-screensaver's slideshow helper
EXTS = (".jpg", ".jpeg", ".png", ".webp")


def run(cmd, **kw):
    try:
        return subprocess.run(cmd, text=True, capture_output=True, **kw)
    except OSError as ex:
        return subprocess.CompletedProcess(cmd, 1, "", str(ex))


def zenity(*args):
    return run(["zenity", *args])


def xq(channel, prop, typ, value):
    return run(["xfconf-query", "-c", channel, "-p", prop, "-n", "-t", typ, "-s", str(value)]).returncode == 0


def xq_array(channel, prop, typ, values):
    cmd = ["xfconf-query", "-c", channel, "-p", prop, "-n", "-a"]
    for v in values:
        cmd += ["-t", typ, "-s", str(v)]
    return run(cmd).returncode == 0


def xq_get(channel, prop):
    r = run(["xfconf-query", "-c", channel, "-p", prop])
    return r.stdout.strip() if r.returncode == 0 else None


def load_cfg():
    try:
        with open(DISPLAY_CFG) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_cfg(c):
    os.makedirs(CFG, exist_ok=True)
    with open(DISPLAY_CFG, "w") as f:
        json.dump(c, f, indent=2)


def images_in(folder):
    return sorted(p for p in glob.glob(os.path.join(folder, "*")) if p.lower().endswith(EXTS))


def portfolio_folder(preferred=None):
    """The newest gallery Portfolio built, or the chosen folder, or None."""
    for cand in ([preferred] if preferred else []) + [load_cfg().get("folder")]:
        if cand and os.path.isdir(cand) and images_in(cand):
            return cand
    builds = sorted(glob.glob(os.path.join(PORTFOLIO, "*", "web")), reverse=True)
    for b in builds:
        if images_in(b):
            return b
    if os.path.isdir(PORTFOLIO) and images_in(PORTFOLIO):
        return PORTFOLIO
    return None


def no_gallery(gui):
    msg = "There is no gallery yet. Portfolio builds one from your finished-work photos (originals stay where they are)."
    if gui:
        if zenity("--question", "--title=Show a client", "--width=460", f"--text={msg}", "--ok-label=Build it now", "--cancel-label=Not now").returncode == 0:
            subprocess.Popen(["flattoo-portfolio"], start_new_session=True)
    else:
        print(msg, file=sys.stderr)
    return 1


# ------------------------------------------------------------------ client mode

def lock_screen():
    for cmd in (["xflock4"], ["xfce4-screensaver-command", "--lock"], ["loginctl", "lock-session"]):
        if shutil.which(cmd[0]):
            if run(cmd).returncode == 0:
                return True
    return False


VIEWER_CSS = b"""
window { background-color: #000000; }
.done { background: rgba(255, 255, 255, 0.16); color: #ffffff; border: 1px solid rgba(255, 255, 255, 0.35);
        border-radius: 999px; padding: 14px 26px; font-size: 18px; font-weight: 600; margin: 22px; }
.done:hover, .done:active { background: rgba(255, 255, 255, 0.32); }
.counter { color: rgba(255, 255, 255, 0.75); font-size: 16px; margin: 22px; background: rgba(0, 0, 0, 0.35);
           border-radius: 999px; padding: 6px 16px; }
.arrow { background: rgba(0, 0, 0, 0); color: rgba(255, 255, 255, 0.0); border: none; }
"""


def client_viewer(files):
    """The slideshow a client holds: full screen, black, one piece at a time.
    Tap or swipe anywhere to move on (the left edge goes back), pieces
    advance by themselves every 8 s, a round Done button in the corner ends
    it. No menus, no file names, nothing else reachable. Returns when done."""
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    gi.require_version("GdkPixbuf", "2.0")
    from gi.repository import Gdk, GdkPixbuf, GLib, Gtk

    css = Gtk.CssProvider()
    css.load_from_data(VIEWER_CSS)
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    win = Gtk.Window(title="Flattoo — showing your work")
    win.set_decorated(False)
    win.set_keep_above(True)
    win.set_skip_taskbar_hint(True)
    win.set_skip_pager_hint(True)
    overlay = Gtk.Overlay()
    win.add(overlay)
    image = Gtk.Image()
    box = Gtk.EventBox()  # the image has no window of its own; taps and swipes land here
    box.add(image)
    overlay.add(box)

    state = {"i": 0, "timer": None, "size": (0, 0), "cache": {}}

    def pixbuf(i, w, h):
        key = (i, w, h)
        if key not in state["cache"]:
            try:
                pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(files[i], w, h, True)
            except GLib.Error:
                pb = None
            state["cache"] = {key: pb}  # one at a time; the files are big
        return state["cache"][key]

    def show(i):
        state["i"] = i % len(files)
        w, h = state["size"]
        if w > 0 and h > 0:
            pb = pixbuf(state["i"], w, h)
            if pb:
                image.set_from_pixbuf(pb)
        counter.set_text(f"{state['i'] + 1} / {len(files)}")
        arm()

    def tick():
        state["timer"] = None
        show(state["i"] + 1)
        return False

    def arm():
        if state["timer"]:
            GLib.source_remove(state["timer"])
        state["timer"] = GLib.timeout_add_seconds(8, tick)

    def on_size(_w, alloc):
        if (alloc.width, alloc.height) != state["size"]:
            state["size"] = (alloc.width, alloc.height)
            show(state["i"])

    def done(*_a):
        if state["timer"]:
            GLib.source_remove(state["timer"])
            state["timer"] = None
        Gtk.main_quit()

    # tap zones: the left fifth goes back, the rest goes on
    def on_press(_g, n_press, x, _y):
        if n_press >= 1:
            show(state["i"] - 1 if x < state["size"][0] / 5 else state["i"] + 1)

    click = Gtk.GestureMultiPress.new(box)
    click.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
    click.connect("released", on_press)
    swipe = Gtk.GestureSwipe.new(box)
    swipe.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
    swipe.connect("swipe", lambda _g, vx, _vy: show(state["i"] + (1 if vx < 0 else -1)) if abs(vx) > 200 else None)
    state["gestures"] = (click, swipe)  # keep them alive

    done_btn = Gtk.Button(label="Done")
    done_btn.get_style_context().add_class("done")
    done_btn.set_halign(Gtk.Align.END)
    done_btn.set_valign(Gtk.Align.START)
    done_btn.connect("clicked", done)
    overlay.add_overlay(done_btn)
    counter = Gtk.Label()
    counter.get_style_context().add_class("counter")
    counter.set_halign(Gtk.Align.CENTER)
    counter.set_valign(Gtk.Align.END)
    overlay.add_overlay(counter)

    def on_key(_w, ev):
        k = Gdk.keyval_name(ev.keyval) or ""
        if k == "Escape":
            done()
        elif k in ("Right", "space", "Down", "Page_Down"):
            show(state["i"] + 1)
        elif k in ("Left", "BackSpace", "Up", "Page_Up"):
            show(state["i"] - 1)
        return True  # nothing else reaches anything

    win.connect("key-press-event", on_key)
    win.connect("delete-event", done)
    win.connect("size-allocate", on_size)
    win.set_default_size(1280, 800)
    win.show_all()
    win.fullscreen()
    win.present()
    try:
        win.get_window().set_cursor(Gdk.Cursor.new_from_name(Gdk.Display.get_default(), "none"))
    except Exception:  # noqa: BLE001 — a cursor is cosmetic
        pass
    Gtk.main()


def client(folder, gui):
    folder = portfolio_folder(folder)
    if not folder:
        return no_gallery(gui)
    files = images_in(folder)
    dnd_before = xq_get("xfce4-notifyd", "/do-not-disturb")
    xq("xfce4-notifyd", "/do-not-disturb", "bool", "true")
    try:
        client_viewer(files)
    finally:
        if dnd_before in ("true", "false"):
            xq("xfce4-notifyd", "/do-not-disturb", "bool", dnd_before)
        else:
            xq("xfce4-notifyd", "/do-not-disturb", "bool", "false")
    lock_screen()
    return 0


def client_gui():
    folder = portfolio_folder()
    if not folder:
        return no_gallery(True)
    n = len(images_in(folder))
    r = zenity("--question", "--title=Show a client", "--width=500", "--ok-label=Show my work", "--cancel-label=Cancel",
               f"--text=<b>{n} pieces</b> from {folder.replace(HOME, '~')} fill the screen; a tap or a swipe goes to the next one.\n\n"
               "When the client is done, the <b>Done</b> button in the corner (or Esc) ends it and the laptop <b>locks</b> — "
               "your password brings the desktop back. Notifications stay quiet meanwhile.")
    if r.returncode != 0:
        return 1
    return client(folder, True)


# ------------------------------------------------------------------ shop display (screensaver)

SAVER_THEME = "screensavers-flattoo-showcase"
BACKDROP_THEME = "screensavers-flattoo-backdrop"  # the look's wallpaper, softened: the lock screen's picture
BACKDROP_DIR = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.join(HOME, ".cache")), "flattoo", "backdrop")


def display(state, gui=False):
    c = load_cfg()
    if state == "status":
        mode = xq_get("xfce4-screensaver", "/saver/mode")
        on = c.get("enabled", False) and mode == "1"
        print("on" if on else "off", c.get("folder") or portfolio_folder() or "(no gallery)")
        return 0
    if state == "on":
        folder = portfolio_folder()
        if not folder:
            return no_gallery(gui)
        c["enabled"] = True
        c.setdefault("folder", folder)
        save_cfg(c)
        xq("xfce4-screensaver", "/saver/mode", "int", 1)  # 0 blank, 1 one theme, 2 random
        xq_array("xfce4-screensaver", "/saver/themes/list", "string", [SAVER_THEME])
        xq("xfce4-screensaver", "/saver/enabled", "bool", "true")
        xq("xfce4-screensaver", "/saver/idle-activation/enabled", "bool", "true")
        run(["notify-send", "-a", "Flattoo", "Shop display on", "When the laptop sits idle it shows your work. A tap brings the desktop back."])
        return 0
    if state == "off":
        c["enabled"] = False
        save_cfg(c)
        backdrop_saver()
        run(["notify-send", "-a", "Flattoo", "Shop display off", "An idle laptop shows the lock screen again."])
        return 0
    return 2


def backdrop_saver():
    """The idle/lock picture when the shop display is off: the look's
    softened wallpaper (a plain black screen when no look wrote one yet)."""
    if os.path.exists(os.path.join(BACKDROP_DIR, "backdrop.png")):
        xq("xfce4-screensaver", "/saver/mode", "int", 1)
        xq_array("xfce4-screensaver", "/saver/themes/list", "string", [BACKDROP_THEME])
    else:
        xq("xfce4-screensaver", "/saver/mode", "int", 0)


def display_gui():
    c = load_cfg()
    folder = c.get("folder") or portfolio_folder() or "(no gallery yet)"
    on = c.get("enabled", False) and xq_get("xfce4-screensaver", "/saver/mode") == "1"
    r = zenity("--list", "--radiolist", "--title=Shop display", "--width=540", "--height=300",
               "--text=When nobody touches the laptop for a while, show your work instead of a black screen.\n"
               f"Pictures: {folder.replace(HOME, '~')}\n\nAnyone walking past will see them — keep it off for private client photos.",
               "--column=", "--column=id", "--column=Shop display", "--hide-column=2", "--print-column=2",
               "TRUE" if on else "FALSE", "on", "On — show my work when idle",
               "FALSE" if on else "TRUE", "off", "Off — a dark screen when idle",
               "FALSE", "folder", "Choose a different folder of pictures…")
    if r.returncode != 0 or not r.stdout.strip():
        return 1
    pick = r.stdout.strip()
    if pick == "folder":
        r = zenity("--file-selection", "--directory", "--title=Folder of pictures to show", f"--filename={PORTFOLIO}/")
        if r.returncode != 0 or not r.stdout.strip():
            return 1
        if not images_in(r.stdout.strip()):
            zenity("--error", "--title=Shop display", "--text=No pictures in that folder (jpg, png, webp).")
            return 1
        c["folder"] = r.stdout.strip()
        save_cfg(c)
        return display("on", True)
    return display(pick, True)


def slideshow():
    """What the screensaver runs: xfce4-screensaver's own slideshow helper,
    pointed at the portfolio. It inherits XSCREENSAVER_WINDOW and draws there."""
    folder = portfolio_folder()
    if not folder or not os.path.exists(SLIDESHOW):
        return 1
    os.execv(SLIDESHOW, [SLIDESHOW, f"--location={folder}", "--background-color=#000000", "--no-stretch"])


def backdrop():
    """The lock screen's picture: the same helper with the one softened
    wallpaper the current look wrote."""
    if not os.path.exists(os.path.join(BACKDROP_DIR, "backdrop.png")) or not os.path.exists(SLIDESHOW):
        return 1
    os.execv(SLIDESHOW, [SLIDESHOW, f"--location={BACKDROP_DIR}", "--background-color=#000000", "--sort-images"])


def main(argv=None):
    ap = argparse.ArgumentParser(prog="flattoo-showcase", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("gui")
    c = sub.add_parser("client"); c.add_argument("folder", nargs="?")
    d = sub.add_parser("display"); d.add_argument("state", choices=["on", "off", "status", "gui"])
    sub.add_parser("slideshow")
    sub.add_parser("backdrop")
    sub.add_parser("backdrop-saver", help="make the lock screen show the look's wallpaper (what a look does on apply)")
    sub.add_parser("folder", help="print the folder that would be shown")
    args = ap.parse_args(argv)
    if args.cmd == "gui":
        return client_gui()
    if args.cmd == "client":
        return client(args.folder, bool(os.environ.get("DISPLAY")))
    if args.cmd == "display":
        return display_gui() if args.state == "gui" else display(args.state)
    if args.cmd == "slideshow":
        return slideshow()
    if args.cmd == "backdrop":
        return backdrop()
    if args.cmd == "backdrop-saver":
        if load_cfg().get("enabled") and xq_get("xfce4-screensaver", "/saver/mode") == "1":
            return 0  # the shop display is on; leave it
        backdrop_saver()
        return 0
    if args.cmd == "folder":
        f = portfolio_folder()
        print(f or "")
        return 0 if f else 1
    return 2


if __name__ == "__main__":
    sys.exit(main())
