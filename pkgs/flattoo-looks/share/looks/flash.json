{
  "name": "flash",
  "title": "Flash Sheet",
  "description": "Parchment, a draft grid and the traditional palette \u2014 red, mustard, bottle green, black. One panel at the top like a desk, familiar names. Turns into Blackwork at night.",
  "gtk_theme": "Gruvbox-Light",
  "xfwm_theme": "Gruvbox-Light",
  "icon_theme": "kora",
  "cursor_theme": "volantes_cursors",
  "cursor_size": 28,
  "font": "Inter 11",
  "title_font": "Inter Semi-Bold 11",
  "wallpaper": "flash",
  "workspaces": {
    "count": 2,
    "names": [
      "Home",
      "Desk"
    ]
  },
  "desktop_launchers": [
    "krita",
    "files",
    "photos",
    "print",
    "copilot",
    "wiki",
    "portfolio"
  ],
  "app_names": "familiar",
  "xfwm": {
    "tile_on_move": true,
    "snap_to_border": true,
    "focus_delay": 0,
    "button_layout": "CHM|O",
    "click_to_focus": true,
    "titleless_maximize": true,
    "cycle_minimum": false
  },
  "xfconf": [
    [
      "thunar",
      "/misc-single-click",
      "bool",
      "true"
    ],
    [
      "thunar",
      "/last-view",
      "string",
      "ThunarIconView"
    ],
    [
      "thunar",
      "/last-icon-view-zoom-level",
      "string",
      "THUNAR_ZOOM_LEVEL_200_PERCENT"
    ],
    [
      "thunar",
      "/misc-thumbnail-mode",
      "string",
      "THUNAR_THUMBNAIL_MODE_ALWAYS"
    ],
    [
      "xfce4-desktop",
      "/desktop-icons/style",
      "int",
      "2"
    ],
    [
      "xfce4-desktop",
      "/desktop-icons/icon-size",
      "int",
      "64"
    ],
    [
      "xfce4-desktop",
      "/desktop-icons/show-tooltips",
      "bool",
      "false"
    ],
    [
      "xfce4-desktop",
      "/desktop-icons/single-click",
      "bool",
      "true"
    ],
    [
      "xfce4-desktop",
      "/desktop-icons/file-icons/show-home",
      "bool",
      "false"
    ],
    [
      "xfce4-desktop",
      "/desktop-icons/file-icons/show-trash",
      "bool",
      "false"
    ],
    [
      "xfce4-desktop",
      "/desktop-icons/file-icons/show-filesystem",
      "bool",
      "false"
    ],
    [
      "xfce4-desktop",
      "/desktop-icons/file-icons/show-removable",
      "bool",
      "true"
    ],
    [
      "xsettings",
      "/Gtk/DialogsUseHeader",
      "bool",
      "true"
    ],
    [
      "xsettings",
      "/Gtk/ButtonImages",
      "bool",
      "true"
    ]
  ],
  "keyboard": {
    "<Super>Return": "xfce4-terminal",
    "<Super>e": "thunar",
    "<Super>k": "krita",
    "<Super>l": "flattoo-layout gui",
    "<Super>p": "stencil-print --gui",
    "<Super>space": "flattoo-copilot",
    "Super_L": "flattoo-apps",
    "<Super>Escape": "flattoo-power"
  },
  "night": "blackwork",
  "palette": {
    "bg": "#f3e9d2",
    "fg": "#1b1a19",
    "muted": "#6b6050",
    "accent": "#b23a32",
    "on_accent": "#fbf1c7",
    "border": "#d8c9a6",
    "card": "rgba(255, 250, 235, 0.85)",
    "rofi_bg": "rgba(243, 233, 210, 0.94)",
    "radius": 10
  },
  "effects": {
    "corners": 6,
    "shadows": true,
    "blur": false,
    "animations": true,
    "shadow_opacity": 0.3
  },
  "notify": {
    "position": "top-right",
    "opacity": 0.97
  },
  "panel": {
    "position": "top",
    "size": 44,
    "icon_size": 28,
    "dark": false,
    "length": 100,
    "clock": "%a %b %-d  %-I:%M %p",
    "launchers": [
      "menu",
      "apps",
      "krita",
      "inkscape",
      "files",
      "photos",
      "scan",
      "print",
      "copilot",
      "firefox"
    ],
    "show_labels": true
  }
}
