{
  "title": "Studio Dark",
  "description": "Dark grey, cool accents, panel on top. Easy on the eyes under studio lights.",
  "gtk_theme": "Arc-Dark",
  "xfwm_theme": "Arc-Dark",
  "icon_theme": "Papirus-Dark",
  "cursor_theme": "Bibata-Modern-Classic",
  "cursor_size": 24,
  "font": "Inter 11",
  "title_font": "Inter Bold 11",
  "wallpaper": "slate",
  "workspaces": {
    "count": 3,
    "names": [
      "Draw",
      "Reference",
      "Desk"
    ]
  },
  "panel": {
    "position": "top",
    "size": 40,
    "icon_size": 24,
    "dark": true,
    "launchers": [
      "menu",
      "copilot",
      "krita",
      "mypaint",
      "inkscape",
      "sep",
      "files",
      "scan",
      "calibrate",
      "localsend",
      "firefox",
      "keyboard"
    ]
  },
  "xfwm": {
    "tile_on_move": true,
    "snap_to_border": true,
    "focus_delay": 0,
    "button_layout": "O|HMC",
    "click_to_focus": true
  },
  "keyboard": {
    "<Super>Return": "xfce4-terminal",
    "<Super>e": "thunar",
    "<Super>k": "krita",
    "<Super>l": "flattoo-layout gui",
    "<Super>p": "stencil-print --gui",
    "<Super>space": "flattoo-copilot",
    "Super_L": "xfce4-popup-whiskermenu",
    "<Super>Escape": "flattoo-power",
    "<Super>slash": "flattoo-wiki open shortcuts",
    "<Super>F1": "flattoo-wiki"
  },
  "name": "studio-dark",
  "app_names": "standard",
  "effects": {
    "corners": 8,
    "shadows": true,
    "blur": false,
    "animations": true,
    "shadow_opacity": 0.4
  },
  "palette": {
    "bg": "#2b2d35",
    "fg": "#eceef2",
    "muted": "#a4a8b3",
    "accent": "#8fb3ff",
    "on_accent": "#1b1c22",
    "border": "#3a3d47",
    "card": "rgba(58, 61, 71, 0.85)",
    "rofi_bg": "rgba(35, 37, 44, 0.94)",
    "radius": 10
  },
  "notify": {
    "position": "top-right",
    "opacity": 0.96
  },
  "dark": true
}
