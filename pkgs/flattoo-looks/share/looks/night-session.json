{
  "title": "Night Session",
  "description": "Near-black, panel hides until the mouse touches the bottom edge. Nothing but the canvas.",
  "gtk_theme": "Dracula",
  "xfwm_theme": "Dracula",
  "icon_theme": "Papirus-Dark",
  "cursor_theme": "Bibata-Modern-Ice",
  "cursor_size": 24,
  "font": "Inter 11",
  "title_font": "Inter Bold 11",
  "wallpaper": "ink",
  "workspaces": {
    "count": 1,
    "names": [
      "Draw"
    ]
  },
  "panel": {
    "position": "bottom",
    "size": 44,
    "icon_size": 28,
    "dark": true,
    "autohide": true,
    "show_labels": false,
    "launchers": [
      "menu",
      "copilot",
      "krita",
      "mypaint",
      "inkscape",
      "rnote",
      "sep",
      "files",
      "calibrate",
      "firefox"
    ]
  },
  "xfwm": {
    "tile_on_move": true,
    "snap_to_border": true,
    "button_layout": "O|HMC",
    "cycle_minimum": false
  },
  "keyboard": {
    "<Super>Return": "xfce4-terminal",
    "<Super>e": "thunar",
    "<Super>k": "krita",
    "<Super>l": "flattoo-layout gui",
    "<Super>p": "stencil-print --gui",
    "<Super>space": "flattoo-copilot",
    "Super_L": "xfce4-popup-whiskermenu",
    "<Super>Escape": "flattoo-power"
  },
  "name": "night-session",
  "app_names": "standard",
  "effects": {
    "corners": 10,
    "shadows": true,
    "blur": true,
    "animations": true,
    "shadow_opacity": 0.5
  },
  "palette": {
    "bg": "#282a36",
    "fg": "#f8f8f2",
    "muted": "#9ea3c2",
    "accent": "#bd93f9",
    "on_accent": "#282a36",
    "border": "#44475a",
    "card": "rgba(68, 71, 90, 0.80)",
    "rofi_bg": "rgba(30, 31, 41, 0.93)",
    "radius": 12
  },
  "notify": {
    "position": "top-right",
    "opacity": 0.96
  },
  "night_light": 4000
}
