{
  "name": "neon",
  "title": "Neon",
  "description": "A dark studio wall with neon tubes: hot pink and cyan on near-black, the dock down the left side, windows a touch see-through when they are not in front.",
  "gtk_theme": "Tokyonight-Dark",
  "xfwm_theme": "Tokyonight-Dark",
  "icon_theme": "Nordzy-purple-dark",
  "cursor_theme": "Nordzy-catppuccin-frappe-mauve",
  "cursor_size": 28,
  "font": "Inter 11.5",
  "title_font": "Inter Semi-Bold 11",
  "wallpaper": "neon",
  "workspaces": {
    "count": 2,
    "names": [
      "Home",
      "Desk"
    ]
  },
  "panels": [
    {
      "position": "top",
      "size": 30,
      "icon_size": 18,
      "dark": true,
      "length": 100,
      "items": [
        "clock",
        "spacer",
        "tray",
        "volume",
        "power",
        "powersheet"
      ],
      "clock": "%-I:%M"
    },
    {
      "position": "left",
      "size": 64,
      "icon_size": 42,
      "dark": true,
      "length": 1,
      "length_adjust": true,
      "background": [
        0.08,
        0.04,
        0.14,
        0.86
      ],
      "items": [
        "apps",
        "files",
        "photos",
        "krita",
        "firefox",
        "copilot",
        "sep",
        "dock"
      ]
    }
  ],
  "desktop_launchers": [
    "krita",
    "mypaint",
    "inkscape",
    "rnote",
    "xournalpp",
    "files",
    "photos",
    "scan",
    "print",
    "calibrate",
    "localsend",
    "firefox",
    "copilot",
    "wiki",
    "looks",
    "layouts",
    "portfolio",
    "profile",
    "settings"
  ],
  "app_names": "familiar",
  "xfwm": {
    "tile_on_move": true,
    "snap_to_border": true,
    "focus_delay": 0,
    "button_layout": "CHM|O",
    "click_to_focus": true,
    "titleless_maximize": true,
    "cycle_minimum": false
  },
  "xfconf": [
    [
      "thunar",
      "/misc-single-click",
      "bool",
      "true"
    ],
    [
      "thunar",
      "/last-view",
      "string",
      "ThunarIconView"
    ],
    [
      "thunar",
      "/last-icon-view-zoom-level",
      "string",
      "THUNAR_ZOOM_LEVEL_200_PERCENT"
    ],
    [
      "thunar",
      "/misc-thumbnail-mode",
      "string",
      "THUNAR_THUMBNAIL_MODE_ALWAYS"
    ],
    [
      "xfce4-desktop",
      "/desktop-icons/style",
      "int",
      "2"
    ],
    [
      "xfce4-desktop",
      "/desktop-icons/icon-size",
      "int",
      "64"
    ],
    [
      "xfce4-desktop",
      "/desktop-icons/show-tooltips",
      "bool",
      "false"
    ],
    [
      "xfce4-desktop",
      "/desktop-icons/single-click",
      "bool",
      "true"
    ],
    [
      "xfce4-desktop",
      "/desktop-icons/file-icons/show-home",
      "bool",
      "false"
    ],
    [
      "xfce4-desktop",
      "/desktop-icons/file-icons/show-trash",
      "bool",
      "false"
    ],
    [
      "xfce4-desktop",
      "/desktop-icons/file-icons/show-filesystem",
      "bool",
      "false"
    ],
    [
      "xfce4-desktop",
      "/desktop-icons/file-icons/show-removable",
      "bool",
      "true"
    ],
    [
      "xsettings",
      "/Gtk/DialogsUseHeader",
      "bool",
      "true"
    ],
    [
      "xsettings",
      "/Gtk/ButtonImages",
      "bool",
      "true"
    ]
  ],
  "keyboard": {
    "<Super>Return": "xfce4-terminal",
    "<Super>e": "thunar",
    "<Super>k": "krita",
    "<Super>l": "flattoo-layout gui",
    "<Super>p": "stencil-print --gui",
    "<Super>space": "flattoo-copilot",
    "Super_L": "flattoo-apps",
    "<Super>Escape": "flattoo-power",
    "<Super>slash": "flattoo-wiki open shortcuts",
    "<Super>F1": "flattoo-wiki"
  },
  "palette": {
    "bg": "#140b24",
    "fg": "#f5ecff",
    "muted": "#b2a3c9",
    "accent": "#ff3ea5",
    "on_accent": "#140b24",
    "border": "#3a2a5a",
    "card": "rgba(60, 30, 90, 0.75)",
    "rofi_bg": "rgba(14, 8, 26, 0.92)",
    "radius": 14
  },
  "effects": {
    "corners": 14,
    "shadows": true,
    "blur": true,
    "animations": true,
    "inactive_opacity": 0.94,
    "shadow_opacity": 0.55
  },
  "notify": {
    "position": "top-center",
    "opacity": 0.96
  },
  "dark": true
}
