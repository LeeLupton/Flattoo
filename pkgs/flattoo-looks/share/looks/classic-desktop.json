{
  "title": "Classic Desktop",
  "description": "Taskbar at the bottom, menu on the left, clock on the right, familiar names and icons. Feels like the last computer.",
  "gtk_theme": "Fluent-Light",
  "xfwm_theme": "Fluent-Light",
  "icon_theme": "Fluent-light",
  "cursor_theme": "Adwaita",
  "cursor_size": 24,
  "font": "Noto Sans 11",
  "title_font": "Noto Sans Bold 11",
  "wallpaper": "blue",
  "workspaces": {
    "count": 1,
    "names": [
      "Desktop"
    ]
  },
  "panel": {
    "position": "bottom",
    "size": 36,
    "icon_size": 22,
    "dark": false,
    "show_labels": true,
    "launchers": [
      "menu",
      "copilot",
      "files",
      "firefox",
      "krita",
      "sep"
    ]
  },
  "xfwm": {
    "tile_on_move": false,
    "snap_to_border": true,
    "button_layout": "O|HMC"
  },
  "keyboard": {
    "<Super>Return": "xfce4-terminal",
    "<Super>e": "thunar",
    "<Super>k": "krita",
    "<Super>l": "flattoo-layout gui",
    "<Super>p": "stencil-print --gui",
    "<Super>space": "flattoo-copilot",
    "Super_L": "xfce4-popup-whiskermenu",
    "<Super>Escape": "flattoo-power"
  },
  "name": "classic-desktop",
  "app_names": "familiar",
  "effects": {
    "corners": 8,
    "shadows": true,
    "blur": true,
    "animations": true,
    "shadow_opacity": 0.3
  },
  "palette": {
    "bg": "#f3f3f3",
    "fg": "#1b1b1b",
    "muted": "#616161",
    "accent": "#0067c0",
    "on_accent": "#ffffff",
    "border": "#d6d6d6",
    "card": "rgba(255, 255, 255, 0.80)",
    "rofi_bg": "rgba(243, 243, 243, 0.94)",
    "radius": 8
  },
  "notify": {
    "position": "bottom-right",
    "opacity": 0.98
  },
  "night": "studio-dark"
}
