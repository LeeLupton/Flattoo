{
  "title": "Big & Simple",
  "description": "Large text, large icons, dock-style bottom panel with the four things that matter. For a 4K screen or tired eyes.",
  "gtk_theme": "Arc-Dark",
  "xfwm_theme": "Arc-Dark",
  "icon_theme": "Papirus-Dark",
  "cursor_theme": "Bibata-Modern-Classic",
  "cursor_size": 32,
  "font": "Inter 13",
  "title_font": "Inter Bold 13",
  "dpi": 120,
  "wallpaper": "slate",
  "workspaces": {
    "count": 1,
    "names": [
      "Draw"
    ]
  },
  "panel": {
    "position": "bottom",
    "size": 56,
    "icon_size": 40,
    "dark": true,
    "show_labels": false,
    "launchers": [
      "menu",
      "copilot",
      "krita",
      "scan",
      "calibrate",
      "firefox",
      "keyboard"
    ]
  },
  "xfwm": {
    "tile_on_move": true,
    "snap_to_border": true,
    "button_layout": "O|HMC"
  },
  "keyboard": {
    "<Super>Return": "xfce4-terminal",
    "<Super>e": "thunar",
    "<Super>k": "krita",
    "<Super>l": "flattoo-layout gui",
    "<Super>p": "stencil-print --gui",
    "<Super>space": "flattoo-copilot",
    "Super_L": "xfce4-popup-whiskermenu",
    "<Super>Escape": "flattoo-power",
    "<Super>slash": "flattoo-wiki open shortcuts",
    "<Super>F1": "flattoo-wiki"
  },
  "name": "big-and-simple",
  "app_names": "standard",
  "effects": false,
  "palette": {
    "bg": "#2f343f",
    "fg": "#f4f5f7",
    "muted": "#b7bcc7",
    "accent": "#5294e2",
    "on_accent": "#ffffff",
    "border": "#434a59",
    "card": "rgba(67, 74, 89, 0.9)",
    "rofi_bg": "rgba(47, 52, 63, 0.97)",
    "radius": 6
  },
  "notify": {
    "position": "top-right",
    "opacity": 1.0
  },
  "dark": true
}
