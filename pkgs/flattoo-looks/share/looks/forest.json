{
  "name": "forest",
  "title": "Forest",
  "description": "Misty ridgelines in green-grey, soft contrast, a single panel at the bottom with a window list. Calm, for long sessions.",
  "gtk_theme": "Everforest-Dark",
  "xfwm_theme": "Everforest-Dark",
  "icon_theme": "Nordzy-green-dark",
  "cursor_theme": "graphite-dark-nord",
  "cursor_size": 28,
  "font": "Inter 11",
  "title_font": "Inter Semi-Bold 11",
  "wallpaper": "forest",
  "workspaces": {
    "count": 2,
    "names": [
      "Home",
      "Desk"
    ]
  },
  "desktop_launchers": [],
  "app_names": "standard",
  "xfwm": {
    "tile_on_move": true,
    "snap_to_border": true,
    "focus_delay": 0,
    "button_layout": "CHM|O",
    "click_to_focus": true,
    "titleless_maximize": true,
    "cycle_minimum": false
  },
  "xfconf": [
    [
      "thunar",
      "/misc-single-click",
      "bool",
      "true"
    ],
    [
      "thunar",
      "/last-view",
      "string",
      "ThunarIconView"
    ],
    [
      "thunar",
      "/last-icon-view-zoom-level",
      "string",
      "THUNAR_ZOOM_LEVEL_200_PERCENT"
    ],
    [
      "thunar",
      "/misc-thumbnail-mode",
      "string",
      "THUNAR_THUMBNAIL_MODE_ALWAYS"
    ],
    [
      "xfce4-desktop",
      "/desktop-icons/style",
      "int",
      "2"
    ],
    [
      "xfce4-desktop",
      "/desktop-icons/icon-size",
      "int",
      "64"
    ],
    [
      "xfce4-desktop",
      "/desktop-icons/show-tooltips",
      "bool",
      "false"
    ],
    [
      "xfce4-desktop",
      "/desktop-icons/single-click",
      "bool",
      "true"
    ],
    [
      "xfce4-desktop",
      "/desktop-icons/file-icons/show-home",
      "bool",
      "false"
    ],
    [
      "xfce4-desktop",
      "/desktop-icons/file-icons/show-trash",
      "bool",
      "false"
    ],
    [
      "xfce4-desktop",
      "/desktop-icons/file-icons/show-filesystem",
      "bool",
      "false"
    ],
    [
      "xfce4-desktop",
      "/desktop-icons/file-icons/show-removable",
      "bool",
      "true"
    ],
    [
      "xsettings",
      "/Gtk/DialogsUseHeader",
      "bool",
      "true"
    ],
    [
      "xsettings",
      "/Gtk/ButtonImages",
      "bool",
      "true"
    ]
  ],
  "keyboard": {
    "<Super>Return": "xfce4-terminal",
    "<Super>e": "thunar",
    "<Super>k": "krita",
    "<Super>l": "flattoo-layout gui",
    "<Super>p": "stencil-print --gui",
    "<Super>space": "flattoo-copilot",
    "Super_L": "flattoo-apps",
    "<Super>Escape": "flattoo-power",
    "<Super>slash": "flattoo-wiki open shortcuts",
    "<Super>F1": "flattoo-wiki"
  },
  "palette": {
    "bg": "#2d353b",
    "fg": "#d3c6aa",
    "muted": "#9da9a0",
    "accent": "#a7c080",
    "on_accent": "#2d353b",
    "border": "#475258",
    "card": "rgba(71, 82, 88, 0.80)",
    "rofi_bg": "rgba(45, 53, 59, 0.94)",
    "radius": 12
  },
  "effects": {
    "corners": 10,
    "shadows": true,
    "blur": true,
    "animations": true,
    "shadow_opacity": 0.4
  },
  "notify": {
    "position": "bottom-right",
    "opacity": 0.96
  },
  "panel": {
    "position": "bottom",
    "size": 44,
    "icon_size": 28,
    "dark": true,
    "length": 100,
    "clock": "%a %b %-d  %-I:%M %p",
    "launchers": [
      "menu",
      "apps",
      "krita",
      "inkscape",
      "files",
      "photos",
      "copilot",
      "firefox"
    ],
    "show_labels": true
  },
  "dark": true
}
