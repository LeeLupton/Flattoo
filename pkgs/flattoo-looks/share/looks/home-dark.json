{
  "name": "home-dark",
  "title": "Home (dark)",
  "description": "The phone-style Home look in dark: for evening sessions and OLED screens.",
  "gtk_theme": "WhiteSur-Dark",
  "xfwm_theme": "WhiteSur-Dark",
  "icon_theme": "WhiteSur-dark",
  "cursor_theme": "WhiteSur-cursors",
  "cursor_size": 28,
  "font": "Inter 11.5",
  "title_font": "Inter Semi-Bold 11",
  "wallpaper": "home-dark",
  "workspaces": {
    "count": 2,
    "names": [
      "Home",
      "Desk"
    ]
  },
  "panels": [
    {
      "position": "top",
      "size": 30,
      "icon_size": 18,
      "dark": true,
      "length": 100,
      "items": [
        "clock",
        "spacer",
        "tray",
        "volume",
        "power",
        "keyboard",
        "powersheet"
      ],
      "clock": "%-I:%M"
    },
    {
      "position": "bottom-center",
      "size": 68,
      "icon_size": 46,
      "dark": true,
      "length": 1,
      "length_adjust": true,
      "background": [
        0.12,
        0.12,
        0.16,
        0.8
      ],
      "items": [
        "apps",
        "files",
        "photos",
        "krita",
        "firefox",
        "copilot",
        "sep",
        "dock"
      ]
    }
  ],
  "desktop_launchers": [
    "krita",
    "mypaint",
    "inkscape",
    "rnote",
    "xournalpp",
    "files",
    "photos",
    "scan",
    "print",
    "calibrate",
    "localsend",
    "firefox",
    "copilot",
    "wiki",
    "looks",
    "layouts",
    "portfolio",
    "profile",
    "settings"
  ],
  "app_names": "familiar",
  "xfwm": {
    "tile_on_move": true,
    "snap_to_border": true,
    "focus_delay": 0,
    "button_layout": "CHM|O",
    "click_to_focus": true,
    "titleless_maximize": true,
    "cycle_minimum": false
  },
  "xfconf": [
    [
      "thunar",
      "/misc-single-click",
      "bool",
      "true"
    ],
    [
      "thunar",
      "/last-view",
      "string",
      "ThunarIconView"
    ],
    [
      "thunar",
      "/last-icon-view-zoom-level",
      "string",
      "THUNAR_ZOOM_LEVEL_200_PERCENT"
    ],
    [
      "thunar",
      "/misc-thumbnail-mode",
      "string",
      "THUNAR_THUMBNAIL_MODE_ALWAYS"
    ],
    [
      "xfce4-desktop",
      "/desktop-icons/style",
      "int",
      "2"
    ],
    [
      "xfce4-desktop",
      "/desktop-icons/icon-size",
      "int",
      "64"
    ],
    [
      "xfce4-desktop",
      "/desktop-icons/show-tooltips",
      "bool",
      "false"
    ],
    [
      "xfce4-desktop",
      "/desktop-icons/single-click",
      "bool",
      "true"
    ],
    [
      "xfce4-desktop",
      "/desktop-icons/file-icons/show-home",
      "bool",
      "false"
    ],
    [
      "xfce4-desktop",
      "/desktop-icons/file-icons/show-trash",
      "bool",
      "false"
    ],
    [
      "xfce4-desktop",
      "/desktop-icons/file-icons/show-filesystem",
      "bool",
      "false"
    ],
    [
      "xfce4-desktop",
      "/desktop-icons/file-icons/show-removable",
      "bool",
      "true"
    ],
    [
      "xsettings",
      "/Gtk/DialogsUseHeader",
      "bool",
      "true"
    ],
    [
      "xsettings",
      "/Gtk/ButtonImages",
      "bool",
      "true"
    ]
  ],
  "keyboard": {
    "<Super>Return": "xfce4-terminal",
    "<Super>e": "thunar",
    "<Super>k": "krita",
    "<Super>l": "flattoo-layout gui",
    "<Super>p": "stencil-print --gui",
    "<Super>space": "flattoo-copilot",
    "Super_L": "flattoo-apps",
    "<Super>Escape": "flattoo-power",
    "<Super>slash": "flattoo-wiki open shortcuts",
    "<Super>F1": "flattoo-wiki"
  },
  "effects": {
    "corners": 14,
    "shadows": true,
    "blur": true,
    "animations": true,
    "shadow_opacity": 0.45
  },
  "palette": {
    "bg": "#1f2027",
    "fg": "#f2f2f5",
    "muted": "#a9a9b3",
    "accent": "#5b8cff",
    "on_accent": "#ffffff",
    "border": "#34353e",
    "card": "rgba(70, 72, 84, 0.75)",
    "rofi_bg": "rgba(20, 21, 28, 0.90)",
    "radius": 18
  },
  "notify": {
    "position": "top-center",
    "opacity": 0.95
  },
  "night_light": 4500,
  "dark": true
}
