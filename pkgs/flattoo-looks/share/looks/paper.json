{
  "title": "Paper",
  "description": "Light, warm, quiet. Looks like the sketchbook. Panel on top.",
  "gtk_theme": "Materia-light",
  "xfwm_theme": "Materia-light",
  "icon_theme": "Papirus-Light",
  "cursor_theme": "capitaine-cursors",
  "cursor_size": 24,
  "font": "Inter 11",
  "title_font": "Inter Bold 11",
  "wallpaper": "paper",
  "workspaces": {
    "count": 2,
    "names": [
      "Draw",
      "Desk"
    ]
  },
  "panel": {
    "position": "top",
    "size": 40,
    "icon_size": 24,
    "dark": false,
    "launchers": [
      "menu",
      "copilot",
      "krita",
      "mypaint",
      "inkscape",
      "sep",
      "files",
      "scan",
      "calibrate",
      "localsend",
      "firefox"
    ]
  },
  "xfwm": {
    "tile_on_move": true,
    "snap_to_border": true,
    "button_layout": "O|HMC"
  },
  "keyboard": {
    "<Super>Return": "xfce4-terminal",
    "<Super>e": "thunar",
    "<Super>k": "krita",
    "<Super>l": "flattoo-layout gui",
    "<Super>p": "stencil-print --gui",
    "<Super>space": "flattoo-copilot",
    "Super_L": "xfce4-popup-whiskermenu",
    "<Super>Escape": "flattoo-power",
    "<Super>slash": "flattoo-wiki open shortcuts",
    "<Super>F1": "flattoo-wiki"
  },
  "name": "paper",
  "app_names": "standard",
  "effects": {
    "corners": 6,
    "shadows": true,
    "blur": false,
    "animations": false,
    "shadow_opacity": 0.25
  },
  "palette": {
    "bg": "#fbf7ef",
    "fg": "#2a2622",
    "muted": "#6a635a",
    "accent": "#2a2622",
    "on_accent": "#fbf7ef",
    "border": "#e4dccb",
    "card": "rgba(255, 255, 255, 0.85)",
    "rofi_bg": "rgba(251, 247, 239, 0.95)",
    "radius": 8
  },
  "notify": {
    "position": "top-right",
    "opacity": 0.98
  },
  "night": "night-session",
  "dark": false
}
