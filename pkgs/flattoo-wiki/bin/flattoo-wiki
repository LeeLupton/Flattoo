#!/usr/bin/env python3
"""Flattoo help: the artist's wiki, from the menu or from Ask Flattoo.

  flattoo-wiki                 open the front page in the browser
  flattoo-wiki gui             pick a topic from a list
  flattoo-wiki open ID         open one page
  flattoo-wiki search WORDS…   rank pages for a request (text, or --json)
  flattoo-wiki list
  flattoo-wiki check           report screenshots the pages still wait for
"""
import difflib
import json
import os
import re
import subprocess
import sys

WIKI = "@wiki@"  # share/flattoo/wiki


def index():
    with open(os.path.join(WIKI, "index.json")) as f:
        return json.load(f)


def norm(s):
    return re.sub(r"[^a-z0-9 ]+", " ", s.lower()).strip()


def score(page, text):
    """How well a page answers the request. Exact phrase hits first, then fuzzy words."""
    t = norm(text)
    words = [w for w in t.split() if len(w) > 2]
    s = 0.0
    for q in page["questions"]:
        qn = norm(q)
        if qn and qn in t:
            s += 3.0
        else:
            r = difflib.SequenceMatcher(None, qn, t).ratio()
            if r > 0.7:
                s += 2.0 * r
    for tag in page["tags"] + [page["title"]] + page["menu"]:
        tn = norm(tag)
        if tn and re.search(r"\b" + re.escape(tn) + r"\b", t):
            s += 1.0 + len(tn) / 40
        else:
            for w in words:
                if len(tn) > 3 and difflib.SequenceMatcher(None, w, tn).ratio() > 0.86:
                    s += 0.6
    for w in words:
        if w in norm(page["summary"]).split():
            s += 0.15
    return s


def search(text, n=5):
    pages = index()["pages"]
    ranked = sorted(((score(p, text), p) for p in pages), key=lambda x: -x[0])
    return [(s, p) for s, p in ranked[:n] if s > 0]


def open_page(pid):
    path = os.path.join(WIKI, pid + ".html" if pid != "index" else "index.html")
    if not os.path.exists(path):
        sys.exit(f"no page {pid}")
    subprocess.Popen(["xdg-open", "file://" + path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def gui():
    pages = index()["pages"]
    rows = []
    for p in pages:
        rows += [p["id"], p["title"], p["summary"]]
    r = subprocess.run(["zenity", "--list", "--title=Flattoo help", "--width=760", "--height=520",
                        "--text=What do you want to know?", "--column=id", "--column=Topic", "--column=About",
                        "--hide-column=1", "--print-column=1", *rows], capture_output=True, text=True)
    if r.returncode == 0 and r.stdout.strip():
        open_page(r.stdout.strip())


def main(argv):
    if not argv:
        open_page("index")
        return 0
    cmd, *rest = argv
    if cmd == "gui":
        gui()
    elif cmd == "open":
        open_page(rest[0] if rest else "index")
    elif cmd == "list":
        for p in index()["pages"]:
            print(f"{p['id']:22} {p['title']}")
    elif cmd == "search":
        as_json = "--json" in rest
        text = " ".join(x for x in rest if x != "--json")
        hits = search(text)
        if as_json:
            print(json.dumps([{"id": p["id"], "title": p["title"], "summary": p["summary"], "score": round(s, 2)} for s, p in hits]))
        else:
            for s, p in hits:
                print(f"{s:5.2f}  {p['id']:22} {p['title']}")
    elif cmd == "check":
        d = index()
        if d["missing_screenshots"]:
            print("pending screenshots:", " ".join(d["missing_screenshots"]))
            return 1
        print("all screenshots present")
    else:
        print(__doc__)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
